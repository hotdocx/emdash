   (@comp_cat_fapp0 (Product_cat A C) (Product_cat K C) C (@Product_projR_func K C) H)
   (@Product_projR_func A C));

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) ⊢
 @eq_refl (Functor (Op_cat K) (Op_cat Y)) (@comma_section_gamma_target_section K X Y J A D h)
 : τ (@= (Functor (Op_cat K) (Op_cat Y)) (@comma_section_gamma_target_section K X Y J A D h)
     (@comma_grouped_graph_section_stage1 K X Y J A D h));

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) ⊢
 @eq_refl (Functor (Op_cat K) (Op_cat Y)) (@comma_grouped_graph_section_stage1 K X Y J A D h)
 : τ (@= (Functor (Op_cat K) (Op_cat Y)) (@comma_grouped_graph_section_stage1 K X Y J A D h)
     (@comma_grouped_graph_section_stage2 K X Y J A D h));

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) ⊢
 @eq_refl (@Functord (Op_cat K)
     (@represented_comma_family_target K X Y J A)
     (@Const_catd (Op_cat K) (Op_cat Y)))
   (@comma_section_gamma_target_section_map K X Y J A)
 : τ (@= (@Functord (Op_cat K)
     (@represented_comma_family_target K X Y J A)
     (@Const_catd (Op_cat K) (Op_cat Y)))
   (@comma_section_gamma_target_section_map K X Y J A)
   (@comma_classification_target_projection K X Y J A));

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X))
 (D : τ (Functor K Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) ⊢
 @eq_refl (Functor (Op_cat K) (Op_cat Y)) (@comma_section_gamma_target_section K X Y J A D h)
 : τ (@= (Functor (Op_cat K) (Op_cat Y)) (@comma_section_gamma_target_section K X Y J A D h)
     (@comma_classification_target_section_canonical K X Y J A D h));

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X))
