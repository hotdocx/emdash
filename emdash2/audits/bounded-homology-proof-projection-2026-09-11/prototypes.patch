+/* Usability through Q's original selection at the SAME whole boundary.
+   No alternate boundary, new selection, object transport or new unifier. */
+require open emdash.emdash3_2_zero_arrow_cone_homology;
+
+symbol homology_same_boundary_diagram [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] [T : τ (@TerminalObject C t)]
+  [T0 : τ (@TerminalObject (Op_cat C) t)]
+  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
+  (P : τ (@KernelPresentation C S t T W))
+  (Q : τ (@CokernelPresentation C S t T0 V))
+  (z : τ (Obj (@ZeroArrowCone_cat C t T)))
+  : τ (Functor WalkingArrow_cat C)
+≔ @fapp0 (@ZeroArrowCone_cat C t T) (Functor_cat WalkingArrow_cat C)
+    (@kernel_family_boundary_diagram_func (@ZeroArrowCone_cat C t T) C S t T W P
+      (@zero_arrow_cone_first_func C t T)
+      (@zero_arrow_cone_diagram_func C t T)
+      (@zero_arrow_cone_universal_transf C C1 t T)) z;
+
+symbol homology_same_boundary_selected_object [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] [T : τ (@TerminalObject C t)]
+  [T0 : τ (@TerminalObject (Op_cat C) t)]
+  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
+  (P : τ (@KernelPresentation C S t T W))
+  (Q : τ (@CokernelPresentation C S t T0 V))
+  (z : τ (Obj (@ZeroArrowCone_cat C t T))) : τ (Obj C)
+≔ @sigma_Fst _ _ (@cokernel_presentation_selected C S V
+    (@homology_same_boundary_diagram C S C1 t T T0 W V P Q z));
+
+symbol homology_same_boundary_selected_path [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] [T : τ (@TerminalObject C t)]
+  [T0 : τ (@TerminalObject (Op_cat C) t)]
+  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
+  (P : τ (@KernelPresentation C S t T W))
+  (Q : τ (@CokernelPresentation C S t T0 V))
+  (z : τ (Obj (@ZeroArrowCone_cat C t T)))
+  : τ (@= (Obj C) (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q) z) (@homology_same_boundary_selected_object C S C1 t T T0 W V P Q z))
+≔ @eq_refl (Obj C) (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q) z);
+
+symbol homology_to_selected_hom [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] [T : τ (@TerminalObject C t)]
+  [T0 : τ (@TerminalObject (Op_cat C) t)]
+  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
+  (P : τ (@KernelPresentation C S t T W))
+  (Q : τ (@CokernelPresentation C S t T0 V))
+  [z0 z1 : τ (Obj (@ZeroArrowCone_cat C t T))]
+  (f : τ (Hom C (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q) z0) (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q) z1)))
+  : τ (Hom C (@homology_same_boundary_selected_object C S C1 t T T0 W V P Q z0) (@homology_same_boundary_selected_object C S C1 t T T0 W V P Q z1))
+≔ f;
+
+symbol homology_from_selected_hom [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] [T : τ (@TerminalObject C t)]
+  [T0 : τ (@TerminalObject (Op_cat C) t)]
+  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
+  (P : τ (@KernelPresentation C S t T W))
+  (Q : τ (@CokernelPresentation C S t T0 V))
+  [z0 z1 : τ (Obj (@ZeroArrowCone_cat C t T))]
+  (f : τ (Hom C (@homology_same_boundary_selected_object C S C1 t T T0 W V P Q z0) (@homology_same_boundary_selected_object C S C1 t T T0 W V P Q z1)))
+  : τ (Hom C (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q) z0) (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q) z1))
+≔ f;
