@@ -0,0 +1,28 @@
+/* First-class component naturality in the current globally strict profile.
+   This rule-free proof explicitly crosses the existing raw/post/pre/mixed
+   usability owners. It is not a theorem about arbitrary lax transformations;
+   a later strictness migration must keep its strict hypothesis explicit. */
+require open emdash.emdash3_2;
+
+/* Direct proof-time readings of the current strict off-diagonal owner.
+   Flat family/endpoint indices correlate the naturality square: equal
+   evaluated objects alone do not identify the original base points. */
+unif_rule @tapp1_fapp0 $I $C $F $G $x $y $eta $p
+  ≡ @comp_fapp0 _ _ _ _
+      (@fapp1_fapp0 $I $C $G $x $y $p)
+      (@tapp0_fapp0 $I $C $F $G $x $eta)
+  ↪ [ tt ≡ tt ];
+
+unif_rule @tapp1_fapp0 $I $C $F $G $x $y $eta $p
+  ≡ @comp_fapp0 _ _ _ _
+      (@tapp0_fapp0 $I $C $F $G $y $eta)
+      (@fapp1_fapp0 $I $C $F $x $y $p)
+  ↪ [ tt ≡ tt ];
+
+symbol strict_component_naturality_path
+  [I C : Cat] [F G : τ (Functor I C)] (eta : τ (Transf F G))
+  [x y : τ (Obj I)] (p : τ (Hom I x y))
+  : τ (@= (Hom C (@fapp0 I C F x) (@fapp0 I C G y))
+      (@comp_fapp0 C _ _ _ (@fapp1_fapp0 I C G x y p) (@tapp0_fapp0 I C F G x eta))
+      (@comp_fapp0 C _ _ _ (@tapp0_fapp0 I C F G y eta) (@fapp1_fapp0 I C F x y p)))
+≔ @eq_refl _ (@tapp1_fapp0 I C F G x y eta p);
diff --git a/emdash2/tmp/probes/homology_naturality_direct_checks.lp b/emdash2/tmp/probes/homology_naturality_direct_checks.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/homology_naturality_direct_checks.lp
@@ -0,0 +1,31 @@
+/* Direct strict naturality usability; runtime owners remain separate. */
+require open emdash.emdash3_2_strict_transfor_component_paths;
+constant symbol I : Cat;
+constant symbol C : Cat;
+constant symbol F : τ (Functor I C);
+constant symbol G : τ (Functor I C);
+constant symbol x : τ (Obj I);
+constant symbol y : τ (Obj I);
+constant symbol p : τ (Hom I x y);
+constant symbol q : τ (Hom I x y);
+constant symbol eta : τ (@Transf I C F G);
+constant symbol theta : τ (@Transf I C F G);
+symbol cut_off ≔ @tapp1_fapp0 I C F G x y eta p;
+symbol cut_left ≔ @comp_fapp0 C _ _ _
+  (@fapp1_fapp0 I C G x y p) (@tapp0_fapp0 I C F G x eta);
+symbol cut_right ≔ @comp_fapp0 C _ _ _
+  (@tapp0_fapp0 I C F G y eta) (@fapp1_fapp0 I C F x y p);
+
+assert ⊢ @eq_refl _ cut_off : τ (@= _ cut_off cut_left);
+assert ⊢ @eq_refl _ cut_off : τ (@= _ cut_off cut_right);
+assert ⊢ @eq_refl _ cut_off : τ (@= _ cut_left cut_off);
+assert ⊢ @eq_refl _ cut_off : τ (@= _ cut_right cut_off);
+assert ⊢ @eq_refl _ cut_off : τ (@= _ cut_left cut_right);
+assertnot ⊢ cut_off ≡ cut_left;
+assertnot ⊢ cut_off ≡ cut_right;
+assertnot ⊢ @eq_refl _ cut_off : τ (@= _ cut_off
+  (@comp_fapp0 C _ _ _
+    (@fapp1_fapp0 I C G x y q) (@tapp0_fapp0 I C F G x eta)));
+assertnot ⊢ @eq_refl _ cut_off : τ (@= _ cut_off
+  (@comp_fapp0 C _ _ _
+    (@tapp0_fapp0 I C F G y theta) (@fapp1_fapp0 I C F x y p)));
diff --git a/emdash2/tmp/probes/run_naturality_owner_probe.sh b/emdash2/tmp/probes/run_naturality_owner_probe.sh
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/run_naturality_owner_probe.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+set -euo pipefail
+stage="${1:?stage required}"
+case "$stage" in /tmp/emdash-naturality-owner.??????) ;; *) exit 2 ;; esac
+cd "$stage"
+graph="$(node - <<'NODE'
+const fs=require('fs');
+const changed='emdash3_2_strict_transfor_component_paths.lp';
+const roots=[
+ 'tmp/probes/homology_naturality_direct_checks.lp',
+ 'tmp/probes/homology_row_pair_isolation_zero.lp',
+ 'tmp/probes/homology_row2_evidence_type_sharing.lp',
+ 'tmp/probes/homology_finite_degree_operations.lp',
+ 'tmp/probes/homology_finite_direct_action_sharing.lp'];
+const dependencies=new Map(),order=[],visiting=new Set();
+function visit(f){if(visiting.has(f))throw Error('cycle '+f);if(dependencies.has(f))return;
+ visiting.add(f);const s=fs.readFileSync(f,'utf8');
+ const ds=[...s.matchAll(/\brequire\s+(?:open\s+)?(emdash(?:\.[A-Za-z0-9_]+)+)\s*;/g)].map(m=>m[1].slice(7).replaceAll('.','/')+'.lp');
+ dependencies.set(f,ds);ds.forEach(visit);visiting.delete(f);order.push(f);}
+roots.forEach(visit);
+const affected=new Set();
+for(const f of order){if(f===changed||dependencies.get(f).some(d=>affected.has(d)))affected.add(f);}
+for(const f of affected){for(const ext of ['lpo','lpi','lpj']){const p=f.replace(/\.lp$/,'.'+ext);if(fs.existsSync(p))fs.unlinkSync(p);}}
+console.log(order.filter(f=>affected.has(f)||roots.includes(f)||!fs.existsSync(f.replace(/\.lp$/,'.lpo'))).join('\n'));
+NODE
+)"
+mapfile -t targets <<< "$graph"
+log="/home/user1/emdash1-long-exact-v1/emdash2/logs/probes/naturality-owner-$(date +%Y%m%d-%H%M%S).log"
+printf 'stage=%s targets=%s\n' "$stage" "${#targets[@]}" > "$log"
+printf 'checking %s affected/missing targets; log=%s\n' "${#targets[@]}" "$log"
+for target in "${targets[@]}"; do
+  started=$SECONDS
+  printf 'checking %s\n' "$target" >> "$log"
+  set +e
+  bash /home/user1/emdash1-long-exact-v1/emdash2/scripts/lambdapi_resource_guard.sh \
+    lambdapi check -c --no-colors -w "$target" >> "$log" 2>&1
+  rc=$?
+  set -e
+  printf '%s exit=%s elapsed=%ss\n' "$target" "$rc" "$((SECONDS-started))" >> "$log"
+  if [[ "$rc" != 0 ]]; then tail -8 "$log" | cut -c1-220; exit "$rc"; fi
+done
+printf 'owner-position checks completed; log=%s\n' "$log"
