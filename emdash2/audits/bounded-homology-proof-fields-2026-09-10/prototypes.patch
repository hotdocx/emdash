+constant symbol P : τ (Functor (Product_cat C C) C);
+constant symbol t : τ (Obj C);
+constant symbol PA : τ (@PreAbelianCategory C P t);
+constant symbol A : τ (Obj C);
+constant symbol B : τ (Obj C);
+constant symbol D : τ (Obj C);
+constant symbol f : τ (Hom C A B);
+constant symbol g : τ (Hom C B D);
+constant symbol z1 : τ (@= (Hom C A D) (@comp_fapp0 C A B D g f) (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) A D));
+constant symbol z2 : τ (@= (Hom C A D) (@comp_fapp0 C A B D g f) (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) A D));
+constant symbol e1 : τ (@computational_exact_at_selected C P t PA A B D (@computational_chain_pair_intro C (@computational_homology_preadditive C P t PA) A B D f g z1));
+constant symbol e2 : τ (@computational_exact_at_selected C P t PA A B D (@computational_chain_pair_intro C (@computational_homology_preadditive C P t PA) A B D f g z2));
