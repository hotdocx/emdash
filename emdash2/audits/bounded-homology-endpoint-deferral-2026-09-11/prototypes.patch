@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+set -euo pipefail
+stage="${1:?private stage required}"
+checker="${2:?private checker required}"
+fuel="${3:?fuel required}"
+shift 3
+case "$stage" in /tmp/emdash-lp-bounded-env.??????) ;; *) exit 2 ;; esac
+case "$checker" in /tmp/emdash-lp-bounded-congruence.??????/_build/default/src/cli/lambdapi.exe) ;; *) exit 2 ;; esac
+[[ "$fuel" =~ ^[0-9]{1,4}$ ]] && ((fuel <= 4096)) || exit 2
+[[ -d "$stage" && -x "$checker" && $# -gt 0 ]] || exit 2
+cd /home/user1/emdash1-long-exact-v1/emdash2
+graph="$(node - "$stage" "$checker" "$@" <<'NODE'
+const fs=require('fs'),path=require('path'),crypto=require('crypto');
+const [stage,checker,...roots]=process.argv.slice(2);
+const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
+const binaryHash=hash(fs.readFileSync(checker));
+const stamp=path.join(stage,'checker-identity.json');
+if(fs.existsSync(stamp)){
+ const previous=JSON.parse(fs.readFileSync(stamp,'utf8'));
+ if(previous.sha256!==binaryHash)throw Error('binary changed: use a fresh stage');
+}else fs.writeFileSync(stamp,JSON.stringify({checker,sha256:binaryHash},null,2)+'\n');
+const seen=new Set(),active=new Set(),order=[];
