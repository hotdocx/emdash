+/* No rows, H, exactness or terminal object: a single indexed additive law. */
+require open emdash.tmp.probes.finite_role_indices;
+require open emdash.emdash3_2_additive_categories;
+
+constant symbol C : Cat;
+constant symbol S : τ (@PreadditiveCategory C);
+constant symbol n : τ Nat_grpd;
+constant symbol j : τ (FiniteDegree n);
+symbol k0 ≔ @finite_degree_weaken (succ n) (finite_degree_next n j);
+symbol k1 ≔ finite_degree_next (succ n) (@finite_degree_weaken n j);
+constant symbol A : τ (FiniteDegree (succ (succ n))) → τ (Obj C);
+constant symbol B : τ (FiniteDegree (succ (succ n))) → τ (Obj C);
+constant symbol D : τ (FiniteDegree (succ (succ n))) → τ (Obj C);
+constant symbol f : Π k : τ (FiniteDegree (succ (succ n))),
+  τ (Hom C (A k) (B k));
+
+assert ⊢ k0 ≡ k1;
+assert ⊢ @preadditive_comp_zero_left_path C S (A k0) (B k0) (D k0) (f k0)
+  ≡ @preadditive_comp_zero_left_path C S (A k1) (B k1) (D k1) (f k1);
diff --git a/emdash2/tmp/probes/homology_zero_minimal_native.lp b/emdash2/tmp/probes/homology_zero_minimal_native.lp
