/* Reviewer-facing checks for the fixed-source shaped-cell PathOut bridge. */

require open emdash.emdash3_2_shaped_pathout;

// The cold whole comparison and its object observation replace a hot
// evaluator rewrite while retaining every higher action.
type @cat_precomp_composite_path;
type @cat_precomp_composite_component_path;

// The two whole fixed-source family comparisons are typed equality evidence,
// not runtime folds.
type @shaped_fixed_source_unit_path;
type @shaped_fixed_source_target_path;

// The object action computes to (G[x],r[p]).
type @shaped_pathout_object_beta;

// The bridge is a whole functor and retains its next hom action.
type @shaped_pathout_hom_func;
