+++ b/emdash2/tmp/probes/homology_finite_constructor_operations.lp
@@ -0,0 +1,38 @@
+/* Canonical degree operations: each state selects H and its maps once. */
+require open emdash.tmp.probes.homology_finite_constructor_context;
+require open emdash.tmp.probes.homology_row_triple_right_points;
+
+symbol degree_triple (k : τ (FiniteDegree (succ n)))
+≔ @homology_finite_row_triple I C C1 P t (@computational_abelian_preabelian C P t Ab) T (succ n)
+    rows maps zeros k;
+
+symbol degree_object (k : τ (FiniteDegree (succ n))) (role : τ HomologyRole)
+  : τ (Obj C)
+≔ @homology_role_choose (Obj C)
+    (@homology_row_triple_source_homology I C C1 P t (@computational_abelian_preabelian C P t Ab) T T0 KP QP (degree_triple k) x)
+    (@homology_row_triple_middle_homology I C C1 P t (@computational_abelian_preabelian C P t Ab) T T0 KP QP (degree_triple k) x)
+    (@homology_row_triple_right_homology I C C1 P t Ab T T0 KP QP (degree_triple k) x)
+    role;
+
+symbol degree_inclusion (k : τ (FiniteDegree (succ n)))
+  : τ (Hom C (degree_object k homology_role_a) (degree_object k homology_role_b))
+≔ @homology_row_triple_homology_inclusion I C C1 P t (@computational_abelian_preabelian C P t Ab)
+    T T0 KP QP (degree_triple k) x;
+symbol degree_projection (k : τ (FiniteDegree (succ n)))
+  : τ (Hom C (degree_object k homology_role_b) (degree_object k homology_role_c))
+≔ @homology_row_triple_homology_projection I C C1 P t Ab
+    T T0 KP QP (degree_triple k) x;
+
+// The existing connecting component uses the same upper/lower degree choices.
+symbol degree_connecting (k : τ (FiniteDegree n))
+  : τ (Hom C
+    (degree_object (@finite_degree_weaken n k) homology_role_c)
+    (degree_object (finite_degree_next n k) homology_role_a))
+≔ @homology_window_connecting_at I C C1 P t Ab T KP T0 QP (window k) x;
+
+// Whole action in the groupoidal finite-degree parameter uses existing lifting.
+// This is NOT a newly constructed whole I-action on the complete LES.
+symbol degree_object_func (role : τ HomologyRole)
+  : τ (Functor (Path_cat (FiniteDegree (succ n))) C)
+≔ @fapp0 _ _ (@path_lift_func (FiniteDegree (succ n)) C)
+    (λ k : τ (FiniteDegree (succ n)), degree_object k role);
