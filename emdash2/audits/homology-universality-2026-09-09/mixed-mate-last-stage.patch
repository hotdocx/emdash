@@ -0,0 +1,31 @@
+/* Can a selected operation be consumed at the whole-H endpoint without transport? */
+require open emdash.emdash3_2_chain_pair_zero_cone_comparisons;
+
+symbol C : Cat;
+symbol Prod : τ (Functor (Product_cat C C) C);
+symbol t : τ (Obj C);
+symbol PA : τ (@PreAbelianCategory C Prod t);
