{
  "name": "emdash",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript elaborator workbench and emdash v3.2 repository workspace",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13"
  },
  "main": "tests/main_tests.ts",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "start": "./scripts/pnpmw test",
    "test": "node --require ts-node/register --test tests/main_tests.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "workspace:check": "node scripts/check-workspace.mjs",
    "check:ts": "./scripts/pnpmw run workspace:check && ./scripts/pnpmw run typecheck && ./scripts/pnpmw run lint && ./scripts/pnpmw test",
    "check:conformance": "timeout 60s env EMDASH_RUN_LAMBDAPI_PROBES=1 node --require ts-node/register --test tests/v3_2_differential_owner_tests.ts tests/v3_2_differential_rule_tests.ts tests/v3_2_differential_higher_cell_tests.ts",
    "check:directed-conformance": "timeout 60s env EMDASH_RUN_LAMBDAPI_PROBES=1 node --require ts-node/register --test tests/v3_2_directed_1c_tests.ts",
    "check:categorical-displayed-evaluation-conformance": "timeout 60s env EMDASH_RUN_LAMBDAPI_CATEGORICAL_DISPLAYED_EVALUATION_PROBES=1 node --require ts-node/register --test tests/v3_2_categorical_displayed_evaluation_conformance_tests.ts",
    "check:continuation": "./scripts/pnpmw run check:all && ./scripts/pnpmw run check:directed-conformance",
    "demo:directed-dependent": "node --require ts-node/register examples/v3_2_directed_dependent_demo.ts",
    "demo:categorical-bracket": "node --require ts-node/register examples/v3_2_categorical_bracket_demo.ts",
    "demo:categorical-dependent": "node --require ts-node/register examples/v3_2_categorical_dependent_eta_demo.ts",
    "demo:categorical-dependent-composition": "node --require ts-node/register examples/v3_2_categorical_dependent_composition_demo.ts",
    "demo:categorical-comprehension": "node --require ts-node/register examples/v3_2_categorical_comprehension_demo.ts",
    "demo:categorical-fibred-product": "node --require ts-node/register examples/v3_2_categorical_fibred_product_demo.ts",
    "demo:categorical-fibred-structure": "node --require ts-node/register examples/v3_2_categorical_fibred_structure_demo.ts",
    "demo:categorical-fibred-binder": "node --require ts-node/register examples/v3_2_categorical_fibred_binder_demo.ts",
    "demo:categorical-fibred-transfd": "node --require ts-node/register examples/v3_2_categorical_fibred_transfd_demo.ts",
    "demo:categorical-grouped-sequential": "node --require ts-node/register examples/v3_2_categorical_grouped_sequential_demo.ts",
    "demo:categorical-fibred-weaken-reindex": "node --require ts-node/register examples/v3_2_categorical_fibred_weaken_reindex_demo.ts",
    "demo:categorical-fibred-dependent-target": "node --require ts-node/register examples/v3_2_categorical_fibred_dependent_target_demo.ts",
    "demo:categorical-displayed-bracket": "node --require ts-node/register examples/v3_2_categorical_displayed_bracket_demo.ts",
    "demo:categorical-displayed-evaluation": "node --require ts-node/register examples/v3_2_categorical_displayed_evaluation_demo.ts",
    "demo:categorical-displayed-chain": "node --require ts-node/register examples/v3_2_categorical_displayed_chain_demo.ts",
    "demo:categorical-displayed-nd-higher": "node --require ts-node/register examples/v3_2_categorical_displayed_nd_higher_demo.ts",
    "demo:external-review": "node --require ts-node/register examples/v3_2_product_review_demo.ts",
    "check:scale-inventory": "timeout 60s env EMDASH_RUN_LAMBDAPI_SCALE_PROBES=1 node --require ts-node/register --test tests/v3_2_lambdapi_export_inventory_tests.ts tests/v3_2_lf_transfer_acquisition_tests.ts",
    "check:scale-phase-conformance": "timeout 60s env EMDASH_RUN_LAMBDAPI_SCALE_PROBES=1 node --require ts-node/register --test tests/v3_2_lf_transfer_mixed_tests.ts",
    "check:scale-proof-stress": "timeout 60s env EMDASH_RUN_LAMBDAPI_SCALE_PROOF_STRESS_PROBES=1 node --require ts-node/register --test tests/v3_2_scale_stress_2_representation_tests.ts",
    "check:scale-telescope-stress": "timeout 60s env EMDASH_RUN_LAMBDAPI_SCALE_TELESCOPE_STRESS_PROBES=1 node --require ts-node/register --test tests/v3_2_scale_stress_2b_representation_tests.ts tests/v3_2_scale_stress_2b2_representation_tests.ts tests/v3_2_scale_stress_2b3_representation_tests.ts",
    "check:scale-profunctor-stress": "timeout 60s env EMDASH_RUN_LAMBDAPI_SCALE_PROFUNCTOR_STRESS_PROBES=1 node --require ts-node/register --test tests/v3_2_scale_stress_3a1_representation_tests.ts tests/v3_2_scale_stress_3a2a_representation_tests.ts tests/v3_2_scale_stress_3a2b_representation_tests.ts",
    "check:scale-module-stress": "timeout 60s env EMDASH_RUN_LAMBDAPI_SCALE_MODULE_STRESS_PROBES=1 node --require ts-node/register --test tests/v3_2_lf_transfer_visibility_tests.ts tests/v3_2_scale_stress_3b_acquisition_tests.ts",
    "check:scale-stress-proposal": "timeout 60s env EMDASH_RUN_LAMBDAPI_SCALE_STRESS_PROBES=1 node --require ts-node/register --test tests/v3_2_scale_stress_1b_proposal_tests.ts",
    "check:scale": "./scripts/pnpmw run check:continuation && ./scripts/pnpmw run check:scale-inventory && ./scripts/pnpmw run check:scale-phase-conformance && ./scripts/pnpmw run check:scale-proof-stress && ./scripts/pnpmw run check:scale-telescope-stress && ./scripts/pnpmw run check:scale-profunctor-stress && ./scripts/pnpmw run check:scale-module-stress",
    "check": "./scripts/pnpmw run check:ts",
    "check:all": "./scripts/pnpmw run check:ts && ./scripts/pnpmw run check:conformance && make -C emdash2 ci",
    "kernel:check": "make -C emdash2 check",
    "kernel:examples": "make -C emdash2 examples",
    "kernel:ci": "make -C emdash2 ci",
    "print:dev": "./scripts/pnpmw --dir emdash2/print dev",
    "print:browser:install": "./scripts/pnpmw --dir emdash2/print run browser:install",
    "print:build": "./scripts/pnpmw --dir emdash2/print build",
    "print:check": "./scripts/pnpmw --dir emdash2/print check:render",
    "book:assemble": "./scripts/pnpmw --dir emdash2/print book:assemble",
    "book:typography": "./scripts/pnpmw --dir emdash2/print book:typography",
    "book:check": "./scripts/pnpmw --dir emdash2/print book:check",
    "book:render": "./scripts/pnpmw --dir emdash2/print book:render",
    "book:pdf": "./scripts/pnpmw --dir emdash2/print book:pdf",
    "book:pdf:check": "./scripts/pnpmw --dir emdash2/print book:pdf:check",
    "book:release": "./scripts/pnpmw --dir emdash2/print book:release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "globals": "^16.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  }
}
