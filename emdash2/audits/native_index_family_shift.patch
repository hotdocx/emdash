+// Whole R in the strict-cartesian reference environment. Its source shifts
+// again: universe transformations reverse from dimension 3, not dimension 2.
+// Arbitrary lax/Gray-profile qualification is explicitly not supplied here.
+constant symbol native_homwise_dual : τ (Functor (CoAbove3_cat Cat_cat) Cat_cat);
+rule @fapp0 _ _ native_homwise_dual $A ↪ CoAbove2_cat $A;
+rule @fapp1_func _ _ native_homwise_dual $A $B
+  ↪ CoAbove2_functor_cat_func $A $B;
+rule @fapp1_fapp0 _ _ native_homwise_dual $A $B $F
+  ↪ @CoAbove2_func $A $B $F;
