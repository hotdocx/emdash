+/* An exact finite result together with zero identity at its actual endpoints.
+   The carrier reuses the existing tail; it neither replaces endpoint objects
+   nor postulates exactness or a connecting map. */
+require open emdash.emdash3_2_computational_exact_arrow_tails;
+require open emdash.emdash3_2_finite_arrow_tail_append;
+
+symbol ComputationalExactArrowTailEnds [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)] (xs : τ (@ComputationalExactArrowTail C P t PA n A B f)) : Grpd
+≔ @Product_grpd (@= (Hom C A A) (@id C A) (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) A A)) (@= (Hom C (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f xs) (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f xs)) (@id C (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f xs)) (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f xs) (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f xs)));
+
+symbol ComputationalBoundedExactArrowTail [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  (n : τ Nat_grpd) (A B : τ (Obj C)) (f : τ (Hom C A B)) : Grpd
+≔ @Sigma_grpd (@ComputationalExactArrowTail C P t PA n A B f) (λ xs : τ (@ComputationalExactArrowTail C P t PA n A B f), @ComputationalExactArrowTailEnds C P t PA n A B f xs);
+
+symbol computational_bounded_exact_arrow_tail_intro [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)] (xs : τ (@ComputationalExactArrowTail C P t PA n A B f)) (ends : τ (@ComputationalExactArrowTailEnds C P t PA n A B f xs))
+  : τ (@ComputationalBoundedExactArrowTail C P t PA n A B f)
+≔ @Struct_sigma (@ComputationalExactArrowTail C P t PA n A B f) (λ xs : τ (@ComputationalExactArrowTail C P t PA n A B f), @ComputationalExactArrowTailEnds C P t PA n A B f xs) xs ends;
+
+symbol computational_bounded_exact_arrow_tail_value [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)] (value : τ (@ComputationalBoundedExactArrowTail C P t PA n A B f)) : τ (@ComputationalExactArrowTail C P t PA n A B f)
+≔ sigma_Fst value;
+
+symbol computational_bounded_exact_arrow_tail_ends [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)] (value : τ (@ComputationalBoundedExactArrowTail C P t PA n A B f)) : τ (@ComputationalExactArrowTailEnds C P t PA n A B f (@computational_bounded_exact_arrow_tail_value C P t PA n A B f value))
+≔ sigma_Snd value;
+
+symbol computational_bounded_exact_arrow_tail_left_zero [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)] (value : τ (@ComputationalBoundedExactArrowTail C P t PA n A B f)) : τ (@= (Hom C A A) (@id C A) (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) A A))
+≔ sigma_Fst (@computational_bounded_exact_arrow_tail_ends C P t PA n A B f value);
+
+symbol computational_bounded_exact_arrow_tail_right_zero [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)] (value : τ (@ComputationalBoundedExactArrowTail C P t PA n A B f)) : τ (@= (Hom C (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f (@computational_bounded_exact_arrow_tail_value C P t PA n A B f value)) (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f (@computational_bounded_exact_arrow_tail_value C P t PA n A B f value))) (@id C (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f (@computational_bounded_exact_arrow_tail_value C P t PA n A B f value))) (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f (@computational_bounded_exact_arrow_tail_value C P t PA n A B f value)) (@finite_arrow_tail_last_target C (@ComputationalExactArrowStep C P t PA) n A B f (@computational_bounded_exact_arrow_tail_value C P t PA n A B f value))))
+≔ sigma_Snd (@computational_bounded_exact_arrow_tail_ends C P t PA n A B f value);
