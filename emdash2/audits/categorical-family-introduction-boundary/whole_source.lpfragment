/* UA-4c actual whole source comparison p∘Γ ≅ A.
   Append after the protected graph owner, candidate rules, and the
   object/source part of constructor_fragment.lp, as documented in README.md.
   Every map/inverse is built from existing identities, whiskering and
   IsoEvidence composition. No functor data is transported along a path. */
symbol ua4c_op_total_projection [K : Cat] (E : τ (Catd K)) (s : τ (Obj (@Pi_cat K E)))
 : τ (Functor (Op_cat K) (Op_cat K))
≔ @comp_cat_fapp0 (Op_cat K) (Op_cat (@Sigma_cat K E)) (Op_cat K)
 (@Op_func (@Sigma_cat K E) K (@Sigma_proj1_func K E))
 (@Op_func K (@Sigma_cat K E) (@section_total_func K E s));

// Presentations of the existing Sigma projection equations under Op_func.
symbol ua4c_op_map_projection [K : Cat] (E D : τ (Catd K)) (FF : τ (@Functord K E D))
 : τ (Functor (Op_cat (@Sigma_cat K E)) (Op_cat K))
≔ @comp_cat_fapp0 (Op_cat (@Sigma_cat K E)) (Op_cat (@Sigma_cat K D)) (Op_cat K)
 (@Op_func (@Sigma_cat K D) K (@Sigma_proj1_func K D))
 (@Op_func (@Sigma_cat K E) (@Sigma_cat K D) (@sigma_map_func K E D FF));


symbol ua4c_op_basechange_projection [A K : Cat] (F : τ (Functor A K)) (E : τ (Catd K))
 : τ (Functor (Op_cat (@Sigma_cat A (@Pullback_catd A K E F))) (Op_cat K))
≔ @comp_cat_fapp0 (Op_cat (@Sigma_cat A (@Pullback_catd A K E F))) (Op_cat (@Sigma_cat K E)) (Op_cat K)
 (@Op_func (@Sigma_cat K E) K (@Sigma_proj1_func K E))
 (@Op_func (@Sigma_cat A (@Pullback_catd A K E F)) (@Sigma_cat K E) (@sigma_pullback_total_func A K F E));
symbol ua4c_op_basechange_projected [A K : Cat] (F : τ (Functor A K)) (E : τ (Catd K))
 : τ (Functor (Op_cat (@Sigma_cat A (@Pullback_catd A K E F))) (Op_cat K))
≔ @comp_cat_fapp0 (Op_cat (@Sigma_cat A (@Pullback_catd A K E F))) (Op_cat A) (Op_cat K)
 (@Op_func A K F) (@Op_func (@Sigma_cat A (@Pullback_catd A K E F)) A (@Sigma_proj1_func A (@Pullback_catd A
   K E F)));


symbol ua4c_op_total_evidence [K : Cat] (E : τ (Catd K)) (s : τ (Obj (@Pi_cat K E)))
 : τ (IsoEvidence (Functor_cat (Op_cat K) (Op_cat K)) (@ua4c_op_total_projection K E s) (@id_func (Op_cat
   K)))
≔ @iso_evidence_intro (Functor_cat (Op_cat K) (Op_cat K)) (@ua4c_op_total_projection K E s) (@id_func
  (Op_cat K))
 (@id (Functor_cat (Op_cat K) (Op_cat K)) (@ua4c_op_total_projection K E s)) (@id (Functor_cat (Op_cat K)
   (Op_cat K)) (@id_func (Op_cat K)))
 (eq_refl (@id (Functor_cat (Op_cat K) (Op_cat K)) (@ua4c_op_total_projection K E s))) (eq_refl (@id
   (Functor_cat (Op_cat K) (Op_cat K)) (@id_func (Op_cat K))));

symbol ua4c_op_map_evidence [K : Cat] (E D : τ (Catd K)) (FF : τ (@Functord K E D))
 : τ (IsoEvidence (Functor_cat (Op_cat (@Sigma_cat K E)) (Op_cat K)) (@ua4c_op_map_projection K E D FF)
   (@Op_func (@Sigma_cat K E) K (@Sigma_proj1_func K E)))
≔ @iso_evidence_intro (Functor_cat (Op_cat (@Sigma_cat K E)) (Op_cat K)) (@ua4c_op_map_projection K E D FF)
  (@Op_func (@Sigma_cat K E) K (@Sigma_proj1_func K E))
 (@id (Functor_cat (Op_cat (@Sigma_cat K E)) (Op_cat K)) (@ua4c_op_map_projection K E D FF)) (@id
   (Functor_cat (Op_cat (@Sigma_cat K E)) (Op_cat K)) (@Op_func (@Sigma_cat K E) K (@Sigma_proj1_func K E)))
 (eq_refl (@id (Functor_cat (Op_cat (@Sigma_cat K E)) (Op_cat K)) (@ua4c_op_map_projection K E D FF)))
   (eq_refl (@id (Functor_cat (Op_cat (@Sigma_cat K E)) (Op_cat K)) (@Op_func (@Sigma_cat K E) K
   (@Sigma_proj1_func K E))));

symbol ua4c_op_basechange_evidence [A K : Cat] (F : τ (Functor A K)) (E : τ (Catd K))
 : τ (IsoEvidence (Functor_cat (Op_cat (@Sigma_cat A (@Pullback_catd A K E F))) (Op_cat K))
   (@ua4c_op_basechange_projection A K F E) (@ua4c_op_basechange_projected A K F E))
≔ @iso_evidence_intro (Functor_cat (Op_cat (@Sigma_cat A (@Pullback_catd A K E F))) (Op_cat K))
  (@ua4c_op_basechange_projection A K F E) (@ua4c_op_basechange_projected A K F E)
 (@id (Functor_cat (Op_cat (@Sigma_cat A (@Pullback_catd A K E F))) (Op_cat K))
   (@ua4c_op_basechange_projection A K F E)) (@id (Functor_cat (Op_cat (@Sigma_cat A (@Pullback_catd A K E
   F))) (Op_cat K)) (@ua4c_op_basechange_projected A K F E))
 (eq_refl (@id (Functor_cat (Op_cat (@Sigma_cat A (@Pullback_catd A K E F))) (Op_cat K))
   (@ua4c_op_basechange_projection A K F E))) (eq_refl (@id (Functor_cat (Op_cat (@Sigma_cat A
   (@Pullback_catd A K E F))) (Op_cat K)) (@ua4c_op_basechange_projected A K F E)));

symbol ua4c_prewhisker [A B C : Cat] (H : τ (Functor A B))
 (F G : τ (Functor B C)) (i : τ (IsoEvidence (Functor_cat B C) F G))
 : τ (IsoEvidence (Functor_cat A C) (@comp_cat_fapp0 A B C F H) (@comp_cat_fapp0 A B C G H))
≔ @iso_evidence_fmap (Functor_cat B C) (Functor_cat A C) (@comp_cat_con_func A B C H) F G i;
symbol ua4c_postwhisker [A B C : Cat] (H : τ (Functor B C))
 (F G : τ (Functor A B)) (i : τ (IsoEvidence (Functor_cat A B) F G))
 : τ (IsoEvidence (Functor_cat A C) (@comp_cat_fapp0 A B C H F) (@comp_cat_fapp0 A B C H G))
≔ @iso_evidence_fmap (Functor_cat A B) (Functor_cat A C) (@comp_cat_cov_func A B C H) F G i;

symbol ua4c_gamma_source0 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h
  : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor K X)
≔ (@comp_cat_fapp0 K (@RepresentedComma_cat X Y J) X (@represented_comma_source_func X Y J)
  (@represented_comma_family_func K X Y J A D h));

symbol ua4c_gamma_source1 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h
  : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor K X)
≔ (@comp_cat_fapp0 K (Op_cat (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A))) X
  (@comp_cat_fapp0 (Op_cat (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A))) (Op_cat
  (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y J))) X (@Op_func (@Sigma_cat (Op_cat X)
  (@represented_comma_family_catd X Y J)) (Op_cat X) (@Sigma_proj1_func (Op_cat X)
  (@represented_comma_family_catd X Y J))) (@Op_func (@Sigma_cat (Op_cat K)
  (@represented_comma_family_target K X Y J A)) (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y
  J)) (@sigma_pullback_total_func (Op_cat K) (Op_cat X) (@Op_func K X A) (@represented_comma_family_catd X Y
  J)))) (@Op_func (Op_cat K) (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A))
  (@section_total_func (Op_cat K) (@represented_comma_family_target K X Y J A)
  (@represented_comma_family_section K X Y J A D h))));

symbol ua4c_gamma_source2 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h
  : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor K X)
≔ (@comp_cat_fapp0 K (Op_cat (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A))) X
  (@comp_cat_fapp0 (Op_cat (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A))) K X A
  (@Op_func (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A)) (Op_cat K)
  (@Sigma_proj1_func (Op_cat K) (@represented_comma_family_target K X Y J A)))) (@Op_func (Op_cat K)
  (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A)) (@section_total_func (Op_cat K)
  (@represented_comma_family_target K X Y J A) (@represented_comma_family_section K X Y J A D h))));

symbol ua4c_gamma_step1 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h :
  τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D))
 : τ (IsoEvidence (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h) (@ua4c_gamma_source1 K X Y J A D h))
≔ @ua4c_prewhisker K (Op_cat (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A))) X
  (@Op_func (Op_cat K) (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A))
  (@section_total_func (Op_cat K) (@represented_comma_family_target K X Y J A)
  (@represented_comma_family_section K X Y J A D h))) (@comp_cat_fapp0 (Op_cat (@Sigma_cat (Op_cat K)
  (@represented_comma_family_target K X Y J A))) (Op_cat (@Sigma_cat (Op_cat X)
  (@represented_comma_family_catd X Y J))) X (@ua4c_op_map_projection (Op_cat X)
  (@represented_comma_family_catd X Y J) (@homdc_op_edge_catd X Y (@represented_comma_prof X Y J))
  (@represented_comma_family_reframe X Y J)) (@Op_func (@Sigma_cat (Op_cat K)
  (@represented_comma_family_target K X Y J A)) (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y
  J)) (@sigma_pullback_total_func (Op_cat K) (Op_cat X) (@Op_func K X A) (@represented_comma_family_catd X Y
  J)))) (@comp_cat_fapp0 (Op_cat (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A)))
  (Op_cat (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y J))) X (@Op_func (@Sigma_cat (Op_cat X)
  (@represented_comma_family_catd X Y J)) (Op_cat X) (@Sigma_proj1_func (Op_cat X)
  (@represented_comma_family_catd X Y J))) (@Op_func (@Sigma_cat (Op_cat K)
  (@represented_comma_family_target K X Y J A)) (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y
  J)) (@sigma_pullback_total_func (Op_cat K) (Op_cat X) (@Op_func K X A) (@represented_comma_family_catd X Y
  J)))) (@ua4c_prewhisker (Op_cat (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A)))
  (Op_cat (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y J))) X (@Op_func (@Sigma_cat (Op_cat K)
  (@represented_comma_family_target K X Y J A)) (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y
  J)) (@sigma_pullback_total_func (Op_cat K) (Op_cat X) (@Op_func K X A) (@represented_comma_family_catd X Y
  J))) (@ua4c_op_map_projection (Op_cat X) (@represented_comma_family_catd X Y J) (@homdc_op_edge_catd X Y
  (@represented_comma_prof X Y J)) (@represented_comma_family_reframe X Y J)) (@Op_func (@Sigma_cat (Op_cat
  X) (@represented_comma_family_catd X Y J)) (Op_cat X) (@Sigma_proj1_func (Op_cat X)
  (@represented_comma_family_catd X Y J))) (@ua4c_op_map_evidence (Op_cat X) (@represented_comma_family_catd
  X Y J) (@homdc_op_edge_catd X Y (@represented_comma_prof X Y J)) (@represented_comma_family_reframe X Y
  J)));

symbol ua4c_gamma_step2 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h :
  τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D))
 : τ (IsoEvidence (Functor_cat K X) (@ua4c_gamma_source1 K X Y J A D h) (@ua4c_gamma_source2 K X Y J A D h))
≔ @ua4c_prewhisker K (Op_cat (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A))) X
  (@Op_func (Op_cat K) (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A))
  (@section_total_func (Op_cat K) (@represented_comma_family_target K X Y J A)
  (@represented_comma_family_section K X Y J A D h))) (@ua4c_op_basechange_projection (Op_cat K) (Op_cat X)
  (@Op_func K X A) (@represented_comma_family_catd X Y J)) (@ua4c_op_basechange_projected (Op_cat K) (Op_cat
  X) (@Op_func K X A) (@represented_comma_family_catd X Y J)) (@ua4c_op_basechange_evidence (Op_cat K)
  (Op_cat X) (@Op_func K X A) (@represented_comma_family_catd X Y J));

symbol ua4c_gamma_step3 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h :
  τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D))
 : τ (IsoEvidence (Functor_cat K X) (@ua4c_gamma_source2 K X Y J A D h) A)
≔ @ua4c_postwhisker K K X A (@ua4c_op_total_projection (Op_cat K) (@represented_comma_family_target K X Y J
  A) (@represented_comma_family_section K X Y J A D h)) (@id_func K) (@ua4c_op_total_evidence (Op_cat K)
  (@represented_comma_family_target K X Y J A) (@represented_comma_family_section K X Y J A D h));

symbol ua4c_gamma_source_evidence [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor
  K Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D))
 : τ (IsoEvidence (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h) A)
≔ @iso_evidence_comp (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h) (@ua4c_gamma_source1 K X Y J A D
  h) A
 (@iso_evidence_comp (Functor_cat K X) (@ua4c_gamma_source1 K X Y J A D h) (@ua4c_gamma_source2 K X Y J A D
   h) A (@ua4c_gamma_step3 K X Y J A D h) (@ua4c_gamma_step2 K X Y J A D h))
 (@ua4c_gamma_step1 K X Y J A D h);

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) (x : τ (Obj K)) ⊢ @tapp0_fapp0 K X (@ua4c_gamma_source0 K X Y J A D h) A x
  (@iso_evidence_to _ _ _ (@ua4c_gamma_source_evidence K X Y J A D h)) ≡ @id X (@fapp0 K X A x);

// Inverse component and both retained whole inverse laws.
assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) (x : τ (Obj K)) ⊢
 @tapp0_fapp0 K X A (@ua4c_gamma_source0 K X Y J A D h) x (@iso_evidence_from (Functor_cat K X)
   (@ua4c_gamma_source0 K X Y J A D h) A (@ua4c_gamma_source_evidence K X Y J A D h))
 ≡ @id X (@fapp0 K X A x);

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) ⊢ @iso_evidence_left (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h)
  A (@ua4c_gamma_source_evidence K X Y J A D h)
 : τ (@= (Hom (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h) (@ua4c_gamma_source0 K X Y J A D h))
     (@comp_fapp0 (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h) A (@ua4c_gamma_source0 K X Y J A D
       h) (@iso_evidence_from (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h) A
       (@ua4c_gamma_source_evidence K X Y J A D h)) (@iso_evidence_to (Functor_cat K X) (@ua4c_gamma_source0
       K X Y J A D h) A (@ua4c_gamma_source_evidence K X Y J A D h)))
     (@id (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h)));

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) ⊢ @iso_evidence_right (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D
  h) A (@ua4c_gamma_source_evidence K X Y J A D h)
 : τ (@= (Hom (Functor_cat K X) A A)
     (@comp_fapp0 (Functor_cat K X) A (@ua4c_gamma_source0 K X Y J A D h) A (@iso_evidence_to (Functor_cat K
       X) (@ua4c_gamma_source0 K X Y J A D h) A (@ua4c_gamma_source_evidence K X Y J A D h))
       (@iso_evidence_from (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h) A
       (@ua4c_gamma_source_evidence K X Y J A D h)))
     (@id (Functor_cat K X) A));


// Formation control for the comparison's off-diagonal action.
symbol ua4c_gamma_source_to [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y))
  (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D))
 : τ (@Transf K X (@ua4c_gamma_source0 K X Y J A D h) A)
≔ @iso_evidence_to (Functor_cat K X) (@ua4c_gamma_source0 K X Y J A D h) A (@ua4c_gamma_source_evidence K X
  Y J A D h);
symbol ua4c_gamma_source_to_arrow [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor
  K Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D))
 (x y : τ (Obj K)) (g : τ (Hom K x y))
 : τ (Hom X (@fapp0 K X (@ua4c_gamma_source0 K X Y J A D h) x) (@fapp0 K X A y))
≔ @tapp1_fapp0 K X (@ua4c_gamma_source0 K X Y J A D h) A x y
    (@ua4c_gamma_source_to K X Y J A D h) g;


// Proof-time projection comparison does not change runtime functor heads.
assert [K : Cat] (E : τ (Catd K)) (s : τ (Obj (@Pi_cat K E))) ⊢
 @eq_refl (Functor (Op_cat K) (Op_cat K)) (@ua4c_op_total_projection K E s)
 : τ (@= (Functor (Op_cat K) (Op_cat K))
     (@ua4c_op_total_projection K E s) (@id_func (Op_cat K)));
assertnot [K : Cat] (E : τ (Catd K)) (s : τ (Obj (@Pi_cat K E))) ⊢
 @ua4c_op_total_projection K E s ≡ @id_func (Op_cat K);

// An unrelated endofunctor is not identified with the identity.
assertnot [K : Cat] (F : τ (Functor K K)) ⊢
 @eq_refl (Functor K K) F
 : τ (@= (Functor K K) F (@id_func K));

// Projecting an arbitrary functor into a total does not make it a section.
assertnot [K : Cat] (E : τ (Catd K)) (F : τ (Functor K (@Sigma_cat K E))) ⊢
 @eq_refl (Functor (Op_cat K) (Op_cat K))
   (@comp_cat_fapp0 (Op_cat K) (Op_cat (@Sigma_cat K E)) (Op_cat K)
     (@Op_func (@Sigma_cat K E) K (@Sigma_proj1_func K E))
     (@Op_func K (@Sigma_cat K E) F))
 : τ (@= (Functor (Op_cat K) (Op_cat K))
   (@comp_cat_fapp0 (Op_cat K) (Op_cat (@Sigma_cat K E)) (Op_cat K)
     (@Op_func (@Sigma_cat K E) K (@Sigma_proj1_func K E))
     (@Op_func K (@Sigma_cat K E) F)) (@id_func (Op_cat K)));

// Congruence does not identify composites with different supplied operands.
assertnot [B C : Cat] (F G H : τ (Functor B C))
 (f f0 : τ (@Transf B C F G)) (g g0 : τ (@Transf B C G H)) ⊢
 @eq_refl (@Transf B C F H) (@comp_fapp0 (Functor_cat B C) F G H g f)
 : τ (@= (@Transf B C F H) (@comp_fapp0 (Functor_cat B C) F G H g f)
     (@comp_fapp0 (Functor_cat B C) F G H g0 f0));
