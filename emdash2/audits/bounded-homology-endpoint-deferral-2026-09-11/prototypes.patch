+++ b/emdash2/tmp/probes/homology_zero_minimal_native.lp
@@ -0,0 +1,34 @@
+/* Native projections but no short-exact records, windows, H or Abelian package. */
+require open emdash.tmp.probes.finite_role_indices;
+require open emdash.emdash3_2_zero_arrow_cones;
+require open emdash.emdash3_2_additive_categories;
+
+constant symbol I : Cat;
+constant symbol C : Cat;
+constant symbol S : τ (@PreadditiveCategory C);
+constant symbol t : τ (Obj C);
+constant symbol T : τ (@TerminalObject C t);
+constant symbol n : τ Nat_grpd;
+constant symbol j : τ (FiniteDegree n);
+symbol k0 ≔ @finite_degree_weaken (succ n) (finite_degree_next n j);
+symbol k1 ≔ finite_degree_next (succ n) (@finite_degree_weaken n j);
+constant symbol F : τ (FiniteDegree (succ (succ n))) →
+  τ (Functor I (@ZeroArrowCone_cat C t T));
+constant symbol x : τ (Obj I);
+
+symbol z (k : τ (FiniteDegree (succ (succ n))))
+≔ @fapp0 I (@ZeroArrowCone_cat C t T) (F k) x;
+symbol a (k : τ (FiniteDegree (succ (succ n))))
+≔ @fapp0 (@ZeroArrowCone_cat C t T) C
+    (@zero_arrow_cone_first_func C t T) (z k);
+symbol d (k : τ (FiniteDegree (succ (succ n))))
+≔ @fapp0 (@ZeroArrowCone_cat C t T) (Functor_cat WalkingArrow_cat C)
+    (@zero_arrow_cone_diagram_func C t T) (z k);
+symbol law (k : τ (FiniteDegree (succ (succ n))))
+≔ @preadditive_comp_zero_left_path C S (a k) t
+    (@fapp0 WalkingArrow_cat C (d k) walking_arrow_tgt)
+    (@terminal_arrow_fapp0 C t T (a k));
+
+assert ⊢ k0 ≡ k1;
+assert ⊢ a k0 ≡ a k1;
+assert ⊢ law k0 ≡ law k1;
