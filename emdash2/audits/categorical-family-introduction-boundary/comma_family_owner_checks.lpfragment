   (@comma_section_gamma_target_extraction_equiv K X Y J A D h Y1)) (@comma_section_gamma_target_extraction_op K X Y J A D h))
   (@id (Functor_cat K Y) (@comma_section_gamma_target_section_op K X Y J A D h)));

