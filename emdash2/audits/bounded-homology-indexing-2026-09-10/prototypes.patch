diff --git a/emdash2/tmp/probes/finite_role_indices.lp b/emdash2/tmp/probes/finite_role_indices.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/finite_role_indices.lp
@@ -0,0 +1,40 @@
+/* Finite degrees 0,…,n, independent of any interpreted object or proof. */
+require open emdash.emdash3_2;
+
+inductive FiniteDegreeData : nat → TYPE ≔
+| finite_degree_first : Π n : nat, FiniteDegreeData n
+| finite_degree_next : Π n : nat, FiniteDegreeData n → FiniteDegreeData (succ n);
+
+constant symbol FiniteDegree (n : τ Nat_grpd) : Grpd;
+rule τ (FiniteDegree $n) ↪ FiniteDegreeData $n;
+
+// Preserve the ordinal value while increasing the available upper bound.
+symbol finite_degree_weaken [n : τ Nat_grpd]
+  (j : τ (FiniteDegree n)) : τ (FiniteDegree (succ n));
+rule @finite_degree_weaken _ (finite_degree_first $n)
+  ↪ finite_degree_first (succ $n);
+rule @finite_degree_weaken _ (finite_degree_next $n $j)
+  ↪ finite_degree_next (succ $n) (@finite_degree_weaken $n $j);
+
+symbol finite_degree_last (n : τ Nat_grpd) : τ (FiniteDegree n)
+≔ nat_elim (λ k, FiniteDegree k) (finite_degree_first zero)
+    (λ k j, finite_degree_next k j) n;
+
+/* Separate roles retain the intended H(A), H(B), H(C) normal forms. */
+inductive HomologyRoleData : TYPE ≔
+| homology_role_a : HomologyRoleData
+| homology_role_b : HomologyRoleData
+| homology_role_c : HomologyRoleData;
+
+constant symbol HomologyRole : Grpd;
+rule τ HomologyRole ↪ HomologyRoleData;
+
+symbol homology_role_choose [V : Grpd]
+  (a b c : τ V) (role : τ HomologyRole) : τ V
+≔ ind_HomologyRoleData (λ _, V) a b c role;
+
+// The selected value is an actual whole functor, not only its point map.
+symbol finite_role_func [I C : Cat] [n : τ Nat_grpd]
+  (A B D : τ (FiniteDegree n) → τ (Functor I C))
+  (j : τ (FiniteDegree n)) (role : τ HomologyRole) : τ (Functor I C)
+≔ @homology_role_choose (Functor I C) (A j) (B j) (D j) role;
diff --git a/emdash2/tmp/probes/finite_role_indices_checks.lp b/emdash2/tmp/probes/finite_role_indices_checks.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/finite_role_indices_checks.lp
@@ -0,0 +1,27 @@
+/* Symbolic-index beta and noncollapse controls. */
+require open emdash.tmp.probes.finite_role_indices;
+constant symbol n : τ Nat_grpd;
+constant symbol j : τ (FiniteDegree n);
+assert ⊢ @finite_degree_weaken (succ n) (finite_degree_next n j)
+  ≡ finite_degree_next (succ n) (@finite_degree_weaken n j);
+assert ⊢ finite_degree_last (succ n)
+  ≡ finite_degree_next n (finite_degree_last n);
+assert ⊢ finite_degree_last zero ≡ finite_degree_first zero;
+assertnot ⊢ finite_degree_next zero (finite_degree_first zero)
+  : τ (FiniteDegree zero);
+assertnot ⊢ finite_degree_first (succ n)
+  ≡ finite_degree_next n j;
+assertnot ⊢ homology_role_a ≡ homology_role_c;
+
+constant symbol I : Cat;
+constant symbol C : Cat;
+constant symbol A : τ (FiniteDegree n) → τ (Functor I C);
+constant symbol B : τ (FiniteDegree n) → τ (Functor I C);
+constant symbol D : τ (FiniteDegree n) → τ (Functor I C);
+constant symbol x : τ (Obj I);
+constant symbol y : τ (Obj I);
+assert ⊢ @finite_role_func I C n A B D j homology_role_a ≡ A j;
+assert ⊢ @fapp0 I C (@finite_role_func I C n A B D j homology_role_c) x
+  ≡ @fapp0 I C (D j) x;
+assert ⊢ @fapp1_func I C (@finite_role_func I C n A B D j homology_role_b) x y
+  ≡ @fapp1_func I C (B j) x y;
diff --git a/emdash2/tmp/probes/homology_finite_row_lookup.lp b/emdash2/tmp/probes/homology_finite_row_lookup.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/homology_finite_row_lookup.lp
@@ -0,0 +1,63 @@
+/* Bounded coherent row lookup: no independently supplied window overlaps. */
+require open emdash.tmp.probes.finite_role_indices;
+require open emdash.emdash3_2_homology_row_triples;
+
+symbol homology_finite_row_triple [I C : Cat]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t))
+  [n : τ Nat_grpd]
+  (rows : τ (FiniteDegree (succ (succ n))) →
+    τ (@ShortExactRowFamily I C C1 P t PA T))
+  (maps : Π j : τ (FiniteDegree (succ n)),
+    τ (@Transf I (@ZeroArrowCone_cat C t T)
+      (@short_exact_row_family_func I C C1 P t PA T
+        (rows (@finite_degree_weaken (succ n) j)))
+      (@short_exact_row_family_func I C C1 P t PA T
+        (rows (finite_degree_next (succ n) j)))))
+  (zeros : Π j : τ (FiniteDegree n),
+    τ (@RowFamilyMiddleChainZero I C C1 P t PA T
+      (rows (@finite_degree_weaken (succ n) (@finite_degree_weaken n j)))
+      (rows (finite_degree_next (succ n) (@finite_degree_weaken n j)))
+      (rows (finite_degree_next (succ n) (finite_degree_next n j)))
+      (maps (@finite_degree_weaken n j))
+      (maps (finite_degree_next n j))))
+  (j : τ (FiniteDegree n)) : τ (@HomologyRowTriple I C C1 P t PA T)
+≔ @homology_row_triple_intro I C C1 P t PA T
+    (rows (@finite_degree_weaken (succ n) (@finite_degree_weaken n j)))
+    (rows (finite_degree_next (succ n) (@finite_degree_weaken n j)))
+    (rows (finite_degree_next (succ n) (finite_degree_next n j)))
+    (maps (@finite_degree_weaken n j)) (maps (finite_degree_next n j))
+    (zeros j);
+
+symbol homology_finite_row_window [I C : Cat]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t))
+  [n : τ Nat_grpd]
+  (rows : τ (FiniteDegree (succ (succ (succ n)))) →
+    τ (@ShortExactRowFamily I C C1 P t PA T))
+  (maps : Π j : τ (FiniteDegree (succ (succ n))),
+    τ (@Transf I (@ZeroArrowCone_cat C t T)
+      (@short_exact_row_family_func I C C1 P t PA T
+        (rows (@finite_degree_weaken (succ (succ n)) j)))
+      (@short_exact_row_family_func I C C1 P t PA T
+        (rows (finite_degree_next (succ (succ n)) j)))))
+  (zeros : Π j : τ (FiniteDegree (succ n)),
+    τ (@RowFamilyMiddleChainZero I C C1 P t PA T
+      (rows (@finite_degree_weaken (succ (succ n))
+        (@finite_degree_weaken (succ n) j)))
+      (rows (finite_degree_next (succ (succ n))
+        (@finite_degree_weaken (succ n) j)))
+      (rows (finite_degree_next (succ (succ n))
+        (finite_degree_next (succ n) j)))
+      (maps (@finite_degree_weaken (succ n) j))
+      (maps (finite_degree_next (succ n) j))))
+  (j : τ (FiniteDegree n)) : τ (@HomologyWindowFamily I C C1 P t PA T)
+≔ @homology_row_triple_window I C C1 P t PA T
+    (@homology_finite_row_triple I C C1 P t PA T (succ n)
+      rows maps zeros (@finite_degree_weaken n j))
+    (rows (finite_degree_next (succ (succ n))
+      (finite_degree_next (succ n) (finite_degree_next n j))))
+    (maps (finite_degree_next (succ n) (finite_degree_next n j)))
+    (zeros (finite_degree_next n j));
