+/* Existing Q usability mediates the typing; both identities erase to f. */
+require open emdash.tmp.probes.homology_finite_degree_point_operations;
+require open emdash.tmp.probes.homology_row_triple_native_inputs;
+require open emdash.tmp.probes.homology_same_boundary_usability;
+
+symbol degree_connecting_selected (k : τ (FiniteDegree n))
+  : τ (Hom C (@homology_same_boundary_selected_object C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) C1 t T T0 (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab)) (@preabelian_cokernels C P t (@computational_abelian_preabelian C P t Ab)) KP QP (@homology_row_triple_right_input I C C1 P t Ab T KP (degree_triple (@finite_degree_weaken n k)) x)) (@homology_same_boundary_selected_object C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) C1 t T T0 (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab)) (@preabelian_cokernels C P t (@computational_abelian_preabelian C P t Ab)) KP QP (@homology_row_triple_source_input I C C1 P t Ab T KP (degree_triple (finite_degree_next n k)) x)))
+≔ @homology_window_connecting_at I C C1 P t Ab T KP T0 QP (window k) x;
+
+symbol degree_connecting_via_selected (k : τ (FiniteDegree n))
+  : τ (Hom C (degree_object (@finite_degree_weaken n k) homology_role_c)
+    (degree_object (finite_degree_next n k) homology_role_a))
+≔ @homology_from_selected_hom C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) C1 t T T0 (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab)) (@preabelian_cokernels C P t (@computational_abelian_preabelian C P t Ab)) KP QP
+    (@homology_row_triple_right_input I C C1 P t Ab T KP (degree_triple (@finite_degree_weaken n k)) x) (@homology_row_triple_source_input I C C1 P t Ab T KP (degree_triple (finite_degree_next n k)) x)
+    (degree_connecting_selected k);
diff --git a/emdash2/tmp/probes/homology_direct_native_input.lp b/emdash2/tmp/probes/homology_direct_native_input.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/homology_direct_native_input.lp
@@ -0,0 +1,72 @@
+/* Direct ordinary-target native input from the ORIGINAL chain-zero triangle.
+   The comparison cell is derived from the existing zero path; no new cone,
+   square equation, kernel choice or caller-supplied naturality field is added. */
+require open emdash.emdash3_2_chain_pair_zero_cones;
+require open emdash.emdash3_2_one_cat_arrow_diagrams;
+require open emdash.emdash3_2_additive_categories;
+
+symbol direct_chain_zero_cell
+  [C : Cat] (S : τ (@PreadditiveCategory C))
+  [t : τ (Obj C)] (T : τ (@TerminalObject C t))
+  [A B D : τ (Obj C)] (pair : τ (@ComputationalChainPair C S A B D))
+  : τ (Hom (Hom_cat C A D)
+      (@comp_fapp0 C A t D (@preadditive_hom_zero C S t D)
+        (@terminal_arrow_fapp0 C t T A))
+      (@comp_fapp0 C A B D (@computational_chain_pair_d C S A B D pair)
+        (@computational_chain_pair_dnext C S A B D pair)))
+≔ @path_to_hom (Hom_cat C A D) _ _
+    (@eq_trans (Hom C A D) _ _ _
+      (@preadditive_comp_zero_left_path C S A t D
+        (@terminal_arrow_fapp0 C t T A))
+      (@eq_sym _ _ _ (@computational_chain_pair_path C S A B D pair)));
+
+symbol direct_chain_zero_square
+  [C : Cat] (S : τ (@PreadditiveCategory C))
+  [t : τ (Obj C)] (T : τ (@TerminalObject C t))
+  [A B D : τ (Obj C)] (pair : τ (@ComputationalChainPair C S A B D))
+≔ @lax_square C A B t D
+    (@terminal_arrow_fapp0 C t T A)
+    (@computational_chain_pair_d C S A B D pair)
+    (@computational_chain_pair_dnext C S A B D pair)
+    (@preadditive_hom_zero C S t D)
+    (@direct_chain_zero_cell C S t T A B D pair);
+
+// This is an actual transformation, supplied by the existing whole functor.
+symbol direct_chain_zero_transf
+  [C : Cat] (S : τ (@PreadditiveCategory C))
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] (T : τ (@TerminalObject C t))
+  [A B D : τ (Obj C)] (pair : τ (@ComputationalChainPair C S A B D))
+  : τ (@Transf WalkingArrow_cat C
+      (@walking_arrow_func C A t (@terminal_arrow_fapp0 C t T A))
+      (@chain_pair_outgoing_diagram C S A B D pair))
+≔ @fapp1_fapp0 (@LaxArrow_cat C) (Functor_cat WalkingArrow_cat C)
+    (@one_cat_arrow_diagram_func C C1)
+    (@lax_edge C A t (@terminal_arrow_fapp0 C t T A))
+    (@lax_edge C B D (@computational_chain_pair_d C S A B D pair))
+    (@direct_chain_zero_square C S t T A B D pair);
+
+// Forming this native complex needs no kernel/cokernel capability.
+symbol one_cat_chain_pair_zero_cone
+  [C : Cat] (S : τ (@PreadditiveCategory C))
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] (T : τ (@TerminalObject C t))
+  [A B D : τ (Obj C)] (pair : τ (@ComputationalChainPair C S A B D))
+  : τ (Obj (@ZeroArrowCone_cat C t T))
