assertnot [A K : Cat] (F : τ (Functor A K)) (E D : τ (Catd K))
 (FF : τ (@Functord K E D))
 (t : τ (@Transf (@Sigma_cat A (@Pullback_catd A K E F)) (@Sigma_cat K D)
   (@comma_basechange_sigma_basechange_left A K F E D FF) (@comma_basechange_sigma_basechange_right A K F E D FF)))
 (a : τ (Obj A)) (u : τ (Obj (@Fibre_cat K E (@fapp0 A K F a)))) ⊢
 @tapp0_fapp0 _ _ _ _ (Struct_sigma a u) t
 ≡ @id (@Sigma_cat K D)
   (Struct_sigma (@fapp0 A K F a) (@fapp0 _ _ (@Fibre_func K E D FF (@fapp0 A K F a)) u));

assertnot [A K C : Cat] (H : τ (Functor (Product_cat A C) (Product_cat K C))) ⊢
 @eq_refl (Functor (Product_cat A C) C)
   (@comp_cat_fapp0 (Product_cat A C) (Product_cat K C) C (@Product_projR_func K C) H)
