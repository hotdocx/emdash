+: "${EMDASH_TYPECHECK_TIMEOUT:=90s}"
+: "${EMDASH_LAMBDAPI_WARNINGS:=0}"
+warning_flags=(-w)
+case "$EMDASH_LAMBDAPI_WARNINGS" in
+  1|true|TRUE|yes|YES|on|ON) warning_flags=(); mode=warnings ;;
+  0|false|FALSE|no|NO|off|OFF) mode=quiet ;;
