+// Whole action in the existing groupoidal fixed-vertex pair parameter.
+// This does not yet replace the general raw chain-map adapter.
+symbol one_cat_chain_pair_zero_cone_func
+  [C : Cat] (S : τ (@PreadditiveCategory C))
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] (T : τ (@TerminalObject C t))
