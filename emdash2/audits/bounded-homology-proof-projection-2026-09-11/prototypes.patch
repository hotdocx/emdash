diff --git a/emdash2/tmp/probes/homology_direct_native_input_checks.lp b/emdash2/tmp/probes/homology_direct_native_input_checks.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/homology_direct_native_input_checks.lp
@@ -0,0 +1,35 @@
+/* Original observations; no kernel/cokernel capability is present. */
+require open emdash.tmp.probes.homology_direct_native_input;
+require open emdash.emdash3_2_one_cat_zero_cones;
+
+constant symbol C : Cat;
+constant symbol S : τ (@PreadditiveCategory C);
+constant symbol C1 : τ (IsNCat (cat_succ cat_zero) C);
+constant symbol t : τ (Obj C);
+constant symbol T : τ (@TerminalObject C t);
+constant symbol A : τ (Obj C);
+constant symbol B : τ (Obj C);
+constant symbol D : τ (Obj C);
+constant symbol pair : τ (@ComputationalChainPair C S A B D);
+symbol input ≔ @one_cat_chain_pair_zero_cone C S C1 t T A B D pair;
+symbol incoming ≔ @tapp0_fapp0 _ _ _ _ input
+  (@zero_arrow_cone_universal_transf C C1 t T);
+
+assert ⊢ @fapp0 _ _ (@zero_arrow_cone_first_func C t T) input ≡ A;
+assert ⊢ @fapp0 _ _ (@zero_arrow_cone_diagram_func C t T) input
+  ≡ @chain_pair_outgoing_diagram C S A B D pair;
+assert ⊢ @tapp0_fapp0 WalkingArrow_cat C _ _ walking_arrow_src incoming
+  ≡ @computational_chain_pair_dnext C S A B D pair;
+assert ⊢ @tapp0_fapp0 WalkingArrow_cat C _ _ walking_arrow_tgt incoming
+  ≡ @preadditive_hom_zero C S t D;
+assert ⊢ @fapp1_fapp0 WalkingArrow_cat C
+  (@fapp0 _ _ (@zero_arrow_cone_diagram_func C t T) input)
+  walking_arrow_src walking_arrow_tgt walking_arrow_generator
+  ≡ @computational_chain_pair_d C S A B D pair;
+assert ⊢ @fapp0 _ _ (@one_cat_chain_pair_zero_cone_func C S C1 t T A B D) pair
+  ≡ input;
+
+// The parameter action remains a whole Hom functor, not a capped point rule.
+constant symbol other : τ (@ComputationalChainPair C S A B D);
+type @fapp1_func _ _ (@one_cat_chain_pair_zero_cone_func C S C1 t T A B D)
+  pair other;
