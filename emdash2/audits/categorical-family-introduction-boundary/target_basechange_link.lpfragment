/* UA-4e actual target reindexing link, outside the positive library.
   Append after the graph owner, target_basechange_rules.lpfragment,
   constructor object/source fragment, and target_section_extraction.lpfragment.
   The final equivalence is Vᵒ ≃ q∘Γ. Identifying Vᵒ with D remains open. */


symbol ua4e_sigma_basechange_source [A K : Cat] (F : τ (Functor A K))
 : τ (Functor (@Catd_cat K) Cat_cat)
≔ @comp_cat_fapp0 (@Catd_cat K) (@Catd_cat A) Cat_cat
   (@Sigma_func A) (@Pullback_catd_func A K F);

symbol ua4e_sigma_basechange_left [A K : Cat] (F : τ (Functor A K))
 (E D : τ (Catd K)) (FF : τ (@Functord K E D))
 : τ (Functor (@Sigma_cat A (@Pullback_catd A K E F)) (@Sigma_cat K D))
≔ @comp_cat_fapp0 (@Sigma_cat A (@Pullback_catd A K E F)) (@Sigma_cat K E) (@Sigma_cat K D)
   (@sigma_map_func K E D FF) (@sigma_pullback_total_func A K F E);

symbol ua4e_sigma_basechange_right [A K : Cat] (F : τ (Functor A K))
 (E D : τ (Catd K)) (FF : τ (@Functord K E D))
 : τ (Functor (@Sigma_cat A (@Pullback_catd A K E F)) (@Sigma_cat K D))
≔ @comp_cat_fapp0 (@Sigma_cat A (@Pullback_catd A K E F))
   (@Sigma_cat A (@Pullback_catd A K D F)) (@Sigma_cat K D)
   (@sigma_pullback_total_func A K F D)
   (@sigma_map_func A (@Pullback_catd A K E F) (@Pullback_catd A K D F)
     (@fapp1_fapp0 (@Catd_cat K) (@Catd_cat A) (@Pullback_catd_func A K F) E D FF));

// Whole generic naturality cell, already supplied by the internal graph calculus.
symbol ua4e_sigma_basechange_naturality [A K : Cat] (F : τ (Functor A K))
 (E D : τ (Catd K)) (FF : τ (@Functord K E D))
 : τ (@Transf (@Sigma_cat A (@Pullback_catd A K E F)) (@Sigma_cat K D)
     (@ua4e_sigma_basechange_left A K F E D FF)
     (@ua4e_sigma_basechange_right A K F E D FF))
≔ @gray_transf_standard_cell (@Catd_cat K) Cat_cat
   (@ua4e_sigma_basechange_source A K F) (@Sigma_func K)
   (@sigma_pullback_total_transf A K F) E D FF;

symbol ua4e_sigma_map_composition [K : Cat] (E M D : τ (Catd K))
 (FF : τ (@Functord K E M)) (GG : τ (@Functord K M D))
 : τ (@Transf (@Sigma_cat K E) (@Sigma_cat K D)
   (@comp_cat_fapp0 (@Sigma_cat K E) (@Sigma_cat K M) (@Sigma_cat K D)
     (@sigma_map_func K M D GG) (@sigma_map_func K E M FF))
   (@sigma_map_func K E D (@comp_catd_fapp0 K E M D GG FF)))
≔ @fapp1_compositor (@Catd_cat K) Cat_cat (@Sigma_func K) E M D GG FF;

require open emdash.emdash3_2_one_cat_adjunction_family_views;

symbol ua4e_pre [A B C : Cat] (H : τ (Functor A B))
 (F G : τ (Functor B C)) (t : τ (@Transf B C F G))
 : τ (@Transf A C (@comp_cat_fapp0 A B C F H) (@comp_cat_fapp0 A B C G H))
≔ @fapp0 _ _ (@comp_cat_con_fapp1_func A B C H F G) t;
symbol ua4e_post [A B C : Cat] (H : τ (Functor B C))
 (F G : τ (Functor A B)) (t : τ (@Transf A B F G))
 : τ (@Transf A C (@comp_cat_fapp0 A B C H F) (@comp_cat_fapp0 A B C H G))
≔ @fapp0 _ _ (@comp_cat_cov_fapp1_func A B C H F G) t;

symbol ua4e_reindexed_observation [A K C : Cat] (F : τ (Functor A K)) (E : τ (Catd K))
 (P : τ (@Functord K E (@Const_catd K C)))
 : τ (Functor (@Sigma_cat A (@Pullback_catd A K E F)) (Product_cat A C))
≔ @sigma_map_func A (@Pullback_catd A K E F) (@Const_catd A C)
   (@fapp1_fapp0 (@Catd_cat K) (@Catd_cat A) (@Pullback_catd_func A K F)
     E (@Const_catd K C) P);

symbol ua4e_observation_outer [A K C : Cat] (F : τ (Functor A K)) (E : τ (Catd K))
 (P : τ (@Functord K E (@Const_catd K C)))
 : τ (Functor (@Sigma_cat A (@Pullback_catd A K E F)) C)
≔ @comp_cat_fapp0 (@Sigma_cat A (@Pullback_catd A K E F)) (Product_cat K C) C
   (@Product_projR_func K C) (@ua4e_sigma_basechange_left A K F E (@Const_catd K C) P);

symbol ua4e_observation_inner [A K C : Cat] (F : τ (Functor A K)) (E : τ (Catd K))
 (P : τ (@Functord K E (@Const_catd K C)))
 : τ (Functor (@Sigma_cat A (@Pullback_catd A K E F)) C)
≔ @comp_cat_fapp0 (@Sigma_cat A (@Pullback_catd A K E F)) (Product_cat A C) C
   (@Product_projR_func A C) (@ua4e_reindexed_observation A K C F E P);

symbol ua4e_observation_basechange [A K C : Cat] (F : τ (Functor A K)) (E : τ (Catd K))
 (P : τ (@Functord K E (@Const_catd K C)))
 : τ (@Transf (@Sigma_cat A (@Pullback_catd A K E F)) C
     (@ua4e_observation_outer A K C F E P) (@ua4e_observation_inner A K C F E P))
≔ @ua4e_post (@Sigma_cat A (@Pullback_catd A K E F)) (Product_cat K C) C
     (@Product_projR_func K C)
     (@ua4e_sigma_basechange_left A K F E (@Const_catd K C) P)
     (@ua4e_sigma_basechange_right A K F E (@Const_catd K C) P)
     (@ua4e_sigma_basechange_naturality A K F E (@Const_catd K C) P);

symbol ua4e_observation_basechange_component [A K C : Cat]
 (F : τ (Functor A K)) (E : τ (Catd K)) (P : τ (@Functord K E (@Const_catd K C)))
 (a : τ (Obj A)) (u : τ (Obj (@Fibre_cat K E (@fapp0 A K F a))))
 : τ (Hom C
   (@fapp0 (@Fibre_cat K E (@fapp0 A K F a)) C (@Fibre_func K E (@Const_catd K C) P (@fapp0 A K F a)) u)
   (@fapp0 (@Fibre_cat K E (@fapp0 A K F a)) C (@Fibre_func K E (@Const_catd K C) P (@fapp0 A K F a)) u))
≔ @tapp0_fapp0 (@Sigma_cat A (@Pullback_catd A K E F)) C
   (@ua4e_observation_outer A K C F E P) (@ua4e_observation_inner A K C F E P)
   (Struct_sigma a u) (@ua4e_observation_basechange A K C F E P);

assert [A K C : Cat] (F : τ (Functor A K)) (E : τ (Catd K))
 (P : τ (@Functord K E (@Const_catd K C)))
 (a : τ (Obj A)) (u : τ (Obj (@Fibre_cat K E (@fapp0 A K F a)))) ⊢
 @ua4e_observation_basechange_component A K C F E P a u
 ≡ @id C (@fapp0 (@Fibre_cat K E (@fapp0 A K F a)) C
     (@Fibre_func K E (@Const_catd K C) P (@fapp0 A K F a)) u);

// The actual q∘Γ before its outer Op; the original family reframe is retained.
symbol ua4e_gamma_target_raw0 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K
  Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor (Op_cat K) (Op_cat Y))
≔ @comp_cat_fapp0 (Op_cat K) (@Sigma_cat (Op_cat X) (@homdc_op_edge_catd X Y (@represented_comma_prof X Y
  J))) (Op_cat Y)
   (@homdc_total_target_underlying_func X Y (@represented_comma_prof X Y J))
   (@comp_cat_fapp0 (Op_cat K) (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y J)) (@Sigma_cat
     (Op_cat X) (@homdc_op_edge_catd X Y (@represented_comma_prof X Y J))) (@sigma_map_func (Op_cat X)
     (@represented_comma_family_catd X Y J) (@homdc_op_edge_catd X Y (@represented_comma_prof X Y J))
     (@represented_comma_family_reframe X Y J)) (@represented_comma_family_underlying_func K X Y J A D h));

symbol ua4e_gamma_target_raw1 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K
  Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor (Op_cat K) (Op_cat Y))
≔ @comp_cat_fapp0 (Op_cat K) (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A)) (Op_cat Y)
   (@ua4e_observation_outer (Op_cat K) (Op_cat X) (Op_cat Y) (@Op_func K X A)
     (@represented_comma_family_catd X Y J) (@ua4d_gamma_target_family_map X Y J)) (@section_total_func
     (Op_cat K) (@represented_comma_family_target K X Y J A) (@represented_comma_family_section K X Y J A D
     h));

symbol ua4e_gamma_target_raw2 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K
  Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor (Op_cat K) (Op_cat Y))
≔ @ua4d_section_observed (Op_cat K) (Op_cat Y) (@represented_comma_family_target K X Y J A)
   (@ua4d_gamma_target_section_map K X Y J A)
   (@represented_comma_family_section K X Y J A D h);

symbol ua4e_gamma_target_step1 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K
  Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (@Transf (Op_cat K) (Op_cat Y)
  (@ua4e_gamma_target_raw0 K X Y J A D h) (@ua4e_gamma_target_raw1 K X Y J A D h))
≔ @ua4e_post (Op_cat K) (Product_cat (Op_cat X) (Op_cat Y)) (Op_cat Y) (@Product_projR_func (Op_cat X)
  (Op_cat Y)) (@comp_cat_fapp0 (Op_cat K) (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y J))
  (Product_cat (Op_cat X) (Op_cat Y)) (@comp_cat_fapp0 (@Sigma_cat (Op_cat X)
  (@represented_comma_family_catd X Y J)) (@Sigma_cat (Op_cat X) (@homdc_op_edge_catd X Y
  (@represented_comma_prof X Y J))) (Product_cat (Op_cat X) (Op_cat Y)) (@sigma_map_func (Op_cat X)
  (@homdc_op_edge_catd X Y (@represented_comma_prof X Y J)) (@Const_catd (Op_cat X) (Op_cat Y))
  (@homdc_total_target_funcd X Y (@represented_comma_prof X Y J))) (@sigma_map_func (Op_cat X)
  (@represented_comma_family_catd X Y J) (@homdc_op_edge_catd X Y (@represented_comma_prof X Y J))
  (@represented_comma_family_reframe X Y J))) (@represented_comma_family_underlying_func K X Y J A D h))
  (@comp_cat_fapp0 (Op_cat K) (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y J)) (Product_cat
  (Op_cat X) (Op_cat Y)) (@sigma_map_func (Op_cat X) (@represented_comma_family_catd X Y J) (@Const_catd
  (Op_cat X) (Op_cat Y)) (@ua4d_gamma_target_family_map X Y J)) (@represented_comma_family_underlying_func K
  X Y J A D h))
   (@ua4e_pre (Op_cat K) (@Sigma_cat (Op_cat X) (@represented_comma_family_catd X Y J)) (Product_cat (Op_cat
     X) (Op_cat Y)) (@represented_comma_family_underlying_func K X Y J A D h) (@comp_cat_fapp0 (@Sigma_cat
     (Op_cat X) (@represented_comma_family_catd X Y J)) (@Sigma_cat (Op_cat X) (@homdc_op_edge_catd X Y
     (@represented_comma_prof X Y J))) (Product_cat (Op_cat X) (Op_cat Y)) (@sigma_map_func (Op_cat X)
     (@homdc_op_edge_catd X Y (@represented_comma_prof X Y J)) (@Const_catd (Op_cat X) (Op_cat Y))
     (@homdc_total_target_funcd X Y (@represented_comma_prof X Y J))) (@sigma_map_func (Op_cat X)
     (@represented_comma_family_catd X Y J) (@homdc_op_edge_catd X Y (@represented_comma_prof X Y J))
     (@represented_comma_family_reframe X Y J))) (@sigma_map_func (Op_cat X) (@represented_comma_family_catd
     X Y J) (@Const_catd (Op_cat X) (Op_cat Y)) (@ua4d_gamma_target_family_map X Y J))
     (@ua4e_sigma_map_composition (Op_cat X) (@represented_comma_family_catd X Y J) (@homdc_op_edge_catd X Y
     (@represented_comma_prof X Y J)) (@Const_catd (Op_cat X) (Op_cat Y)) (@represented_comma_family_reframe
     X Y J) (@homdc_total_target_funcd X Y (@represented_comma_prof X Y J))));

symbol ua4e_gamma_target_step2 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K
  Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (@Transf (Op_cat K) (Op_cat Y)
  (@ua4e_gamma_target_raw1 K X Y J A D h) (@ua4e_gamma_target_raw2 K X Y J A D h))
≔ @ua4e_pre (Op_cat K) (@Sigma_cat (Op_cat K) (@represented_comma_family_target K X Y J A)) (Op_cat Y)
  (@section_total_func (Op_cat K) (@represented_comma_family_target K X Y J A)
  (@represented_comma_family_section K X Y J A D h))
   (@ua4e_observation_outer (Op_cat K) (Op_cat X) (Op_cat Y) (@Op_func K X A)
     (@represented_comma_family_catd X Y J) (@ua4d_gamma_target_family_map X Y J))
   (@ua4e_observation_inner (Op_cat K) (Op_cat X) (Op_cat Y) (@Op_func K X A)
     (@represented_comma_family_catd X Y J) (@ua4d_gamma_target_family_map X Y J))
   (@ua4e_observation_basechange (Op_cat K) (Op_cat X) (Op_cat Y) (@Op_func K X A)
     (@represented_comma_family_catd X Y J) (@ua4d_gamma_target_family_map X Y J));

symbol ua4e_gamma_target_raw_link [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor
  K Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (@Transf (Op_cat K) (Op_cat Y)
  (@ua4e_gamma_target_raw0 K X Y J A D h) (@ua4e_gamma_target_raw2 K X Y J A D h))
≔ @comp_fapp0 (Functor_cat (Op_cat K) (Op_cat Y)) (@ua4e_gamma_target_raw0 K X Y J A D h)
  (@ua4e_gamma_target_raw1 K X Y J A D h) (@ua4e_gamma_target_raw2 K X Y J A D h)
   (@ua4e_gamma_target_step2 K X Y J A D h) (@ua4e_gamma_target_step1 K X Y J A D h);

symbol ua4e_gamma_target_func [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K
  Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor K Y)
≔ @comp_cat_fapp0 K (@RepresentedComma_cat X Y J) Y
   (@represented_comma_target_func X Y J) (@represented_comma_family_func K X Y J A D h);

symbol ua4e_gamma_target_link [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K
  Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D))
 : τ (@Transf K Y (@ua4d_gamma_target_observed_op K X Y J A D h)
     (@ua4e_gamma_target_func K X Y J A D h))
≔ @Op_transf (Op_cat K) (Op_cat Y) (@ua4e_gamma_target_raw0 K X Y J A D h) (@ua4e_gamma_target_raw2 K X Y J
  A D h) (@ua4e_gamma_target_raw_link K X Y J A D h);

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) (x : τ (Obj K)) ⊢
 @tapp0_fapp0 K Y (@ua4d_gamma_target_observed_op K X Y J A D h)
   (@ua4e_gamma_target_func K X Y J A D h) x (@ua4e_gamma_target_link K X Y J A D h)
 ≡ @id Y (@fapp0 K Y D x);

// Inverse assembly for the actual q∘Γ link, with the original ordinary guard.
symbol ua4e_gamma_target_link_equiv [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ
  (Functor K Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) (Y1 : τ (IsNCat (cat_succ cat_zero) Y))
 : τ (@OmegaEquivAlong (Functor_cat K Y) (@ua4d_gamma_target_observed_op K X Y J A D h)
   (@ua4e_gamma_target_func K X Y J A D h) (@ua4e_gamma_target_link K X Y J A D h))
≔ @strict_transf_pointwise_omega_along K Y (@ua4d_gamma_target_observed_op K X Y J A D h)
  (@ua4e_gamma_target_func K X Y J A D h) (@ua4e_gamma_target_link K X Y J A D h)
   (λ x : τ (Obj K), @omega_equiv_along_refl Y (@fapp0 K Y D x));

symbol ua4e_gamma_target_section_to_native [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ
  (Functor K Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (@Transf K Y
  (@ua4d_gamma_target_section_op K X Y J A D h) (@ua4e_gamma_target_func K X Y J A D h))
≔ @comp_fapp0 (Functor_cat K Y) (@ua4d_gamma_target_section_op K X Y J A D h)
  (@ua4d_gamma_target_observed_op K X Y J A D h) (@ua4e_gamma_target_func K X Y J A D h)
  (@ua4e_gamma_target_link K X Y J A D h) (@ua4d_gamma_target_extraction_op K X Y J A D h);

symbol ua4e_gamma_target_section_to_native_equiv [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X))
  (D : τ (Functor K Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) (Y1 : τ (IsNCat (cat_succ
  cat_zero) Y))
 : τ (@OmegaEquivAlong (Functor_cat K Y) (@ua4d_gamma_target_section_op K X Y J A D h)
   (@ua4e_gamma_target_func K X Y J A D h)
     (@ua4e_gamma_target_section_to_native K X Y J A D h))
≔ @omega_equiv_along_comp (Functor_cat K Y) (@ua4d_gamma_target_section_op K X Y J A D h)
  (@ua4d_gamma_target_observed_op K X Y J A D h) (@ua4e_gamma_target_func K X Y J A D h)
  (@ua4d_gamma_target_extraction_op K X Y J A D h) (@ua4e_gamma_target_link K X Y J A D h)
  (@ua4d_gamma_target_extraction_equiv K X Y J A D h Y1) (@ua4e_gamma_target_link_equiv K X Y J A D h Y1);

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) (x : τ (Obj K)) ⊢
 @tapp0_fapp0 K Y (@ua4d_gamma_target_section_op K X Y J A D h) (@ua4e_gamma_target_func K X Y J A D h) x
   (@ua4e_gamma_target_section_to_native K X Y J A D h)
 ≡ @id Y (@fapp0 K Y D x);

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) (Y1 : τ (IsNCat (cat_succ cat_zero) Y)) (x : τ (Obj K)) ⊢
 @tapp0_fapp0 K Y (@ua4e_gamma_target_func K X Y J A D h) (@ua4d_gamma_target_section_op K X Y J A D h) x
   (@omega_equiv_along_left_inv _ _ _ _
     (@ua4e_gamma_target_section_to_native_equiv K X Y J A D h Y1))
 ≡ @id Y (@fapp0 K Y D x);

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) (Y1 : τ (IsNCat (cat_succ cat_zero) Y)) (x : τ (Obj K)) ⊢
 @tapp0_fapp0 K Y (@ua4e_gamma_target_func K X Y J A D h) (@ua4d_gamma_target_section_op K X Y J A D h) x
   (@omega_equiv_along_right_inv _ _ _ _
     (@ua4e_gamma_target_section_to_native_equiv K X Y J A D h Y1))
 ≡ @id Y (@fapp0 K Y D x);

// Laws of the composed native equivalence, retaining the original inverse data.
assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) (Y1 : τ (IsNCat (cat_succ cat_zero) Y)) ⊢ @omega_equiv_along_left_law
  (Functor_cat K Y) (@ua4d_gamma_target_section_op K X Y J A D h) (@ua4e_gamma_target_func K X Y J A D h)
  (@ua4e_gamma_target_section_to_native K X Y J A D h) (@ua4e_gamma_target_section_to_native_equiv K X Y J A
  D h Y1)
 : τ (@= (Hom (Functor_cat K Y) (@ua4d_gamma_target_section_op K X Y J A D h) (@ua4d_gamma_target_section_op
   K X Y J A D h))
   (@comp_fapp0 (Functor_cat K Y) (@ua4d_gamma_target_section_op K X Y J A D h) (@ua4e_gamma_target_func K X
     Y J A D h) (@ua4d_gamma_target_section_op K X Y J A D h) (@omega_equiv_along_left_inv (Functor_cat K Y)
     (@ua4d_gamma_target_section_op K X Y J A D h) (@ua4e_gamma_target_func K X Y J A D h)
     (@ua4e_gamma_target_section_to_native K X Y J A D h) (@ua4e_gamma_target_section_to_native_equiv K X Y
     J A D h Y1)) (@ua4e_gamma_target_section_to_native K X Y J A D h))
   (@id (Functor_cat K Y) (@ua4d_gamma_target_section_op K X Y J A D h)));
assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) (Y1 : τ (IsNCat (cat_succ cat_zero) Y)) ⊢ @omega_equiv_along_right_law
  (Functor_cat K Y) (@ua4d_gamma_target_section_op K X Y J A D h) (@ua4e_gamma_target_func K X Y J A D h)
  (@ua4e_gamma_target_section_to_native K X Y J A D h) (@ua4e_gamma_target_section_to_native_equiv K X Y J A
  D h Y1)
 : τ (@= (Hom (Functor_cat K Y) (@ua4e_gamma_target_func K X Y J A D h) (@ua4e_gamma_target_func K X Y J A D
   h))
   (@comp_fapp0 (Functor_cat K Y) (@ua4e_gamma_target_func K X Y J A D h) (@ua4d_gamma_target_section_op K X
     Y J A D h) (@ua4e_gamma_target_func K X Y J A D h) (@ua4e_gamma_target_section_to_native K X Y J A D h)
     (@omega_equiv_along_right_inv (Functor_cat K Y) (@ua4d_gamma_target_section_op K X Y J A D h)
     (@ua4e_gamma_target_func K X Y J A D h) (@ua4e_gamma_target_section_to_native K X Y J A D h)
     (@ua4e_gamma_target_section_to_native_equiv K X Y J A D h Y1)))
   (@id (Functor_cat K Y) (@ua4e_gamma_target_func K X Y J A D h)));

// Owner-position positive consumer and the existing identity evaluation order.
assert [A K : Cat] (F : τ (Functor A K)) (E D : τ (Catd K))
 (FF : τ (@Functord K E D)) (a : τ (Obj A))
 (u : τ (Obj (@Fibre_cat K E (@fapp0 A K F a)))) ⊢
 @fapp0 _ _ (@tapp1_fapp0 (@Catd_cat K) Cat_cat
   (@comp_cat_fapp0 (@Catd_cat K) (@Catd_cat A) Cat_cat (@Sigma_func A) (@Pullback_catd_func A K F))
   (@Sigma_func K) E D (@sigma_pullback_total_transf A K F) FF) (Struct_sigma a u)
 ≡ @Struct_sigma (Obj K) (λ k : τ (Obj K), Obj (@Fibre_cat K D k))
     (@fapp0 A K F a) (@fapp0 _ _ (@Fibre_func K E D FF (@fapp0 A K F a)) u);

assert [A K : Cat] (F : τ (Functor A K)) (E : τ (Catd K))
 (a : τ (Obj A)) (u : τ (Obj (@Fibre_cat K E (@fapp0 A K F a)))) ⊢
 @fapp0 _ _ (@tapp1_fapp0 (@Catd_cat K) Cat_cat
   (@comp_cat_fapp0 (@Catd_cat K) (@Catd_cat A) Cat_cat (@Sigma_func A) (@Pullback_catd_func A K F))
   (@Sigma_func K) E E (@sigma_pullback_total_transf A K F) (@id_funcd K E)) (Struct_sigma a u)
 ≡ @Struct_sigma (Obj K) (λ k : τ (Obj K), Obj (@Fibre_cat K E k)) (@fapp0 A K F a) u;

// The contextual congruence requires the outer functors to compare too.
assertnot [A B C : Cat] (F G : τ (Functor B C)) (H : τ (Functor A B)) ⊢
 @eq_refl (Functor A C) (@comp_cat_fapp0 A B C F H)
 : τ (@= (Functor A C) (@comp_cat_fapp0 A B C F H) (@comp_cat_fapp0 A B C G H));

// Constant-total projection view and preserved runtime boundary.
assert [A K C : Cat] (F : τ (Functor A K)) ⊢
 @eq_refl (Functor (Product_cat A C) C)
   (@comp_cat_fapp0 (Product_cat A C) (Product_cat K C) C (@Product_projR_func K C)
     (@sigma_pullback_total_func A K F (@Const_catd K C)))
 : τ (@= (Functor (Product_cat A C) C)
   (@comp_cat_fapp0 (Product_cat A C) (Product_cat K C) C (@Product_projR_func K C)
     (@sigma_pullback_total_func A K F (@Const_catd K C))) (@Product_projR_func A C));
assertnot [A K C : Cat] (F : τ (Functor A K)) ⊢
 @comp_cat_fapp0 (Product_cat A C) (Product_cat K C) C (@Product_projR_func K C)
   (@sigma_pullback_total_func A K F (@Const_catd K C))
 ≡ @Product_projR_func A C;

// A supplied transformation between the same endpoints is not made canonical.
assertnot [A K : Cat] (F : τ (Functor A K)) (E D : τ (Catd K))
 (FF : τ (@Functord K E D))
 (t : τ (@Transf (@Sigma_cat A (@Pullback_catd A K E F)) (@Sigma_cat K D)
   (@ua4e_sigma_basechange_left A K F E D FF) (@ua4e_sigma_basechange_right A K F E D FF)))
 (a : τ (Obj A)) (u : τ (Obj (@Fibre_cat K E (@fapp0 A K F a)))) ⊢
 @tapp0_fapp0 _ _ _ _ (Struct_sigma a u) t
 ≡ @id (@Sigma_cat K D)
   (Struct_sigma (@fapp0 A K F a) (@fapp0 _ _ (@Fibre_func K E D FF (@fapp0 A K F a)) u));

assertnot [A K C : Cat] (H : τ (Functor (Product_cat A C) (Product_cat K C))) ⊢
 @eq_refl (Functor (Product_cat A C) C)
   (@comp_cat_fapp0 (Product_cat A C) (Product_cat K C) C (@Product_projR_func K C) H)
 : τ (@= (Functor (Product_cat A C) C)
   (@comp_cat_fapp0 (Product_cat A C) (Product_cat K C) C (@Product_projR_func K C) H)
   (@Product_projR_func A C));
