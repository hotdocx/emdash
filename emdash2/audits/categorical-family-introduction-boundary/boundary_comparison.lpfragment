/* UA-4i: actual whole boundary map and its retained inverse.
   Derived from the original P/unit, whole source/target comparisons and the
   public ordinary modification introduction. No new primitive or rule. */

symbol ua4i_native_boundary [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (@Transf B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P
  (@ua4h_target B C C1 t T A D h)))
≔ @transf_prewhisker B (@ZeroArrowCone_cat C t T) C (@ua4h_gamma B C C1 t T A D h)
  (@zero_arrow_cone_first_func C t T) (@kernel_adjunction_family_func (@ZeroArrowCone_cat C t T) C S t T P
  (@zero_arrow_cone_diagram_func C t T))
  (@kernel_adjunction_family_boundary_transf (@ZeroArrowCone_cat C t T) C S t T P
    (@zero_arrow_cone_first_func C t T) (@zero_arrow_cone_diagram_func C t T)
    (@zero_arrow_cone_universal_transf C C1 t T));

symbol ua4i_family_boundary [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (@Transf B C A (@kernel_adjunction_family_func B C S t T P D))
≔ @kernel_adjunction_family_boundary_transf B C S t T P A D h;

symbol ua4i_kernel_target_to [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (@Transf B C (@kernel_adjunction_family_func B C S t T P (@ua4h_target B C C1 t T A D h))
  (@kernel_adjunction_family_func B C S t T P D))
≔ @transf_postwhisker B (Functor_cat WalkingArrow_cat C) C (@kernel_adjunction_func C S t T P) (@ua4h_target B C C1
  t T A D h) D (@ua4h_target_to B C C1 t T A D h);

symbol ua4i_boundary_left [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (@Transf B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D))
≔ @comp_fapp0 (Functor_cat B C) (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T
  P (@ua4h_target B C C1 t T A D h)) (@kernel_adjunction_family_func B C S t T P D)
  (@ua4i_kernel_target_to B C C1 t T A D h S P) (@ua4i_native_boundary B C C1 t T A D h S P);

symbol ua4i_boundary_right [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (@Transf B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D))
≔ @comp_fapp0 (Functor_cat B C) (@ua4h_source B C C1 t T A D h) A (@kernel_adjunction_family_func B C S t
  T P D)
  (@ua4i_family_boundary B C C1 t T A D h S P) (@ua4h_source_to B C C1 t T A D h);


symbol ua4i_boundary_left_point_path [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T)) (x : τ (Obj B))
 : τ (@= (Hom C (@fapp0 B C A x) (@fapp0 B C (@kernel_adjunction_family_func B C S t T P D) x))
     (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D) x
  (@ua4i_boundary_left B C C1 t T A D h S P))
     (@tapp0_fapp0 B C A (@kernel_adjunction_family_func B C S t T P D) x (@ua4i_family_boundary B C C1 t
  T A D h S P)))
≔ @one_cat_transf_identity_path (@ZeroArrowCone_cat C t T) C C1 (@zero_arrow_cone_first_func C t T)
  (@kernel_adjunction_family_func (@ZeroArrowCone_cat C t T) C S t T P (@zero_arrow_cone_diagram_func C t
  T)) (@kernel_adjunction_family_boundary_transf (@ZeroArrowCone_cat C t T) C S t T P
  (@zero_arrow_cone_first_func C t T) (@zero_arrow_cone_diagram_func C t T)
  (@zero_arrow_cone_universal_transf C C1 t T))
   (@fapp0 B (@ZeroArrowCone_cat C t T) (@ua4h_gamma B C C1 t T A D h) x);

symbol ua4i_boundary_to [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (Hom (@Transf_cat B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D))
  (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_right B C C1 t T A D h S P))
≔ @one_cat_modification B C C1 (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S
  t T P D) (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_right B C C1 t T A D h S P)
   (λ x : τ (Obj B), @path_to_hom (Hom_cat C (@fapp0 B C A x) (@fapp0 B C (@kernel_adjunction_family_func
  B C S t T P D) x)) (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C
  S t T P D) x (@ua4i_boundary_left B C C1 t T A D h S P)) (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D
  h) (@kernel_adjunction_family_func B C S t T P D) x (@ua4i_boundary_right B C C1 t T A D h S P))
  (@ua4i_boundary_left_point_path B C C1 t T A D h S P x));

assert [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T)) (x : τ (Obj B)) ⊢
 @tapp0_hom_fapp0 B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D)
  (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_right B C C1 t T A D h S P) x
  (@ua4i_boundary_to B C C1 t T A D h S P)
 ≡ @path_to_hom (Hom_cat C (@fapp0 B C A x) (@fapp0 B C (@kernel_adjunction_family_func B C S t T P D) x))
  (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D) x
  (@ua4i_boundary_left B C C1 t T A D h S P)) (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D) x (@ua4i_boundary_right B C C1 t T A D h S P))
  (@ua4i_boundary_left_point_path B C C1 t T A D h S P x);

symbol ua4i_boundary_from [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (Hom (@Transf_cat B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D))
  (@ua4i_boundary_right B C C1 t T A D h S P) (@ua4i_boundary_left B C C1 t T A D h S P))
≔ @one_cat_modification B C C1 (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S
  t T P D) (@ua4i_boundary_right B C C1 t T A D h S P) (@ua4i_boundary_left B C C1 t T A D h S P)
   (λ x : τ (Obj B), @path_to_hom (Hom_cat C (@fapp0 B C A x) (@fapp0 B C (@kernel_adjunction_family_func
  B C S t T P D) x)) (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C
  S t T P D) x (@ua4i_boundary_right B C C1 t T A D h S P)) (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D
  h) (@kernel_adjunction_family_func B C S t T P D) x (@ua4i_boundary_left B C C1 t T A D h S P)) (@eq_sym
  (Obj (Hom_cat C (@fapp0 B C A x) (@fapp0 B C (@kernel_adjunction_family_func B C S t T P D) x)))
  (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D) x
  (@ua4i_boundary_left B C C1 t T A D h S P)) (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D) x (@ua4i_boundary_right B C C1 t T A D h S P))
  (@ua4i_boundary_left_point_path B C C1 t T A D h S P x)));

assert [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T)) (x : τ (Obj B)) ⊢
 @tapp0_hom_fapp0 B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D)
  (@ua4i_boundary_right B C C1 t T A D h S P) (@ua4i_boundary_left B C C1 t T A D h S P) x
  (@ua4i_boundary_from B C C1 t T A D h S P)
 ≡ @path_to_hom (Hom_cat C (@fapp0 B C A x) (@fapp0 B C (@kernel_adjunction_family_func B C S t T P D) x))
  (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D) x
  (@ua4i_boundary_right B C C1 t T A D h S P)) (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D) x (@ua4i_boundary_left B C C1 t T A D h S P)) (@eq_sym
  (Obj (Hom_cat C (@fapp0 B C A x) (@fapp0 B C (@kernel_adjunction_family_func B C S t T P D) x)))
  (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D) x
  (@ua4i_boundary_left B C C1 t T A D h S P)) (@tapp0_fapp0 B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D) x (@ua4i_boundary_right B C C1 t T A D h S P))
  (@ua4i_boundary_left_point_path B C C1 t T A D h S P x));

symbol ua4i_boundary_left_law [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (@= (Hom (@Transf_cat B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P
  D)) (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_left B C C1 t T A D h S P)) (@comp_fapp0
  (@Transf_cat B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D))
  (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_right B C C1 t T A D h S P)
  (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_from B C C1 t T A D h S P) (@ua4i_boundary_to
  B C C1 t T A D h S P)) (@id (@Transf_cat B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_left B C C1 t T A D h S P)))
≔ @is_contr_center (@= (Hom (@Transf_cat B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_left B C C1 t T A D h S P)
  (@ua4i_boundary_left B C C1 t T A D h S P)) (@comp_fapp0 (@Transf_cat B C (@ua4h_source B C C1 t T A D
  h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_left B C C1 t T A D h S P)
  (@ua4i_boundary_right B C C1 t T A D h S P) (@ua4i_boundary_left B C C1 t T A D h S P)
  (@ua4i_boundary_from B C C1 t T A D h S P) (@ua4i_boundary_to B C C1 t T A D h S P)) (@id (@Transf_cat B
  C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_left B
  C C1 t T A D h S P))) ((@discrete_hom_is_prop (@Transf_cat B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D)) ((@one_cat_functor_category B C C1) (@ua4h_source B C C1
  t T A D h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_left B C C1 t T A D h S P)
  (@ua4i_boundary_left B C C1 t T A D h S P)) (@comp_fapp0 (@Transf_cat B C (@ua4h_source B C C1 t T A D
  h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_left B C C1 t T A D h S P)
  (@ua4i_boundary_right B C C1 t T A D h S P) (@ua4i_boundary_left B C C1 t T A D h S P)
  (@ua4i_boundary_from B C C1 t T A D h S P) (@ua4i_boundary_to B C C1 t T A D h S P)) (@id (@Transf_cat B
  C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_left B
  C C1 t T A D h S P)));

symbol ua4i_boundary_right_law [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (@= (Hom (@Transf_cat B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P
  D)) (@ua4i_boundary_right B C C1 t T A D h S P) (@ua4i_boundary_right B C C1 t T A D h S P))
  (@comp_fapp0 (@Transf_cat B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T
  P D)) (@ua4i_boundary_right B C C1 t T A D h S P) (@ua4i_boundary_left B C C1 t T A D h S P)
  (@ua4i_boundary_right B C C1 t T A D h S P) (@ua4i_boundary_to B C C1 t T A D h S P)
  (@ua4i_boundary_from B C C1 t T A D h S P)) (@id (@Transf_cat B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_right B C C1 t T A D h S P)))
≔ @is_contr_center (@= (Hom (@Transf_cat B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_right B C C1 t T A D h S P)
  (@ua4i_boundary_right B C C1 t T A D h S P)) (@comp_fapp0 (@Transf_cat B C (@ua4h_source B C C1 t T A D
  h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_right B C C1 t T A D h S P)
  (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_right B C C1 t T A D h S P)
  (@ua4i_boundary_to B C C1 t T A D h S P) (@ua4i_boundary_from B C C1 t T A D h S P)) (@id (@Transf_cat B
  C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_right
  B C C1 t T A D h S P))) ((@discrete_hom_is_prop (@Transf_cat B C (@ua4h_source B C C1 t T A D h)
  (@kernel_adjunction_family_func B C S t T P D)) ((@one_cat_functor_category B C C1) (@ua4h_source B C C1
  t T A D h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_right B C C1 t T A D h S P)
  (@ua4i_boundary_right B C C1 t T A D h S P)) (@comp_fapp0 (@Transf_cat B C (@ua4h_source B C C1 t T A D
  h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_right B C C1 t T A D h S P)
  (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_right B C C1 t T A D h S P)
  (@ua4i_boundary_to B C C1 t T A D h S P) (@ua4i_boundary_from B C C1 t T A D h S P)) (@id (@Transf_cat B
  C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t T P D)) (@ua4i_boundary_right
  B C C1 t T A D h S P)));

symbol ua4i_boundary_evidence [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (IsoEvidence (@Transf_cat B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C S t
  T P D)) (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_right B C C1 t T A D h S P))
≔ @iso_evidence_intro (@Transf_cat B C (@ua4h_source B C C1 t T A D h) (@kernel_adjunction_family_func B C
  S t T P D)) (@ua4i_boundary_left B C C1 t T A D h S P) (@ua4i_boundary_right B C C1 t T A D h S P)
  (@ua4i_boundary_to B C C1 t T A D h S P) (@ua4i_boundary_from B C C1 t T A D h S P)
   (@ua4i_boundary_left_law B C C1 t T A D h S P) (@ua4i_boundary_right_law B C C1 t T A D h S P);

require open emdash.emdash3_2_one_cat_arrow_diagrams;

symbol ua4i_boundary_diagram_to [B C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
 (t : τ (Obj C)) (T : τ (@TerminalObject C t)) (A : τ (Functor B C))
 (D : τ (Functor B (Functor_cat WalkingArrow_cat C)))
 (h : τ (@Transf B (Functor_cat WalkingArrow_cat C)
   (@comp_cat_fapp0 B C (Functor_cat WalkingArrow_cat C)
     (@terminal_arrow_diagram_func C t T) A) D))
 (S : τ (@PreadditiveCategory C)) (P : τ (@KernelAdjunctionStructure C S t T))
 : τ (@Transf B (Functor_cat WalkingArrow_cat C) (@transf_arrow_diagram_func B C (@ua4h_source B C C1 t T
  A D h) (@kernel_adjunction_family_func B C S t T P (@ua4h_target B C C1 t T A D h))
  (@ua4i_native_boundary B C C1 t T A D h S P)) (@kernel_adjunction_family_boundary_diagram_func B C S t T
  P A D h))
≔ @sym_func_func_transf WalkingArrow_cat B C
