+/* Finite result tails with one annotation on each adjacent arrow pair.
+   This reuses Nat/Sigma recursion, not a new complex category or homology.
+   n is the number of additional arrows after the fixed incoming arrow. */
+require open emdash.emdash3_2_nat_arithmetic;
+
+symbol FiniteArrowTail [C : Cat] (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C), τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  (n : τ Nat_grpd) (A B : τ (Obj C)) (f : τ (Hom C A B)) : Grpd
+≔ (@nat_elim
+    (λ _ : τ Nat_grpd,
+      @Pi_grpd (Obj C) (λ A0 : τ (Obj C),
+        @Pi_grpd (Obj C) (λ B0 : τ (Obj C),
+          @Function_grpd (Hom C A0 B0) Grpd_grpd)))
+    (λ A0 : τ (Obj C), λ B0 : τ (Obj C), λ _ : τ (Hom C A0 B0), Unit_grpd)
+    (λ n0 : τ Nat_grpd, λ rec : τ _,
+      λ A0 : τ (Obj C), λ B0 : τ (Obj C), λ f0 : τ (Hom C A0 B0),
+        @Σ_ (Obj C) (λ D0 : τ (Obj C),
+          @Σ_ (Hom C B0 D0) (λ g0 : τ (Hom C B0 D0),
+            @Product_grpd (Q A0 B0 D0 f0 g0) (rec B0 D0 g0))))
+    n) A B f;
+
+symbol finite_arrow_tail_nil [C : Cat] (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C), τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  : τ (@FiniteArrowTail C Q zero A B f)
+≔ tt;
+
+symbol finite_arrow_tail_cons [C : Cat] (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C), τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  [n : τ Nat_grpd] [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (D : τ (Obj C)) (g : τ (Hom C B D)) (step : τ (Q A B D f g))
+  (rest : τ (@FiniteArrowTail C Q n B D g))
+  : τ (@FiniteArrowTail C Q (succ n) A B f)
+≔ @Struct_sigma (Obj C) (λ D0 : τ (Obj C),
+    @Σ_ (Hom C B D0) (λ g0 : τ (Hom C B D0),
+      @Product_grpd (Q A B D0 f g0) (@FiniteArrowTail C Q n B D0 g0)))
+    D (@Struct_sigma (Hom C B D) (λ g0 : τ (Hom C B D),
+      @Product_grpd (Q A B D f g0) (@FiniteArrowTail C Q n B D g0))
+      g (@Product_pair_grpd _ _ step rest));
+
+symbol finite_arrow_tail_next [C : Cat] (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C), τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  [n : τ Nat_grpd] [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (tail : τ (@FiniteArrowTail C Q (succ n) A B f)) : τ (Obj C)
+≔ sigma_Fst tail;
+
+symbol finite_arrow_tail_arrow [C : Cat] (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C), τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  [n : τ Nat_grpd] [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (tail : τ (@FiniteArrowTail C Q (succ n) A B f))
+  : τ (Hom C B (@finite_arrow_tail_next C Q n A B f tail))
+≔ sigma_Fst (sigma_Snd tail);
+
+symbol finite_arrow_tail_step [C : Cat] (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C), τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  [n : τ Nat_grpd] [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (tail : τ (@FiniteArrowTail C Q (succ n) A B f))
+  : τ (Q A B (@finite_arrow_tail_next C Q n A B f tail) f
+    (@finite_arrow_tail_arrow C Q n A B f tail))
+≔ sigma_Fst (sigma_Snd (sigma_Snd tail));
+
+symbol finite_arrow_tail_rest [C : Cat] (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C), τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  [n : τ Nat_grpd] [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (tail : τ (@FiniteArrowTail C Q (succ n) A B f))
+  : τ (@FiniteArrowTail C Q n B (@finite_arrow_tail_next C Q n A B f tail)
+    (@finite_arrow_tail_arrow C Q n A B f tail))
+≔ sigma_Snd (sigma_Snd (sigma_Snd tail));
+
