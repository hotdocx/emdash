diff --git a/emdash2/tmp/probes/run_homology_boundary_leaf.sh b/emdash2/tmp/probes/run_homology_boundary_leaf.sh
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/run_homology_boundary_leaf.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -u
+cd "$(dirname "$0")/../.."
+stage="${1:?stage required}"
+module="${2:?module required}"
+case "$stage" in /tmp/emdash-homology-boundary-research.??????) ;; *) exit 2 ;; esac
+case "$module" in tmp/probes/homology_*.lp|tmp/probes/exact_*.lp|tmp/probes/finite_*.lp) ;; *) exit 2 ;; esac
+shift 2
+if [[ ! -d "$stage" || ! -f "$module" ]]; then exit 2; fi
+mkdir -p logs/probes
+name="$(basename "$module" .lp)"
+log="$(pwd)/logs/probes/$name-leaf-$(date +%Y%m%d-%H%M%S).log"
+cp "$module" "$stage/$module"
+printf 'checking %s; log: %s\n' "$module" "$log"
+cd "$stage"
+started=$SECONDS
+bash /home/user1/emdash1-long-exact-v1/emdash2/scripts/lambdapi_resource_guard.sh \
+  lambdapi check -c --no-colors "$@" "$module" >"$log" 2>&1
+rc=$?
+printf 'finished %s: exit %s, elapsed %ss\n' "$module" "$rc" "$((SECONDS-started))" | tee -a "$log"
+tail -8 "$log" | cut -c1-260
+exit "$rc"
