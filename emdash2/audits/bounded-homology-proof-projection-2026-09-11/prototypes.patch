+  : τ (Functor (Path_cat (@ComputationalChainPair C S A B D))
+      (@ZeroArrowCone_cat C t T))
+≔ @fapp0 _ _ (@path_lift_func (@ComputationalChainPair C S A B D)
+    (@ZeroArrowCone_cat C t T))
