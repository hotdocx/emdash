new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/homology_nested_target_owner.lp
@@ -0,0 +1,31 @@
+/* Stable object observation for the second coordinate of a nested Sigma.
+   The existing whole/displayed projection functors retain all higher action.
+   Opposite fibres have the same object carrier; no arrow is reversed here. */
+require open emdash.emdash3_2_cubical_square_total;
+
+symbol sigma_nested_target_obj [K A : Cat]
+  (G : τ (Functor K (Catd_cat A)))
+  (q : τ (Obj (@Sigma_cat K
+    (@comp_cat_fapp0 K (Catd_cat A) Cat_cat (@Sigma_func A) G))))
+  : τ (Obj A);
+
+rule @sigma_nested_target_obj _ _ _ (Struct_sigma _ (Struct_sigma $a _))
+  ↪ $a;
+
+// Canonical product-functor projection after totalizing the displayed map.
+rule @fapp0 _ _
+    (@sigma_Snd _ _
+      (@sigma_map_func _ _ _ (@sigma_proj1_family_funcd $K $A $G))) $q
+  ↪ @sigma_nested_target_obj $K $A $G $q;
+
+// The object-level opposite instance; the whole Op/displayed actions remain.
+rule @fapp0 _ _
+    (@sigma_Snd _ _
+      (@sigma_map_func _ _ _
+        (@Op_funcd _ _ _ (@sigma_proj1_family_funcd $K $A $G)))) $q
+  ↪ @sigma_nested_target_obj $K $A $G $q;
+
+// The existing raw pair view is a proof-time reading for neutral objects.
+unif_rule @sigma_nested_target_obj _ _ _ $q
+  ≡ @sigma_Fst _ _ (@sigma_Snd _ _ $q)
+  ↪ [ tt ≡ tt ];
