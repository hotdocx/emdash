+/* Take an exact prefix without changing any retained object, arrow or annotation. */
+require open emdash.emdash3_2_finite_arrow_tails;
+
+symbol finite_arrow_tail_take
+  [C : Cat]
+  (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C),
+    τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  (n m : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (xs : τ (@FiniteArrowTail C Q (@nat_add n m) A B f))
+  : τ (@FiniteArrowTail C Q n A B f)
+≔ (@nat_elim
+    (λ n0 : τ Nat_grpd, @Pi_grpd (Obj C) (λ A0 : τ (Obj C),
+      @Pi_grpd (Obj C) (λ B0 : τ (Obj C),
+        @Pi_grpd (Hom C A0 B0) (λ f0 : τ (Hom C A0 B0),
+          @Function_grpd (@FiniteArrowTail C Q (@nat_add n0 m) A0 B0 f0)
+            (@FiniteArrowTail C Q n0 A0 B0 f0)))))
+    (λ A0 : τ (Obj C), λ B0 : τ (Obj C), λ f0 : τ (Hom C A0 B0),
+      λ _ : τ (@FiniteArrowTail C Q m A0 B0 f0),
+        @finite_arrow_tail_nil C Q A0 B0 f0)
+    (λ n0 : τ Nat_grpd, λ rec : τ _,
+      λ A0 : τ (Obj C), λ B0 : τ (Obj C), λ f0 : τ (Hom C A0 B0),
+      λ xs0 : τ (@FiniteArrowTail C Q (@nat_add (succ n0) m) A0 B0 f0),
+        @finite_arrow_tail_cons C Q n0 A0 B0 f0
+          (@finite_arrow_tail_next C Q (@nat_add n0 m) A0 B0 f0 xs0)
+          (@finite_arrow_tail_arrow C Q (@nat_add n0 m) A0 B0 f0 xs0)
