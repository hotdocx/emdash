+for file in emdash3_2.lp emdash3_2_homology_window.lp emdash3_2_homology_map_kernel_covers.lp emdash3_2_homology_first_exactness.lp emdash3_2_homology_epic_covers.lp emdash3_2_homology_second_exactness.lp emdash3_2_homology_third_exactness.lp; do
