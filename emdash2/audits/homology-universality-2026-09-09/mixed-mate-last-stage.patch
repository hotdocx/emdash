diff --git a/emdash2/emdash3_2_kernel_adjunction_presentations.lp b/emdash2/emdash3_2_kernel_adjunction_presentations.lp
index 80a0d703..184468f5 100644
--- a/emdash2/emdash3_2_kernel_adjunction_presentations.lp
+++ b/emdash2/emdash3_2_kernel_adjunction_presentations.lp
@@ -106,6 +106,26 @@ symbol kernel_presentation_object_path [C : Cat] [S : τ (@PreadditiveCategory C
       (@kernel_presentation_selected_object C S W d))
 ≔ @eq_refl (Obj C) (@fapp0 _ _ (@kernel_presentation_func C S t T W P) d);
 
+// Same-factor composition usability at a kernel endpoint. The endpoint is
+// deliberately the discriminator after the morphism observations reduce.
+// lhs-audit: keep 1 -- the source kernel-functor point selects this comparison.
+unif_rule @comp_fapp0 $C0 $x0 $y0 $z0 $g $f
+  ≡ @comp_fapp0 $C1
+      (@fapp0 _ _ (@kernel_presentation_func $C $S $t $T $W $P) $d)
+      $y1 $z1 $g $f
+  ↪ [ $C0 ≡ $C; $C1 ≡ $C; $y0 ≡ $y1; $z0 ≡ $z1;
+      $x0 ≡ (@fapp0 (Functor_cat WalkingArrow_cat $C) $C
+        (@kernel_presentation_func $C $S $t $T $W $P) $d) ];
+
+// lhs-audit: keep 2 -- the middle kernel-functor point selects this comparison.
+unif_rule @comp_fapp0 $C0 $x0 $y0 $z0 $g $f
+  ≡ @comp_fapp0 $C1 $x1
+      (@fapp0 _ _ (@kernel_presentation_func $C $S $t $T $W $P) $d)
+      $z1 $g $f
+  ↪ [ $C0 ≡ $C; $C1 ≡ $C; $x0 ≡ $x1; $z0 ≡ $z1;
+      $y0 ≡ (@fapp0 (Functor_cat WalkingArrow_cat $C) $C
+        (@kernel_presentation_func $C $S $t $T $W $P) $d) ];
+
 // Actual strict naturality of eta supplies the existing precomposition
 // factor, so no separate square/reconstruction input is added.
 symbol kernel_presentation_map_semantic [C : Cat] [S : τ (@PreadditiveCategory C)]
