+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) (state : τ (@HomologyRowTriple I C C1 P t PA T)) : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T (@homology_row_triple_row0 I C C1 P t PA T state)) (@short_exact_row_family_func I C C1 P t PA T (@homology_row_triple_row1 I C C1 P t PA T state)));
+rule @homology_row_triple_first _ _ _ _ _ _ _
+  (@homology_row_triple_intro _ _ _ _ _ _ _ _ _ _ $v _ _) ↪ $v;
+
+symbol homology_row_triple_second [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) (state : τ (@HomologyRowTriple I C C1 P t PA T)) : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T (@homology_row_triple_row1 I C C1 P t PA T state)) (@short_exact_row_family_func I C C1 P t PA T (@homology_row_triple_row2 I C C1 P t PA T state)));
+rule @homology_row_triple_second _ _ _ _ _ _ _
+  (@homology_row_triple_intro _ _ _ _ _ _ _ _ _ _ _ $v _) ↪ $v;
+
+symbol homology_row_triple_zero [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) (state : τ (@HomologyRowTriple I C C1 P t PA T)) : τ (@RowFamilyMiddleChainZero I C C1 P t PA T (@homology_row_triple_row0 I C C1 P t PA T state) (@homology_row_triple_row1 I C C1 P t PA T state) (@homology_row_triple_row2 I C C1 P t PA T state) (@homology_row_triple_first I C C1 P t PA T state) (@homology_row_triple_second I C C1 P t PA T state));
+rule @homology_row_triple_zero _ _ _ _ _ _ _
+  (@homology_row_triple_intro _ _ _ _ _ _ _ _ _ _ _ _ $v) ↪ $v;
+
+// Shift reuses the two retained rows and their actual whole transformation.
+symbol homology_row_triple_shift [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) (state : τ (@HomologyRowTriple I C C1 P t PA T)) (R : τ (@ShortExactRowFamily I C C1 P t PA T))
+  (h : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T (@homology_row_triple_row2 I C C1 P t PA T state)) (@short_exact_row_family_func I C C1 P t PA T R)))
+  (z : τ (@RowFamilyMiddleChainZero I C C1 P t PA T (@homology_row_triple_row1 I C C1 P t PA T state) (@homology_row_triple_row2 I C C1 P t PA T state) R (@homology_row_triple_second I C C1 P t PA T state) h)) : τ (@HomologyRowTriple I C C1 P t PA T)
+≔ @homology_row_triple_intro I C C1 P t PA T (@homology_row_triple_row1 I C C1 P t PA T state) (@homology_row_triple_row2 I C C1 P t PA T state) R (@homology_row_triple_second I C C1 P t PA T state) h z;
+
+symbol homology_row_triple_window [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) (state : τ (@HomologyRowTriple I C C1 P t PA T)) (R : τ (@ShortExactRowFamily I C C1 P t PA T))
+  (h : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T (@homology_row_triple_row2 I C C1 P t PA T state)) (@short_exact_row_family_func I C C1 P t PA T R)))
+  (z : τ (@RowFamilyMiddleChainZero I C C1 P t PA T (@homology_row_triple_row1 I C C1 P t PA T state) (@homology_row_triple_row2 I C C1 P t PA T state) R (@homology_row_triple_second I C C1 P t PA T state) h))
+  : τ (@HomologyWindowFamily I C C1 P t PA T)
+≔ @homology_window_family_intro I C C1 P t PA T
+  (@homology_window_rows_intro I C C1 P t PA T (@homology_row_triple_row0 I C C1 P t PA T state) (@homology_row_triple_row1 I C C1 P t PA T state) (@homology_row_triple_row2 I C C1 P t PA T state) R (@homology_row_triple_first I C C1 P t PA T state) (@homology_row_triple_second I C C1 P t PA T state) h)
+  (@Product_pair_grpd _ _ (@homology_row_triple_zero I C C1 P t PA T state) z);
+
+
diff --git a/emdash2/tmp/probes/homology_row_spans.lp b/emdash2/tmp/probes/homology_row_spans.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/homology_row_spans.lp
@@ -0,0 +1,58 @@
+/* A finite coherent row extension, with overlap fixed in its indices. */
+require open emdash.tmp.probes.homology_row_triples;
+
+constant symbol HomologyRowSpan [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t))
+  (n : τ Nat_grpd) (state : τ (@HomologyRowTriple I C C1 P t PA T)) : Grpd;
+constant symbol homology_row_span_nil [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t))
+  (state : τ (@HomologyRowTriple I C C1 P t PA T)) : τ (@HomologyRowSpan I C C1 P t PA T zero state);
+constant symbol homology_row_span_cons [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) [n : τ Nat_grpd] (state : τ (@HomologyRowTriple I C C1 P t PA T)) (R : τ (@ShortExactRowFamily I C C1 P t PA T))
+  (h : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T (@homology_row_triple_row2 I C C1 P t PA T state)) (@short_exact_row_family_func I C C1 P t PA T R)))
+  (z : τ (@RowFamilyMiddleChainZero I C C1 P t PA T (@homology_row_triple_row1 I C C1 P t PA T state) (@homology_row_triple_row2 I C C1 P t PA T state) R (@homology_row_triple_second I C C1 P t PA T state) h))
+  (rest : τ (@HomologyRowSpan I C C1 P t PA T n (@homology_row_triple_shift I C C1 P t PA T state R h z)))
+  : τ (@HomologyRowSpan I C C1 P t PA T (succ n) state);
+
+symbol homology_row_span_next [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) [n : τ Nat_grpd]
+  (state : τ (@HomologyRowTriple I C C1 P t PA T)) (span : τ (@HomologyRowSpan I C C1 P t PA T (succ n) state)) : τ (@ShortExactRowFamily I C C1 P t PA T);
+rule @homology_row_span_next _ _ _ _ _ _ _ _ _
+  (@homology_row_span_cons _ _ _ _ _ _ _ _ _ $R _ _ _) ↪ $R;
+
+symbol homology_row_span_map [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) [n : τ Nat_grpd]
+  (state : τ (@HomologyRowTriple I C C1 P t PA T)) (span : τ (@HomologyRowSpan I C C1 P t PA T (succ n) state))
+  : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T (@homology_row_triple_row2 I C C1 P t PA T state)) (@short_exact_row_family_func I C C1 P t PA T (@homology_row_span_next I C C1 P t PA T n state span)));
+rule @homology_row_span_map _ _ _ _ _ _ _ _ _
+  (@homology_row_span_cons _ _ _ _ _ _ _ _ _ _ $h _ _) ↪ $h;
+
+symbol homology_row_span_zero [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) [n : τ Nat_grpd]
+  (state : τ (@HomologyRowTriple I C C1 P t PA T)) (span : τ (@HomologyRowSpan I C C1 P t PA T (succ n) state))
+  : τ (@RowFamilyMiddleChainZero I C C1 P t PA T (@homology_row_triple_row1 I C C1 P t PA T state) (@homology_row_triple_row2 I C C1 P t PA T state) (@homology_row_span_next I C C1 P t PA T n state span) (@homology_row_triple_second I C C1 P t PA T state) (@homology_row_span_map I C C1 P t PA T n state span));
+rule @homology_row_span_zero _ _ _ _ _ _ _ _ _
+  (@homology_row_span_cons _ _ _ _ _ _ _ _ _ _ _ $z _) ↪ $z;
+
+symbol homology_row_span_rest [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) [n : τ Nat_grpd]
+  (state : τ (@HomologyRowTriple I C C1 P t PA T)) (span : τ (@HomologyRowSpan I C C1 P t PA T (succ n) state))
+  : τ (@HomologyRowSpan I C C1 P t PA T n (@homology_row_triple_shift I C C1 P t PA T state (@homology_row_span_next I C C1 P t PA T n state span) (@homology_row_span_map I C C1 P t PA T n state span) (@homology_row_span_zero I C C1 P t PA T n state span)));
+rule @homology_row_span_rest _ _ _ _ _ _ _ _ _
+  (@homology_row_span_cons _ _ _ _ _ _ _ _ _ _ _ _ $rest) ↪ $rest;
+
+// The ordinary four-row window is derived from the sliding state.
+symbol homology_row_span_window [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t)) [n : τ Nat_grpd]
+  (state : τ (@HomologyRowTriple I C C1 P t PA T)) (span : τ (@HomologyRowSpan I C C1 P t PA T (succ n) state))
+  : τ (@HomologyWindowFamily I C C1 P t PA T)
+≔ @homology_row_triple_window I C C1 P t PA T state (@homology_row_span_next I C C1 P t PA T n state span) (@homology_row_span_map I C C1 P t PA T n state span) (@homology_row_span_zero I C C1 P t PA T n state span);
+
diff --git a/emdash2/tmp/probes/homology_row_span_checks.lp b/emdash2/tmp/probes/homology_row_span_checks.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/homology_row_span_checks.lp
@@ -0,0 +1,64 @@
+/* Two successive coherent row windows; no independently supplied overlap equations. */
+require open emdash.tmp.probes.homology_row_spans;
+constant symbol I : Cat;
+constant symbol C : Cat;
+constant symbol C1 : τ (IsNCat (cat_succ cat_zero) C);
+constant symbol P : τ (Functor (Product_cat C C) C);
+constant symbol t : τ (Obj C);
+constant symbol PA : τ (@PreAbelianCategory C P t);
+constant symbol T : τ (@TerminalObject C t);
+constant symbol R0 : τ (@ShortExactRowFamily I C C1 P t PA T);
+constant symbol R1 : τ (@ShortExactRowFamily I C C1 P t PA T);
+constant symbol R2 : τ (@ShortExactRowFamily I C C1 P t PA T);
+constant symbol R3 : τ (@ShortExactRowFamily I C C1 P t PA T);
+constant symbol R4 : τ (@ShortExactRowFamily I C C1 P t PA T);
+constant symbol f : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T R0) (@short_exact_row_family_func I C C1 P t PA T R1));
+constant symbol g : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T R1) (@short_exact_row_family_func I C C1 P t PA T R2));
+constant symbol h : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T R2) (@short_exact_row_family_func I C C1 P t PA T R3));
+constant symbol k : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T R3) (@short_exact_row_family_func I C C1 P t PA T R4));
+constant symbol z0 : τ (@RowFamilyMiddleChainZero I C C1 P t PA T R0 R1 R2 f g);
+constant symbol z1 : τ (@RowFamilyMiddleChainZero I C C1 P t PA T R1 R2 R3 g h);
+constant symbol z2 : τ (@RowFamilyMiddleChainZero I C C1 P t PA T R2 R3 R4 h k);
+
+symbol s0 ≔ @homology_row_triple_intro I C C1 P t PA T R0 R1 R2 f g z0;
+symbol s1 ≔ @homology_row_triple_shift I C C1 P t PA T s0 R3 h z1;
+symbol s2 ≔ @homology_row_triple_shift I C C1 P t PA T s1 R4 k z2;
+symbol tail1 ≔ @homology_row_span_cons I C C1 P t PA T zero s1 R4 k z2 (@homology_row_span_nil I C C1 P t PA T s2);
+symbol tail2 ≔ @homology_row_span_cons I C C1 P t PA T (succ zero) s0 R3 h z1 tail1;
+symbol w0 ≔ @homology_window_family_intro I C C1 P t PA T
+  (@homology_window_rows_intro I C C1 P t PA T R0 R1 R2 R3 f g h) z0 z1;
+symbol w1 ≔ @homology_window_family_intro I C C1 P t PA T
+  (@homology_window_rows_intro I C C1 P t PA T R1 R2 R3 R4 g h k) z1 z2;
+
+assert ⊢ @homology_row_triple_row0 I C C1 P t PA T s1 ≡ R1;
+assert ⊢ @homology_row_triple_row1 I C C1 P t PA T s1 ≡ R2;
+assert ⊢ @homology_row_triple_row2 I C C1 P t PA T s1 ≡ R3;
+assert ⊢ @homology_row_triple_first I C C1 P t PA T s1 ≡ g;
+assert ⊢ @homology_row_triple_second I C C1 P t PA T s1 ≡ h;
+assert ⊢ @homology_row_triple_zero I C C1 P t PA T s1 ≡ z1;
+assert ⊢ @homology_row_span_next I C C1 P t PA T (succ zero) s0 tail2 ≡ R3;
+assert ⊢ @homology_row_span_map I C C1 P t PA T (succ zero) s0 tail2 ≡ h;
+assert ⊢ @homology_row_span_zero I C C1 P t PA T (succ zero) s0 tail2 ≡ z1;
+assert ⊢ @homology_row_span_rest I C C1 P t PA T (succ zero) s0 tail2 ≡ tail1;
+assert ⊢ @homology_row_span_window I C C1 P t PA T (succ zero) s0 tail2 ≡ w0;
+assert ⊢ @homology_row_span_window I C C1 P t PA T zero s1 tail1 ≡ w1;
+
+// The retained maps remain actual transformations with whole Hom action.
+constant symbol x : τ (Obj I);
+constant symbol y : τ (Obj I);
+assert ⊢ @tapp1_func I (@ZeroArrowCone_cat C t T)
+  (@short_exact_row_family_func I C C1 P t PA T R1)
+  (@short_exact_row_family_func I C C1 P t PA T R2) x y
+  (@homology_row_triple_first I C C1 P t PA T s1)
+  ≡ @tapp1_func I (@ZeroArrowCone_cat C t T)
+    (@short_exact_row_family_func I C C1 P t PA T R1)
+    (@short_exact_row_family_func I C C1 P t PA T R2) x y g;
+assert ⊢ @tapp1_func I (@ZeroArrowCone_cat C t T)
+  (@short_exact_row_family_func I C C1 P t PA T R2)
+  (@short_exact_row_family_func I C C1 P t PA T R3) x y
+  (@homology_row_span_map I C C1 P t PA T (succ zero) s0 tail2)
+  ≡ @tapp1_func I (@ZeroArrowCone_cat C t T)
+    (@short_exact_row_family_func I C C1 P t PA T R2)
+    (@short_exact_row_family_func I C C1 P t PA T R3) x y h;
+assertnot ⊢ @homology_row_span_cons I C C1 P t PA T zero s0 R3 h z1 (@homology_row_span_nil I C C1 P t PA T s0)
+  : τ (@HomologyRowSpan I C C1 P t PA T (succ zero) s0);
