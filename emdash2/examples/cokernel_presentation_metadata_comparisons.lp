// catalog-area: Kernel and cokernel selected-map observations
require open emdash.emdash3_2_cokernel_adjunction_presentations;

assert [C : Cat] [S : τ (@PreadditiveCategory C)] [t : τ (Obj C)] [T : τ (@TerminalObject (Op_cat C) t)] [W : τ (@HasComputationalCokernels C S)] (P : τ (@CokernelPresentation C S t T W)) (d : τ (Functor WalkingArrow_cat C)) (X Y : τ (Obj C)) (g h : τ (Hom C Y (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d))) (f : τ (Hom C X Y)) ⊢ @eq_refl (Hom C X (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d)) (@comp_fapp0 C X Y (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d) g f) : τ (@= (Hom C X (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d)) (@comp_fapp0 C X Y (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d) g f) (@comp_fapp0 C X Y (@cokernel_presentation_selected_object C S W d) g f));

assertnot [C : Cat] [S : τ (@PreadditiveCategory C)] [t : τ (Obj C)] [T : τ (@TerminalObject (Op_cat C) t)] [W : τ (@HasComputationalCokernels C S)] (P : τ (@CokernelPresentation C S t T W)) (d : τ (Functor WalkingArrow_cat C)) (X Y : τ (Obj C)) (g h : τ (Hom C Y (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d))) (f : τ (Hom C X Y)) ⊢ (@comp_fapp0 C X Y (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d) g f) ≡ (@comp_fapp0 C X Y (@cokernel_presentation_selected_object C S W d) g f);

assertnot [C : Cat] [S : τ (@PreadditiveCategory C)] [t : τ (Obj C)] [T : τ (@TerminalObject (Op_cat C) t)] [W : τ (@HasComputationalCokernels C S)] (P : τ (@CokernelPresentation C S t T W)) (d : τ (Functor WalkingArrow_cat C)) (X Y : τ (Obj C)) (g h : τ (Hom C Y (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d))) (f : τ (Hom C X Y)) ⊢ @eq_refl (Hom C X (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d)) (@comp_fapp0 C X Y (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d) g f) : τ (@= (Hom C X (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d)) (@comp_fapp0 C X Y (@fapp0 (Functor_cat WalkingArrow_cat C) C (@cokernel_presentation_func C S t T W P) d) g f) (@comp_fapp0 C X Y (@cokernel_presentation_selected_object C S W d) h f));
