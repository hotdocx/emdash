+#!/usr/bin/env bash
+set -euo pipefail
+for lane in baseline candidate; do
+  cd /tmp/emdash-homology-normality-warnings.s1Yulh/"$lane"
+  log=/home/user1/emdash1-long-exact-v1/emdash2/logs/probes/freyd-normality-"$lane"-warnings.log
+  for file in emdash3_2.lp emdash3_2_commutative_algebra_freyd_homology_models.lp emdash3_2_commutative_algebra_freyd_homology_model_normality.lp; do
+    started=$SECONDS
+    printf 'checking %s %s\n' "$lane" "$file"
+    timeout --signal=INT 90s lambdapi check -c --no-colors "$file" >> "$log" 2>&1
+    printf 'checked %s %s in %ss\n' "$lane" "$file" "$((SECONDS - started))"
+  done
+done
