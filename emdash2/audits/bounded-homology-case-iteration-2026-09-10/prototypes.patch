+stage_root="$(mktemp -d /tmp/emdash-homology-case-owner.XXXXXX)"
+cleanup() {
+  case "$stage_root" in
+    /tmp/emdash-homology-case-owner.??????) ;;
+    *) printf 'unexpected temporary path: %s\n' "$stage_root" >&2; return 1 ;;
+  esac
+  local file
+  for file in "$stage_root"/*.lp "$stage_root"/*.lpo \
+      "$stage_root"/*.lpi "$stage_root"/*.lpj "$stage_root"/lambdapi.pkg \
+      "$stage_root"/examples/*.lp "$stage_root"/examples/*.lpo \
+      "$stage_root"/examples/*.lpi "$stage_root"/examples/*.lpj \
+      "$stage_root"/tmp/probes/*.lp "$stage_root"/tmp/probes/*.lpo \
+      "$stage_root"/tmp/probes/*.lpi "$stage_root"/tmp/probes/*.lpj; do
+    if [[ -f "$file" || -L "$file" ]]; then unlink -- "$file"; fi
+  done
+  rmdir -- "$stage_root/tmp/probes" "$stage_root/tmp" "$stage_root/examples" "$stage_root"
+}
+# Research-only: caller owns cleanup of this exact stage after the session.
+printf 'research stage: %s\n' "$stage_root"
+mkdir -p "$stage_root/examples" "$stage_root/tmp/probes"
+cp lambdapi.pkg ./*.lp "$stage_root/"
+for file in "${owners[@]}" "${reviewers[@]}"; do cp --parents "$file" "$stage_root/"; done
+# Exact-step owner deliberately remains unchanged: no proof-field unifier.
+
+check_object() {
+  local file="$1" started="$SECONDS" rc elapsed
+  printf 'checking %s with fresh exact objects (timeout %s, %s)\n' \
+    "$file" "$EMDASH_TYPECHECK_TIMEOUT" "$mode"
+  printf 'checking %s with fresh exact objects (timeout %s, %s)\n' \
+    "$file" "$EMDASH_TYPECHECK_TIMEOUT" "$mode" >>"$log_file"
+  set +e
+  timeout --signal=INT "$EMDASH_TYPECHECK_TIMEOUT" \
+    lambdapi check -c --no-colors "${warning_flags[@]}" "${extra_flags[@]}" \
+    "$file" >>"$log_file" 2>&1
+  rc=$?
+  set -e
+  elapsed=$((SECONDS - started))
+  printf 'finished %s: exit %s, elapsed %ss\n' "$file" "$rc" "$elapsed"
+  printf 'finished %s: exit %s, elapsed %ss\n' "$file" "$rc" "$elapsed" >>"$log_file"
+  if [[ "$rc" -ne 0 ]]; then
+    tail -30 "$log_file" | cut -c1-260 >&2
+    printf 'check failed; log: %s\n' "$log_file" >&2
+    return "$rc"
+  fi
+}
+
+printf 'homology-case-owner check log: %s\n' "$log_file"
+cd "$stage_root"
+check_object emdash3_2.lp
+for file in "${prerequisites[@]}" "${owners[@]}"; do check_object "$file"; done
+result=0
+for file in "${reviewers[@]}"; do
+  if check_object "$file"; then :; else result=1; fi
+done
+if [[ "$result" -ne 0 ]]; then exit 1; fi
+printf 'homology-case-owner checks succeeded; log: %s\n' "$log_file"
