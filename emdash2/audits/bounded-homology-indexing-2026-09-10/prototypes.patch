+symbol last_indexed_H_zero : τ (@= (Hom C (@fapp0 I C last_HA x) (@fapp0 I C last_HA x))
+  (@id C (@fapp0 I C last_HA x))
+  (@preadditive_hom_zero C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) (@fapp0 I C last_HA x) (@fapp0 I C last_HA x)))
+≔ @homology_row_fields_source_zero I C C1 P t Ab T T0 KP QP
+  (@homology_window_family_row0 I C C1 P t (@computational_abelian_preabelian C P t Ab) T (window (finite_degree_last n)))
+  (@homology_window_family_row1 I C C1 P t (@computational_abelian_preabelian C P t Ab) T (window (finite_degree_last n)))
+  (@homology_window_family_row2 I C C1 P t (@computational_abelian_preabelian C P t Ab) T (window (finite_degree_last n)))
+  (@homology_window_family_G I C C1 P t (@computational_abelian_preabelian C P t Ab) T (window (finite_degree_last n)))
+  (@homology_window_family_J I C C1 P t (@computational_abelian_preabelian C P t Ab) T (window (finite_degree_last n)))
+  (@homology_window_family_lower_zero I C C1 P t (@computational_abelian_preabelian C P t Ab) T (window (finite_degree_last n))) x outside_below;
