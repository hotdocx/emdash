/* Historical stronger target conversion control, outside the current queue.
   It uses the public comma-family import; the final conversion is unqualified. */
symbol ua4_gamma [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y))
 (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor K (@RepresentedComma_cat X Y J))
≔ @represented_comma_family_func K X Y J A D h;


symbol ua4_next_target [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y))
  (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D))
  (x y : τ (Obj K)) (p q : τ (Hom K x y))
  (theta : τ (Hom (Hom_cat K x y) p q))  : τ (Hom (Hom_cat Y (@fapp0 K Y D x) (@fapp0 K Y D y)) (@fapp1_fapp0 K Y D x y p) (@fapp1_fapp0 K Y D x y q))
≔ @fapp1_fapp0 (Hom_cat (@RepresentedComma_cat X Y J) (@fapp0 K (@RepresentedComma_cat X Y J) (@ua4_gamma K X Y J A D h) x) (@fapp0 K (@RepresentedComma_cat X Y J) (@ua4_gamma K X Y J A D h) y)) (Hom_cat Y (@fapp0 K Y D x) (@fapp0 K Y D y)) (@fapp1_func (@RepresentedComma_cat X Y J) Y (@represented_comma_target_func X Y J) (@fapp0 K (@RepresentedComma_cat X Y J) (@ua4_gamma K X Y J A D h) x) (@fapp0 K (@RepresentedComma_cat X Y J) (@ua4_gamma K X Y J A D h) y)) (@fapp1_fapp0 K (@RepresentedComma_cat X Y J) (@ua4_gamma K X Y J A D h) x y p) (@fapp1_fapp0 K (@RepresentedComma_cat X Y J) (@ua4_gamma K X Y J A D h) x y q) (@fapp1_fapp0 (Hom_cat K x y) (Hom_cat (@RepresentedComma_cat X Y J) (@fapp0 K (@RepresentedComma_cat X Y J) (@ua4_gamma K X Y J A D h) x) (@fapp0 K (@RepresentedComma_cat X Y J) (@ua4_gamma K X Y J A D h) y)) (@fapp1_func K (@RepresentedComma_cat X Y J) (@ua4_gamma K X Y J A D h) x y) p q theta);

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y))
  (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D))
  (x y : τ (Obj K)) (p q : τ (Hom K x y))
  (theta : τ (Hom (Hom_cat K x y) p q))  ⊢
 @ua4_next_target K X Y J A D h x y p q theta
 ≡ @fapp1_fapp0 (Hom_cat K x y) (Hom_cat Y (@fapp0 K Y D x) (@fapp0 K Y D y)) (@fapp1_func K Y D x y) p q theta;
