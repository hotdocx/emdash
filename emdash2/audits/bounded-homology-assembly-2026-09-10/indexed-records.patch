+            @Pi_grpd (@FiniteArrowTail C Q n0 A0 B0 f0) (λ xs0 : τ _, @Function_grpd
+              (@FiniteArrowTail C Q m (@finite_arrow_tail_last_source C Q n0 A0 B0 f0 xs0) (@finite_arrow_tail_last_target C Q n0 A0 B0 f0 xs0) (@finite_arrow_tail_last_arrow C Q n0 A0 B0 f0 xs0))
