diff --git a/emdash2/tmp/probes/check_first_exactness_prototypes.sh b/emdash2/tmp/probes/check_first_exactness_prototypes.sh
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/check_first_exactness_prototypes.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+stage_root="$(mktemp -d /tmp/emdash-first-exactness.XXXXXX)"
+log_file="$(pwd)/logs/probes/first-exactness-staged-$(date +%Y%m%d-%H%M%S).log"
+mkdir -p "$stage_root/tmp/probes"
+cp lambdapi.pkg ./*.lp "$stage_root/"
+targets=(
+  tmp/probes/cokernel_record_test_change.lp
+  tmp/probes/abelian_cokernel_record_covers.lp
+  tmp/probes/homology_record_test_cover.lp
+  tmp/probes/homology_map_kernel_cover.lp
+  tmp/probes/homology_boundary_naturality.lp
+)
+for file in "${targets[@]}"; do cp "$file" "$stage_root/tmp/probes/"; done
+printf 'stage: %s\nlog: %s\n' "$stage_root" "$log_file"
+cd "$stage_root"
+for file in emdash3_2.lp "${targets[@]}"; do
+  started="$SECONDS"
+  printf 'checking %s\n' "$file"
+  set +e
+  timeout --signal=INT 90s lambdapi check -c --no-colors -w --verbose=2 --too-long=1 "$file" >>"$log_file" 2>&1
+  rc=$?
+  set -e
+  printf 'finished %s: exit %s, elapsed %ss\n' "$file" "$rc" "$((SECONDS-started))"
+  if [[ "$rc" -ne 0 ]]; then tail -n 12 "$log_file" | cut -c1-260; exit "$rc"; fi
+done
