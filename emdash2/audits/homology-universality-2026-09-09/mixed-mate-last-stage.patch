+      (@chain_pair_whole_homology_object C (@computational_homology_preadditive C P t PA) C1 t (@additive_terminal_object C P t (@preabelian_additive C P t PA)) T0 (@preabelian_kernels C P t PA) (@preabelian_cokernels C P t PA) KP QP A1 A2 A3 (@short_exact_row_chain_source_pair C P t PA A1 B1 D1 A2 B2 D2 A3 B3 D3 r1 r2 r3 G J lower_zero)))
