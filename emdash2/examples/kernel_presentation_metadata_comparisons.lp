// catalog-area: Kernel and cokernel selected-map observations
require open emdash.emdash3_2_kernel_adjunction_presentations;

assert [C : Cat] [S : τ (@PreadditiveCategory C)] [t : τ (Obj C)] [T : τ (@TerminalObject C t)] [W : τ (@HasComputationalKernels C S)] (P : τ (@KernelPresentation C S t T W)) (d : τ (Functor WalkingArrow_cat C)) (Y Z : τ (Obj C)) (g h : τ (Hom C Y Z)) (f : τ (Hom C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Y)) ⊢ @eq_refl (Hom C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Z) (@comp_fapp0 C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Y Z g f) : τ (@= (Hom C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Z) (@comp_fapp0 C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Y Z g f) (@comp_fapp0 C (@kernel_presentation_selected_object C S W d) Y Z g f));

assertnot [C : Cat] [S : τ (@PreadditiveCategory C)] [t : τ (Obj C)] [T : τ (@TerminalObject C t)] [W : τ (@HasComputationalKernels C S)] (P : τ (@KernelPresentation C S t T W)) (d : τ (Functor WalkingArrow_cat C)) (Y Z : τ (Obj C)) (g h : τ (Hom C Y Z)) (f : τ (Hom C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Y)) ⊢ (@comp_fapp0 C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Y Z g f) ≡ (@comp_fapp0 C (@kernel_presentation_selected_object C S W d) Y Z g f);

assertnot [C : Cat] [S : τ (@PreadditiveCategory C)] [t : τ (Obj C)] [T : τ (@TerminalObject C t)] [W : τ (@HasComputationalKernels C S)] (P : τ (@KernelPresentation C S t T W)) (d : τ (Functor WalkingArrow_cat C)) (Y Z : τ (Obj C)) (g h : τ (Hom C Y Z)) (f : τ (Hom C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Y)) ⊢ @eq_refl (Hom C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Z) (@comp_fapp0 C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Y Z g f) : τ (@= (Hom C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Z) (@comp_fapp0 C (@fapp0 (Functor_cat WalkingArrow_cat C) C (@kernel_presentation_func C S t T W P) d) Y Z g f) (@comp_fapp0 C (@kernel_presentation_selected_object C S W d) Y Z h f));
