+
+symbol upper_first ≔ @homology_whole_window_first_pair C P t Ab Am Bm Dm A0 B0 D0 A1 B1 D1 A2 B2 D2 rowm row0 row1 row2 F G J z0 z1 C1 T T0 KP QP;
+symbol upper_first_exact ≔ @homology_whole_window_first_exact C P t Ab Am Bm Dm A0 B0 D0 A1 B1 D1 A2 B2 D2 rowm row0 row1 row2 F G J z0 z1 C1 T T0 KP QP;
+symbol upper_second ≔ @homology_whole_window_second_pair C P t Ab Am Bm Dm A0 B0 D0 A1 B1 D1 A2 B2 D2 rowm row0 row1 row2 F G J z0 z1 C1 T T0 KP QP;
+symbol upper_second_exact ≔ @homology_whole_window_second_exact C P t Ab Am Bm Dm A0 B0 D0 A1 B1 D1 A2 B2 D2 rowm row0 row1 row2 F G J z0 z1 C1 T T0 KP QP;
+symbol upper_third_exact ≔ @homology_whole_window_third_exact C P t Ab Am Bm Dm A0 B0 D0 A1 B1 D1 A2 B2 D2 rowm row0 row1 row2 F G J z0 z1 C1 T T0 KP QP;
+symbol upper_tail ≔ computational_exact_arrow_tail_cons_pair PA upper_first upper_first_exact
+  (computational_exact_arrow_tail_cons_pair PA upper_second upper_second_exact
+    (computational_exact_arrow_tail_cons_pair PA upper_third upper_third_exact
+      (computational_exact_arrow_tail_nil PA)));
+
+symbol lower_first_exact ≔ @homology_whole_window_first_exact C P t Ab A0 B0 D0 A1 B1 D1 A2 B2 D2 A3 B3 D3 row0 row1 row2 row3 G J L z1 z2 C1 T T0 KP QP;
+symbol lower_second ≔ @homology_whole_window_second_pair C P t Ab A0 B0 D0 A1 B1 D1 A2 B2 D2 A3 B3 D3 row0 row1 row2 row3 G J L z1 z2 C1 T T0 KP QP;
+symbol lower_second_exact ≔ @homology_whole_window_second_exact C P t Ab A0 B0 D0 A1 B1 D1 A2 B2 D2 A3 B3 D3 row0 row1 row2 row3 G J L z1 z2 C1 T T0 KP QP;
+symbol lower_third ≔ @homology_whole_window_third_pair C P t Ab A0 B0 D0 A1 B1 D1 A2 B2 D2 A3 B3 D3 row0 row1 row2 row3 G J L z1 z2 C1 T T0 KP QP;
+symbol lower_third_exact ≔ @homology_whole_window_third_exact C P t Ab A0 B0 D0 A1 B1 D1 A2 B2 D2 A3 B3 D3 row0 row1 row2 row3 G J L z1 z2 C1 T T0 KP QP;
+symbol lower_tail ≔ computational_exact_arrow_tail_cons_pair PA lower_first lower_first_exact
+  (computational_exact_arrow_tail_cons_pair PA lower_second lower_second_exact
+    (computational_exact_arrow_tail_cons_pair PA lower_third lower_third_exact
+      (computational_exact_arrow_tail_nil PA)));
+
+symbol Q ≔ @ComputationalExactArrowStep C P t PA;
+symbol three : τ Nat_grpd ≔ succ (succ (succ zero));
+symbol joined ≔ finite_arrow_tail_append Q three three upper_tail lower_tail;
+symbol tail_after_three ≔ finite_arrow_tail_rest Q
+  (finite_arrow_tail_rest Q (finite_arrow_tail_rest Q joined));
+
+assert ⊢ finite_arrow_tail_last_arrow Q three upper_tail ≡ shared_upper;
+assert ⊢ tail_after_three ≡ lower_tail;
+assert ⊢ finite_arrow_tail_step Q joined
+  ≡ computational_exact_arrow_step_of_pair PA upper_first upper_first_exact;
+assert ⊢ finite_arrow_tail_last_arrow Q (nat_add three three) joined
+  ≡ computational_chain_pair_d lower_third;
+
+
