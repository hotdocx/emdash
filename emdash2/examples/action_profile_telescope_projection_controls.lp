/* Preserve actual telescope projection orders and normal unit paths. */
require open emdash.examples.action_profile_telescope_profile_paths;
require open emdash.examples.action_profile_relative_transfor_profile_instances;

assert [A B : Cat] (F : τ (Functor A B)) (W : τ (Obj B)) [X Y : τ (Obj A)] [f g : τ (Obj (Hom_cat A X Y))] (alpha : τ (Hom (Hom_cat A X Y) f g)) ⊢ @fapp1_func (Hom_cat A X Y) (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_tele_func B A F W X Y) f g ≡ (@hom_postcomp_tele_fapp1_func B A F W X Y f g);

assert [A B : Cat] (F : τ (Functor A B)) (W : τ (Obj B)) [X Y : τ (Obj A)] [f g : τ (Obj (Hom_cat A X Y))] (alpha : τ (Hom (Hom_cat A X Y) f g)) ⊢ @fapp0 (Hom_cat (Hom_cat A X Y) f g) (Hom_cat (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@fapp0 (Hom_cat A X Y) (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_tele_func B A F W X Y) f) (@fapp0 (Hom_cat A X Y) (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_tele_func B A F W X Y) g)) (@fapp1_func (Hom_cat A X Y) (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_tele_func B A F W X Y) f g) alpha ≡ (@hom_postcomp_tele_transf B A F W X Y f g alpha);

assert [A B : Cat] (F : τ (Functor A B)) (W : τ (Obj B)) [X Y : τ (Obj A)] [f g : τ (Obj (Hom_cat A X Y))] (alpha : τ (Hom (Hom_cat A X Y) f g)) ⊢ @fapp1_fapp0 (Hom_cat A X Y) (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_tele_func B A F W X Y) f g alpha ≡ (@hom_postcomp_tele_transf B A F W X Y f g alpha);

assert [A : Cat] (F : τ (Functor A Cat_cat)) (W : Cat) [X Y : τ (Obj A)] [f g : τ (Obj (Hom_cat A X Y))] (alpha : τ (Hom (Hom_cat A X Y) f g)) ⊢ (@hom_postcomp_tele_fapp1_fapp0 Cat_cat A F W X Y f g alpha) ≡ (@hom_postcomp_tele_transf Cat_cat A F W X Y f g alpha);

assert [A B : Cat] (F : τ (Functor A B)) (W : τ (Obj B)) [X Y : τ (Obj A)] (f : τ (Obj (Hom_cat A X Y))) ⊢ @api_normal_functor_identity_path (Hom_cat A X Y) (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_tele_func B A F W X Y) f : τ (@= (Hom (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y f)) (@hom_postcomp_tele_transf B A F W X Y f f (@id (Hom_cat A X Y) f)) (@id (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f)));

assert [A B : Cat] (F : τ (Functor A B)) (Z : τ (Obj B)) [W X : τ (Obj A)] [f g : τ (Obj (Hom_cat A W X))] (alpha : τ (Hom (Hom_cat A W X) f g)) ⊢ @fapp1_func (Hom_cat A W X) (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_tele_func A B F Z W X) f g ≡ (@hom_precomp_along_tele_fapp1_func A B F Z W X f g);

assert [A B : Cat] (F : τ (Functor A B)) (Z : τ (Obj B)) [W X : τ (Obj A)] [f g : τ (Obj (Hom_cat A W X))] (alpha : τ (Hom (Hom_cat A W X) f g)) ⊢ @fapp0 (Hom_cat (Hom_cat A W X) f g) (Hom_cat (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@fapp0 (Hom_cat A W X) (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_tele_func A B F Z W X) f) (@fapp0 (Hom_cat A W X) (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_tele_func A B F Z W X) g)) (@fapp1_func (Hom_cat A W X) (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_tele_func A B F Z W X) f g) alpha ≡ (@hom_precomp_along_tele_transf A B F Z W X f g alpha);

assert [A B : Cat] (F : τ (Functor A B)) (Z : τ (Obj B)) [W X : τ (Obj A)] [f g : τ (Obj (Hom_cat A W X))] (alpha : τ (Hom (Hom_cat A W X) f g)) ⊢ @fapp1_fapp0 (Hom_cat A W X) (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_tele_func A B F Z W X) f g alpha ≡ (@hom_precomp_along_tele_transf A B F Z W X f g alpha);

assert [A : Cat] (F : τ (Functor A Cat_cat)) (Z : Cat) [W X : τ (Obj A)] [f g : τ (Obj (Hom_cat A W X))] (alpha : τ (Hom (Hom_cat A W X) f g)) ⊢ (@hom_precomp_along_tele_fapp1_fapp0 A Cat_cat F Z W X f g alpha) ≡ (@hom_precomp_along_tele_transf A Cat_cat F Z W X f g alpha);

assert [A B : Cat] (F : τ (Functor A B)) (Z : τ (Obj B)) [W X : τ (Obj A)] (f : τ (Obj (Hom_cat A W X))) ⊢ @api_normal_functor_identity_path (Hom_cat A W X) (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_tele_func A B F Z W X) f : τ (@= (Hom (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_func A B F Z W X f) (@hom_precomp_along_func A B F Z W X f)) (@hom_precomp_along_tele_transf A B F Z W X f f (@id (Hom_cat A W X) f)) (@id (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_func A B F Z W X f)));
