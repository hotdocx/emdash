@@ -0,0 +1,25 @@
+/* Real exact-step record: proof-only comparison, with evidence still required. */
+require open emdash.emdash3_2_computational_exact_arrow_tails;
+constant symbol C : Cat;
+constant symbol P : τ (Functor (Product_cat C C) C);
+constant symbol t : τ (Obj C);
+constant symbol PA : τ (@PreAbelianCategory C P t);
+constant symbol A : τ (Obj C);
+constant symbol B : τ (Obj C);
+constant symbol D : τ (Obj C);
+constant symbol f : τ (Hom C A B);
+constant symbol g : τ (Hom C B D);
+constant symbol z1 : τ (@= (Hom C A D) (@comp_fapp0 C A B D g f) (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) A D));
+constant symbol z2 : τ (@= (Hom C A D) (@comp_fapp0 C A B D g f) (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) A D));
+constant symbol e1 : τ (@computational_exact_at_selected C P t PA A B D (@computational_chain_pair_intro C (@computational_homology_preadditive C P t PA) A B D f g z1));
+constant symbol e2 : τ (@computational_exact_at_selected C P t PA A B D (@computational_chain_pair_intro C (@computational_homology_preadditive C P t PA) A B D f g z2));
+
+assert ⊢ @eq_refl (@ComputationalExactArrowStep C P t PA A B D f g) (@computational_exact_arrow_step_intro C P t PA A B D f g z1 e1)
+  : τ (@= (@ComputationalExactArrowStep C P t PA A B D f g) (@computational_exact_arrow_step_intro C P t PA A B D f g z1 e1) (@computational_exact_arrow_step_intro C P t PA A B D f g z2 e2));
+assert ⊢ @computational_exact_arrow_step_zero C P t PA A B D f g (@computational_exact_arrow_step_intro C P t PA A B D f g z1 e1) ≡ z1;
+assert ⊢ @computational_exact_arrow_step_exact C P t PA A B D f g (@computational_exact_arrow_step_intro C P t PA A B D f g z2 e2) ≡ e2;
+assertnot ⊢ (@computational_exact_arrow_step_intro C P t PA A B D f g z1 e1) ≡ (@computational_exact_arrow_step_intro C P t PA A B D f g z2 e2);
+assertnot ⊢ @computational_exact_arrow_step_intro C P t PA A B D f g z1 z1 : τ (@ComputationalExactArrowStep C P t PA A B D f g);
+
+assertnot ⊢ @computational_exact_arrow_step_intro C P t PA A B D f g z1
+  : τ (@ComputationalExactArrowStep C P t PA A B D f g);
diff --git a/emdash2/tmp/probes/finite_arrow_tail_arrows.lp b/emdash2/tmp/probes/finite_arrow_tail_arrows.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/finite_arrow_tail_arrows.lp
@@ -0,0 +1,30 @@
+/* A data-only view of the original arrows, retaining each complete arrow in LaxArrow_cat. */
+require open emdash.emdash3_2_finite_arrow_tails;
+require open emdash.emdash3_2_finite_families;
+require open emdash.emdash3_2_cubical_internalization;
+
+symbol finite_arrow_tail_arrows
+  [C : Cat]
+  (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C),
+    τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (xs : τ (@FiniteArrowTail C Q n A B f))
+  : τ (@FiniteFamily (Obj (@LaxArrow_cat C)) (succ n))
+≔ (@nat_elim
+    (λ n0 : τ Nat_grpd, @Pi_grpd (Obj C) (λ A0 : τ (Obj C),
+      @Pi_grpd (Obj C) (λ B0 : τ (Obj C),
+        @Pi_grpd (Hom C A0 B0) (λ f0 : τ (Hom C A0 B0),
+          @Function_grpd (@FiniteArrowTail C Q n0 A0 B0 f0)
+            (@FiniteFamily (Obj (@LaxArrow_cat C)) (succ n0))))))
+    (λ A0 : τ (Obj C), λ B0 : τ (Obj C), λ f0 : τ (Hom C A0 B0),
+      λ _ : τ (@FiniteArrowTail C Q zero A0 B0 f0),
+        @finite_family_cons (Obj (@LaxArrow_cat C)) zero (@lax_edge C A0 B0 f0)
+          (@finite_family_nil (Obj (@LaxArrow_cat C))))
+    (λ n0 : τ Nat_grpd, λ rec : τ _,
+      λ A0 : τ (Obj C), λ B0 : τ (Obj C), λ f0 : τ (Hom C A0 B0),
+      λ xs0 : τ (@FiniteArrowTail C Q (succ n0) A0 B0 f0),
+        @finite_family_cons (Obj (@LaxArrow_cat C)) (succ n0) (@lax_edge C A0 B0 f0)
+          (rec B0 (@finite_arrow_tail_next C Q n0 A0 B0 f0 xs0)
+            (@finite_arrow_tail_arrow C Q n0 A0 B0 f0 xs0)
+            (@finite_arrow_tail_rest C Q n0 A0 B0 f0 xs0)))
+    n) A B f xs;
diff --git a/emdash2/tmp/probes/homology_row_field_span_case.lp b/emdash2/tmp/probes/homology_row_field_span_case.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/homology_row_field_span_case.lp
@@ -0,0 +1,15 @@
+/* Expose a constructor's fields before invoking the semantic continuation. */
+require open emdash.tmp.probes.homology_row_field_spans;
+symbol homology_row_field_span_case [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t))
+  [n : τ Nat_grpd] (R0 R1 R2 : τ (@ShortExactRowFamily I C C1 P t PA T))
+  (f : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T R0) (@short_exact_row_family_func I C C1 P t PA T R1))) (g : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T R1) (@short_exact_row_family_func I C C1 P t PA T R2)))
+  (z0 : τ (@RowFamilyMiddleChainZero I C C1 P t PA T R0 R1 R2 f g)) [Result : Grpd]
+  (branch : Π R3 : τ (@ShortExactRowFamily I C C1 P t PA T), Π h : τ (@Transf I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t PA T R2) (@short_exact_row_family_func I C C1 P t PA T R3)), Π z1 : τ (@RowFamilyMiddleChainZero I C C1 P t PA T R1 R2 R3 g h),
+    τ (@HomologyRowFieldSpan I C C1 P t PA T n R1 R2 R3 g h z1) → τ Result)
+  (span : τ (@HomologyRowFieldSpan I C C1 P t PA T (succ n) R0 R1 R2 f g z0))
+  : τ Result;
+rule @homology_row_field_span_case _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ $branch
+  (@homology_row_field_span_cons _ _ _ _ _ _ _ _ _ _ _ _ _ _ $R3 $h $z1 $rest)
+  ↪ $branch $R3 $h $z1 $rest;
