/*
  Set-targeted sequential telescope as a genuine per-object categorical-HIT
  localization contract.

  For an endomap s:A->A, the intended localization is generated by points

    inc(n,x) : Tel(A,s)

  and paths

    inc(n+1,s(x)) = inc(n,x).

  The selected eliminator computes on point constructors.  Its path beta is
  propositionally unique for set-valued targets, so no competing runtime
  rewrite for generic equality action is needed.  Both whole universal-
  property inverse laws and the transition equivalence are derived from
  induction and proof uniqueness; they are not primitive sheaf-reflector
  axioms or claims about arbitrary sites.
*/

require open emdash.emdash3_2_eq1_evidence_property;

// Set-truncated sequential localization generated by one endomap.
injective symbol TelescopeLocalization_grpd
  (A : Grpd)
  (s : τ (@Function_grpd A A))
  : Grpd;

// Point constructor at telescope stage n.
injective symbol telescope_localization_inc
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@TelescopeLocalization_grpd A s);

// Path constructor identifying one transition with the previous stage.
constant symbol telescope_localization_step
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@=
      (@TelescopeLocalization_grpd A s)
      (@telescope_localization_inc A s (succ n) (s x))
      (@telescope_localization_inc A s n x));

// The HIT includes set truncation; this boundary targets Set-valued data.
constant symbol telescope_localization_is_set
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  : τ (IsSetGrpd (@TelescopeLocalization_grpd A s));

/*
  Compatible cocones into B.  A stage family f_n:A->B carries one path
  f_(n+1)(s x)=f_n(x) for each transition.
*/
symbol TelescopeLocalizationStageMaps_grpd
  (A B : Grpd)
  : Grpd
≔ @Pi_grpd Nat_grpd
    (λ _ : τ Nat_grpd, @Function_grpd A B);

symbol TelescopeLocalizationStageCoherence_grpd
  [A : Grpd]
  (s : τ (@Function_grpd A A))
  [B : Grpd]
  (f : τ (@TelescopeLocalizationStageMaps_grpd A B))
  : Grpd
≔ @Pi_grpd Nat_grpd
    (λ n : τ Nat_grpd,
      @Pi_grpd A
        (λ x : τ A,
          @= B (f (succ n) (s x)) (f n x)));

symbol TelescopeLocalizationCocone_grpd
  (A : Grpd)
  (s : τ (@Function_grpd A A))
  (B : Grpd)
  : Grpd
≔ @Σ_
    (@TelescopeLocalizationStageMaps_grpd A B)
    (λ f : τ (@TelescopeLocalizationStageMaps_grpd A B),
      @TelescopeLocalizationStageCoherence_grpd A s B f);

symbol telescope_localization_stage_coherence_is_prop
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (f : τ (@TelescopeLocalizationStageMaps_grpd A B))
  : τ (IsPropGrpd
      (@TelescopeLocalizationStageCoherence_grpd A s B f))
≔ @is_prop_pi
    Nat_grpd
    (λ n : τ Nat_grpd,
      @Pi_grpd A
        (λ x : τ A,
          @= B (f (succ n) (s x)) (f n x)))
    (λ n : τ Nat_grpd,
      @is_prop_pi
        A
        (λ x : τ A,
          @= B (f (succ n) (s x)) (f n x))
        (λ x : τ A,
          hB (f (succ n) (s x)) (f n x)));

// Readable constructor for compatible cocone data.
symbol telescope_localization_cocone_intro
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (f : τ (@TelescopeLocalizationStageMaps_grpd A B))
  (q : τ (@TelescopeLocalizationStageCoherence_grpd A s B f))
  : τ (@TelescopeLocalizationCocone_grpd A s B)
≔ @Struct_sigma
    (@TelescopeLocalizationStageMaps_grpd A B)
    (λ g : τ (@TelescopeLocalizationStageMaps_grpd A B),
      @TelescopeLocalizationStageCoherence_grpd A s B g)
    f q;

symbol telescope_localization_cocone_stage
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (d : τ (@TelescopeLocalizationCocone_grpd A s B))
  (n : τ Nat_grpd)
  (x : τ A)
  : τ B
≔ sigma_Fst d n x;

symbol telescope_localization_cocone_step
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (d : τ (@TelescopeLocalizationCocone_grpd A s B))
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@= B
      (@telescope_localization_cocone_stage A s B d (succ n) (s x))
      (@telescope_localization_cocone_stage A s B d n x))
≔ sigma_Snd d n x;

// Restrict a function out of the HIT to its compatible constructor data.
symbol telescope_localization_restrict
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (g : τ (@Function_grpd (@TelescopeLocalization_grpd A s) B))
  : τ (@TelescopeLocalizationCocone_grpd A s B)
≔ @telescope_localization_cocone_intro
    A s B
    (λ n : τ Nat_grpd,
      λ x : τ A,
        g (@telescope_localization_inc A s n x))
    (λ n : τ Nat_grpd,
      λ x : τ A,
        @eq_ap
          (@TelescopeLocalization_grpd A s)
          B
          g
          (@telescope_localization_inc A s (succ n) (s x))
          (@telescope_localization_inc A s n x)
          (@telescope_localization_step A s n x));

symbol telescope_localization_restrict_map
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  : τ (Hom
      Grpd_cat
      (@Function_grpd (@TelescopeLocalization_grpd A s) B)
      (@TelescopeLocalizationCocone_grpd A s B))
≔ λ g : τ (@Function_grpd (@TelescopeLocalization_grpd A s) B),
    @telescope_localization_restrict A s B g;

/*
  Primitive dependent eliminator. Eliminating the set-truncation constructor
  requires set-valued fibres; transition coherence is one whole PathOver.
*/
injective symbol telescope_localization_ind
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (D : τ (@TelescopeLocalization_grpd A s) → Grpd)
  (hD : Π z : τ (@TelescopeLocalization_grpd A s),
    τ (IsSetGrpd (D z)))
  (d : Π n : τ Nat_grpd,
    Π x : τ A,
      τ (D (@telescope_localization_inc A s n x)))
  (coh : Π n : τ Nat_grpd,
    Π x : τ A,
      τ (@PathOver
        (@TelescopeLocalization_grpd A s)
        D
        (@telescope_localization_inc A s (succ n) (s x))
        (@telescope_localization_inc A s n x)
        (@telescope_localization_step A s n x)
        (d (succ n) (s x))
        (d n x)))
  (z : τ (@TelescopeLocalization_grpd A s))
  : τ (D z);

// Point-constructor beta is the selected runtime computation.
rule @telescope_localization_ind $A $s _ _ $d _
      (@telescope_localization_inc $A $s $n $x)
  ↪ $d $n $x;

// Nondependent eliminator, transparently specialized from induction.
symbol telescope_localization_elim
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (d : τ (@TelescopeLocalizationCocone_grpd A s B))
  (z : τ (@TelescopeLocalization_grpd A s))
  : τ B
≔ @telescope_localization_ind
    A s
    (λ _ : τ (@TelescopeLocalization_grpd A s), B)
    (λ _ : τ (@TelescopeLocalization_grpd A s), hB)
    (λ n : τ Nat_grpd,
      λ x : τ A,
        @telescope_localization_cocone_stage A s B d n x)
    (λ n : τ Nat_grpd,
      λ x : τ A,
        @const_pathover
          (@TelescopeLocalization_grpd A s)
          B
          (@telescope_localization_inc A s (succ n) (s x))
          (@telescope_localization_inc A s n x)
          (@telescope_localization_cocone_stage A s B d (succ n) (s x))
          (@telescope_localization_cocone_stage A s B d n x)
          (@telescope_localization_step A s n x)
          (@telescope_localization_cocone_step A s B d n x))
    z;

symbol telescope_localization_elim_map
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  : τ (Hom
      Grpd_cat
      (@TelescopeLocalizationCocone_grpd A s B)
      (@Function_grpd (@TelescopeLocalization_grpd A s) B))
≔ λ d : τ (@TelescopeLocalizationCocone_grpd A s B),
    λ z : τ (@TelescopeLocalization_grpd A s),
      @telescope_localization_elim A s B hB d z;

/*
  HIT uniqueness.  The first whole inverse law is derived by dependent
  induction into the proposition-valued equality family and two uses of
  function extensionality; it is not additional primitive signature data.
*/
symbol telescope_localization_elim_restrict_motive
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (g : τ (@Function_grpd (@TelescopeLocalization_grpd A s) B))
  (z : τ (@TelescopeLocalization_grpd A s))
  : Grpd
≔ @=
    B
    (@telescope_localization_elim
      A s B hB
      (@telescope_localization_restrict A s B g)
      z)
    (g z);

symbol telescope_localization_elim_restrict_motive_is_prop
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (g : τ (@Function_grpd (@TelescopeLocalization_grpd A s) B))
  (z : τ (@TelescopeLocalization_grpd A s))
  : τ (IsPropGrpd
      (@telescope_localization_elim_restrict_motive A s B hB g z))
≔ hB
    (@telescope_localization_elim
      A s B hB
      (@telescope_localization_restrict A s B g)
      z)
    (g z);

symbol telescope_localization_elim_restrict_inc
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (g : τ (@Function_grpd (@TelescopeLocalization_grpd A s) B))
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@telescope_localization_elim_restrict_motive
      A s B hB g (@telescope_localization_inc A s n x))
≔ @eq_refl B (g (@telescope_localization_inc A s n x));

symbol telescope_localization_elim_restrict_coherence
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (g : τ (@Function_grpd (@TelescopeLocalization_grpd A s) B))
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@PathOver
      (@TelescopeLocalization_grpd A s)
      (@telescope_localization_elim_restrict_motive A s B hB g)
      (@telescope_localization_inc A s (succ n) (s x))
      (@telescope_localization_inc A s n x)
      (@telescope_localization_step A s n x)
      (@telescope_localization_elim_restrict_inc A s B hB g (succ n) (s x))
      (@telescope_localization_elim_restrict_inc A s B hB g n x))
≔ @prop_family_pathover
    (@TelescopeLocalization_grpd A s)
    (@telescope_localization_elim_restrict_motive A s B hB g)
    (@telescope_localization_elim_restrict_motive_is_prop A s B hB g)
    (@telescope_localization_inc A s (succ n) (s x))
    (@telescope_localization_inc A s n x)
    (@telescope_localization_step A s n x)
    (@telescope_localization_elim_restrict_inc A s B hB g (succ n) (s x))
    (@telescope_localization_elim_restrict_inc A s B hB g n x);

symbol telescope_localization_elim_restrict_pointwise
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (g : τ (@Function_grpd (@TelescopeLocalization_grpd A s) B))
  (z : τ (@TelescopeLocalization_grpd A s))
  : τ (@telescope_localization_elim_restrict_motive A s B hB g z)
≔ @telescope_localization_ind
    A s
    (@telescope_localization_elim_restrict_motive A s B hB g)
    (λ w : τ (@TelescopeLocalization_grpd A s),
      @prop_is_trunc_succ
        trunc_minus_one
        (@telescope_localization_elim_restrict_motive A s B hB g w)
        (@telescope_localization_elim_restrict_motive_is_prop A s B hB g w))
    (@telescope_localization_elim_restrict_inc A s B hB g)
    (@telescope_localization_elim_restrict_coherence A s B hB g)
    z;

symbol telescope_localization_elim_restrict_point
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (g : τ (@Function_grpd (@TelescopeLocalization_grpd A s) B))
  : τ (@=
      (@Function_grpd (@TelescopeLocalization_grpd A s) B)
      (λ z : τ (@TelescopeLocalization_grpd A s),
        @telescope_localization_elim
          A s B hB
          (@telescope_localization_restrict A s B g)
          z)
      g)
≔ @PiFunext
    (@TelescopeLocalization_grpd A s)
    (λ _ : τ (@TelescopeLocalization_grpd A s), B)
    (λ z : τ (@TelescopeLocalization_grpd A s),
      @telescope_localization_elim
        A s B hB
        (@telescope_localization_restrict A s B g)
        z)
    g
    (@telescope_localization_elim_restrict_pointwise A s B hB g);

symbol telescope_localization_elim_restrict_law
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  : τ (@=
      (Hom Grpd_cat
        (@Function_grpd (@TelescopeLocalization_grpd A s) B)
        (@Function_grpd (@TelescopeLocalization_grpd A s) B))
      (@comp_fapp0
        Grpd_cat
        (@Function_grpd (@TelescopeLocalization_grpd A s) B)
        (@TelescopeLocalizationCocone_grpd A s B)
        (@Function_grpd (@TelescopeLocalization_grpd A s) B)
        (@telescope_localization_elim_map A s B hB)
        (@telescope_localization_restrict_map A s B))
      (@id Grpd_cat
        (@Function_grpd (@TelescopeLocalization_grpd A s) B)))
≔ @PiFunext
    (@Function_grpd (@TelescopeLocalization_grpd A s) B)
    (λ _ : τ (@Function_grpd (@TelescopeLocalization_grpd A s) B),
      @Function_grpd (@TelescopeLocalization_grpd A s) B)
    (@grpd_comp_function
      (@Function_grpd (@TelescopeLocalization_grpd A s) B)
      (@TelescopeLocalizationCocone_grpd A s B)
      (@Function_grpd (@TelescopeLocalization_grpd A s) B)
      (@telescope_localization_elim_map A s B hB)
      (@telescope_localization_restrict_map A s B))
    (@grpd_id_function
      (@Function_grpd (@TelescopeLocalization_grpd A s) B))
    (@telescope_localization_elim_restrict_point A s B hB);

/*
  The second whole inverse law is also derived. Point beta and nested
  function extensionality identify the stage maps; their coherence fibres are
  proposition-valued, and Sigma induction covers every cocone package.
*/
symbol telescope_localization_restrict_elim_stage_path
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (f : τ (@TelescopeLocalizationStageMaps_grpd A B))
  (q : τ (@TelescopeLocalizationStageCoherence_grpd A s B f))
  : τ (@=
      (@TelescopeLocalizationStageMaps_grpd A B)
      (sigma_Fst
        (@telescope_localization_restrict
          A s B
          (λ z : τ (@TelescopeLocalization_grpd A s),
            @telescope_localization_elim
              A s B hB
              (@telescope_localization_cocone_intro A s B f q)
              z)))
      f)
≔ @PiFunext
    Nat_grpd
    (λ _ : τ Nat_grpd, @Function_grpd A B)
    (λ n : τ Nat_grpd,
      λ x : τ A,
        @telescope_localization_elim
          A s B hB
          (@telescope_localization_cocone_intro A s B f q)
          (@telescope_localization_inc A s n x))
    f
    (λ n : τ Nat_grpd,
      @PiFunext
        A
        (λ _ : τ A, B)
        (λ x : τ A,
          @telescope_localization_elim
            A s B hB
            (@telescope_localization_cocone_intro A s B f q)
            (@telescope_localization_inc A s n x))
        (f n)
        (λ x : τ A, @eq_refl B (f n x)));

symbol telescope_localization_restrict_elim_struct
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (f : τ (@TelescopeLocalizationStageMaps_grpd A B))
  (q : τ (@TelescopeLocalizationStageCoherence_grpd A s B f))
  : τ (@=
      (@TelescopeLocalizationCocone_grpd A s B)
      (@telescope_localization_restrict
        A s B
        (λ z : τ (@TelescopeLocalization_grpd A s),
          @telescope_localization_elim
            A s B hB
            (@telescope_localization_cocone_intro A s B f q)
            z))
      (@telescope_localization_cocone_intro A s B f q))
≔ @sigma_path_intro
    (@TelescopeLocalizationStageMaps_grpd A B)
    (λ g : τ (@TelescopeLocalizationStageMaps_grpd A B),
      @TelescopeLocalizationStageCoherence_grpd A s B g)
    (sigma_Fst
      (@telescope_localization_restrict
        A s B
        (λ z : τ (@TelescopeLocalization_grpd A s),
          @telescope_localization_elim
            A s B hB
            (@telescope_localization_cocone_intro A s B f q)
            z)))
    f
    (sigma_Snd
      (@telescope_localization_restrict
        A s B
        (λ z : τ (@TelescopeLocalization_grpd A s),
          @telescope_localization_elim
            A s B hB
            (@telescope_localization_cocone_intro A s B f q)
            z)))
    q
    (@telescope_localization_restrict_elim_stage_path A s B hB f q)
    (@prop_family_pathover
      (@TelescopeLocalizationStageMaps_grpd A B)
      (λ g : τ (@TelescopeLocalizationStageMaps_grpd A B),
        @TelescopeLocalizationStageCoherence_grpd A s B g)
      (@telescope_localization_stage_coherence_is_prop A s B hB)
      (sigma_Fst
        (@telescope_localization_restrict
          A s B
          (λ z : τ (@TelescopeLocalization_grpd A s),
            @telescope_localization_elim
              A s B hB
              (@telescope_localization_cocone_intro A s B f q)
              z)))
      f
      (@telescope_localization_restrict_elim_stage_path A s B hB f q)
      (sigma_Snd
        (@telescope_localization_restrict
          A s B
          (λ z : τ (@TelescopeLocalization_grpd A s),
            @telescope_localization_elim
              A s B hB
              (@telescope_localization_cocone_intro A s B f q)
              z)))
      q);

symbol telescope_localization_restrict_elim_point
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (d : τ (@TelescopeLocalizationCocone_grpd A s B))
  : τ (@=
      (@TelescopeLocalizationCocone_grpd A s B)
      (@telescope_localization_restrict
        A s B
        (λ z : τ (@TelescopeLocalization_grpd A s),
          @telescope_localization_elim A s B hB d z))
      d)
≔ @sigma_ind
    (@TelescopeLocalizationStageMaps_grpd A B)
    (λ f : τ (@TelescopeLocalizationStageMaps_grpd A B),
      @TelescopeLocalizationStageCoherence_grpd A s B f)
    (λ e : τ (@TelescopeLocalizationCocone_grpd A s B),
      @=
        (@TelescopeLocalizationCocone_grpd A s B)
        (@telescope_localization_restrict
          A s B
          (λ z : τ (@TelescopeLocalization_grpd A s),
            @telescope_localization_elim A s B hB e z))
        e)
    (λ f : τ (@TelescopeLocalizationStageMaps_grpd A B),
      λ q : τ (@TelescopeLocalizationStageCoherence_grpd A s B f),
        @telescope_localization_restrict_elim_struct A s B hB f q)
    d;

symbol telescope_localization_restrict_elim_law
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  : τ (@=
      (Hom Grpd_cat
        (@TelescopeLocalizationCocone_grpd A s B)
        (@TelescopeLocalizationCocone_grpd A s B))
      (@comp_fapp0
        Grpd_cat
        (@TelescopeLocalizationCocone_grpd A s B)
        (@Function_grpd (@TelescopeLocalization_grpd A s) B)
        (@TelescopeLocalizationCocone_grpd A s B)
        (@telescope_localization_restrict_map A s B)
        (@telescope_localization_elim_map A s B hB))
      (@id Grpd_cat (@TelescopeLocalizationCocone_grpd A s B)))
≔ @PiFunext
    (@TelescopeLocalizationCocone_grpd A s B)
    (λ _ : τ (@TelescopeLocalizationCocone_grpd A s B),
      @TelescopeLocalizationCocone_grpd A s B)
    (@grpd_comp_function
      (@TelescopeLocalizationCocone_grpd A s B)
      (@Function_grpd (@TelescopeLocalization_grpd A s) B)
      (@TelescopeLocalizationCocone_grpd A s B)
      (@telescope_localization_restrict_map A s B)
      (@telescope_localization_elim_map A s B hB))
    (@grpd_id_function (@TelescopeLocalizationCocone_grpd A s B))
    (@telescope_localization_restrict_elim_point A s B hB);

// Fixed-forward whole universal property of the HIT eliminator.
symbol telescope_localization_eliminator_equiv
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  : τ (@OmegaEquivAlong
      Grpd_cat
      (@Function_grpd (@TelescopeLocalization_grpd A s) B)
      (@TelescopeLocalizationCocone_grpd A s B)
      (@telescope_localization_restrict_map A s B))
≔ @omega_equiv_along_intro
    Grpd_cat
    (@Function_grpd (@TelescopeLocalization_grpd A s) B)
    (@TelescopeLocalizationCocone_grpd A s B)
    (@telescope_localization_restrict_map A s B)
    (@telescope_localization_elim_map A s B hB)
    (@telescope_localization_elim_map A s B hB)
    (@telescope_localization_elim_restrict_law A s B hB)
    (@telescope_localization_restrict_elim_law A s B hB);

// The path beta is proof-unique in a set target; no generic eq_ap rule.
symbol telescope_localization_elim_step_beta
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  [B : Grpd]
  (hB : τ (IsSetGrpd B))
  (d : τ (@TelescopeLocalizationCocone_grpd A s B))
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@=
      (@= B
        (@telescope_localization_cocone_stage A s B d (succ n) (s x))
        (@telescope_localization_cocone_stage A s B d n x))
      (@eq_ap
        (@TelescopeLocalization_grpd A s)
        B
        (λ z : τ (@TelescopeLocalization_grpd A s),
          @telescope_localization_elim A s B hB d z)
        (@telescope_localization_inc A s (succ n) (s x))
        (@telescope_localization_inc A s n x)
        (@telescope_localization_step A s n x))
      (@telescope_localization_cocone_step A s B d n x))
≔ @is_contr_center
    (@=
      (@= B
        (@telescope_localization_cocone_stage A s B d (succ n) (s x))
        (@telescope_localization_cocone_stage A s B d n x))
      (@eq_ap
        (@TelescopeLocalization_grpd A s)
        B
        (λ z : τ (@TelescopeLocalization_grpd A s),
          @telescope_localization_elim A s B hB d z)
        (@telescope_localization_inc A s (succ n) (s x))
        (@telescope_localization_inc A s n x)
        (@telescope_localization_step A s n x))
      (@telescope_localization_cocone_step A s B d n x))
    ((hB
      (@telescope_localization_cocone_stage A s B d (succ n) (s x))
      (@telescope_localization_cocone_stage A s B d n x))
      (@eq_ap
        (@TelescopeLocalization_grpd A s)
        B
        (λ z : τ (@TelescopeLocalization_grpd A s),
          @telescope_localization_elim A s B hB d z)
        (@telescope_localization_inc A s (succ n) (s x))
        (@telescope_localization_inc A s n x)
        (@telescope_localization_step A s n x))
      (@telescope_localization_cocone_step A s B d n x));

/*
  The transition action on the telescope and its index-shift inverse. Their
  constructor computations are inherited from the eliminator beta.
*/
symbol telescope_localization_forward_cocone
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  : τ (@TelescopeLocalizationCocone_grpd
      A s (@TelescopeLocalization_grpd A s))
≔ @telescope_localization_cocone_intro
    A s (@TelescopeLocalization_grpd A s)
    (λ n : τ Nat_grpd,
      λ x : τ A,
        @telescope_localization_inc A s n (s x))
    (λ n : τ Nat_grpd,
      λ x : τ A,
        @telescope_localization_step A s n (s x));

symbol telescope_localization_inverse_cocone
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  : τ (@TelescopeLocalizationCocone_grpd
      A s (@TelescopeLocalization_grpd A s))
≔ @telescope_localization_cocone_intro
    A s (@TelescopeLocalization_grpd A s)
    (λ n : τ Nat_grpd,
      λ x : τ A,
        @telescope_localization_inc A s (succ n) x)
    (λ n : τ Nat_grpd,
      λ x : τ A,
        @telescope_localization_step A s (succ n) x);

symbol telescope_localization_forward
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  : τ (Hom
      Grpd_cat
      (@TelescopeLocalization_grpd A s)
      (@TelescopeLocalization_grpd A s))
≔ λ z : τ (@TelescopeLocalization_grpd A s),
    @telescope_localization_elim
      A s
      (@TelescopeLocalization_grpd A s)
      (@telescope_localization_is_set A s)
      (@telescope_localization_forward_cocone A s)
      z;

symbol telescope_localization_inverse
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  : τ (Hom
      Grpd_cat
      (@TelescopeLocalization_grpd A s)
      (@TelescopeLocalization_grpd A s))
≔ λ z : τ (@TelescopeLocalization_grpd A s),
    @telescope_localization_elim
      A s
      (@TelescopeLocalization_grpd A s)
      (@telescope_localization_is_set A s)
      (@telescope_localization_inverse_cocone A s)
      z;

// Both composites have the same constructor-level witness: the HIT step.
symbol telescope_localization_forward_inverse_motive
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (z : τ (@TelescopeLocalization_grpd A s))
  : Grpd
≔ @=
    (@TelescopeLocalization_grpd A s)
    (@telescope_localization_forward A s
      (@telescope_localization_inverse A s z))
    z;

symbol telescope_localization_forward_inverse_motive_is_prop
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (z : τ (@TelescopeLocalization_grpd A s))
  : τ (IsPropGrpd
      (@telescope_localization_forward_inverse_motive A s z))
≔ (@telescope_localization_is_set A s)
    (@telescope_localization_forward A s
      (@telescope_localization_inverse A s z))
    z;

symbol telescope_localization_forward_inverse_inc
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@telescope_localization_forward_inverse_motive
      A s (@telescope_localization_inc A s n x))
≔ @telescope_localization_step A s n x;

symbol telescope_localization_forward_inverse_coherence
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@PathOver
      (@TelescopeLocalization_grpd A s)
      (@telescope_localization_forward_inverse_motive A s)
      (@telescope_localization_inc A s (succ n) (s x))
      (@telescope_localization_inc A s n x)
      (@telescope_localization_step A s n x)
      (@telescope_localization_forward_inverse_inc A s (succ n) (s x))
      (@telescope_localization_forward_inverse_inc A s n x))
≔ @prop_family_pathover
    (@TelescopeLocalization_grpd A s)
    (@telescope_localization_forward_inverse_motive A s)
    (@telescope_localization_forward_inverse_motive_is_prop A s)
    (@telescope_localization_inc A s (succ n) (s x))
    (@telescope_localization_inc A s n x)
    (@telescope_localization_step A s n x)
    (@telescope_localization_forward_inverse_inc A s (succ n) (s x))
    (@telescope_localization_forward_inverse_inc A s n x);

symbol telescope_localization_forward_inverse_point
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (z : τ (@TelescopeLocalization_grpd A s))
  : τ (@telescope_localization_forward_inverse_motive A s z)
≔ @telescope_localization_ind
    A s
    (@telescope_localization_forward_inverse_motive A s)
    (λ w : τ (@TelescopeLocalization_grpd A s),
      @prop_is_trunc_succ
        trunc_minus_one
        (@telescope_localization_forward_inverse_motive A s w)
        (@telescope_localization_forward_inverse_motive_is_prop A s w))
    (@telescope_localization_forward_inverse_inc A s)
    (@telescope_localization_forward_inverse_coherence A s)
    z;

symbol telescope_localization_inverse_forward_motive
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (z : τ (@TelescopeLocalization_grpd A s))
  : Grpd
≔ @=
    (@TelescopeLocalization_grpd A s)
    (@telescope_localization_inverse A s
      (@telescope_localization_forward A s z))
    z;

symbol telescope_localization_inverse_forward_motive_is_prop
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (z : τ (@TelescopeLocalization_grpd A s))
  : τ (IsPropGrpd
      (@telescope_localization_inverse_forward_motive A s z))
≔ (@telescope_localization_is_set A s)
    (@telescope_localization_inverse A s
      (@telescope_localization_forward A s z))
    z;

symbol telescope_localization_inverse_forward_inc
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@telescope_localization_inverse_forward_motive
      A s (@telescope_localization_inc A s n x))
≔ @telescope_localization_step A s n x;

symbol telescope_localization_inverse_forward_coherence
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (n : τ Nat_grpd)
  (x : τ A)
  : τ (@PathOver
      (@TelescopeLocalization_grpd A s)
      (@telescope_localization_inverse_forward_motive A s)
      (@telescope_localization_inc A s (succ n) (s x))
      (@telescope_localization_inc A s n x)
      (@telescope_localization_step A s n x)
      (@telescope_localization_inverse_forward_inc A s (succ n) (s x))
      (@telescope_localization_inverse_forward_inc A s n x))
≔ @prop_family_pathover
    (@TelescopeLocalization_grpd A s)
    (@telescope_localization_inverse_forward_motive A s)
    (@telescope_localization_inverse_forward_motive_is_prop A s)
    (@telescope_localization_inc A s (succ n) (s x))
    (@telescope_localization_inc A s n x)
    (@telescope_localization_step A s n x)
    (@telescope_localization_inverse_forward_inc A s (succ n) (s x))
    (@telescope_localization_inverse_forward_inc A s n x);

symbol telescope_localization_inverse_forward_point
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  (z : τ (@TelescopeLocalization_grpd A s))
  : τ (@telescope_localization_inverse_forward_motive A s z)
≔ @telescope_localization_ind
    A s
    (@telescope_localization_inverse_forward_motive A s)
    (λ w : τ (@TelescopeLocalization_grpd A s),
      @prop_is_trunc_succ
        trunc_minus_one
        (@telescope_localization_inverse_forward_motive A s w)
        (@telescope_localization_inverse_forward_motive_is_prop A s w))
    (@telescope_localization_inverse_forward_inc A s)
    (@telescope_localization_inverse_forward_coherence A s)
    z;

// Whole equivalence: the localized transition has an executable shift inverse.
symbol telescope_localization_forward_equiv
  [A : Grpd]
  [s : τ (@Function_grpd A A)]
  : τ (@OmegaEquivAlong
      Grpd_cat
      (@TelescopeLocalization_grpd A s)
      (@TelescopeLocalization_grpd A s)
      (@telescope_localization_forward A s))
≔ @omega_equiv_along_intro
    Grpd_cat
    (@TelescopeLocalization_grpd A s)
    (@TelescopeLocalization_grpd A s)
    (@telescope_localization_forward A s)
    (@telescope_localization_inverse A s)
    (@telescope_localization_inverse A s)
    (@PiFunext
      (@TelescopeLocalization_grpd A s)
      (λ _ : τ (@TelescopeLocalization_grpd A s),
        @TelescopeLocalization_grpd A s)
      (@grpd_comp_function
        (@TelescopeLocalization_grpd A s)
        (@TelescopeLocalization_grpd A s)
        (@TelescopeLocalization_grpd A s)
        (@telescope_localization_inverse A s)
        (@telescope_localization_forward A s))
      (@grpd_id_function (@TelescopeLocalization_grpd A s))
      (@telescope_localization_inverse_forward_point A s))
    (@PiFunext
      (@TelescopeLocalization_grpd A s)
      (λ _ : τ (@TelescopeLocalization_grpd A s),
        @TelescopeLocalization_grpd A s)
      (@grpd_comp_function
        (@TelescopeLocalization_grpd A s)
        (@TelescopeLocalization_grpd A s)
        (@TelescopeLocalization_grpd A s)
        (@telescope_localization_forward A s)
        (@telescope_localization_inverse A s))
      (@grpd_id_function (@TelescopeLocalization_grpd A s))
      (@telescope_localization_forward_inverse_point A s));
