@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+stage_root="$(mktemp -d /tmp/emdash-homology-window-warnings.XXXXXX)"
+log_dir="$(pwd)/logs/probes"
+mkdir -p "$stage_root/tmp/probes"
+cp lambdapi.pkg ./*.lp "$stage_root/"
+cp tmp/probes/homology_window_warning_control.lp "$stage_root/tmp/probes/"
+printf 'source-only warning stage: %s\n' "$stage_root"
+cd "$stage_root"
+timeout --signal=INT 90s lambdapi check --no-colors tmp/probes/homology_window_warning_control.lp >"$log_dir/homology-window-baseline-warnings.log" 2>&1
+printf 'baseline warnings checked\n'
+timeout --signal=INT 90s lambdapi check --no-colors emdash3_2_homology_window.lp >"$log_dir/homology-window-candidate-warnings.log" 2>&1
+printf 'candidate warnings checked\n'
