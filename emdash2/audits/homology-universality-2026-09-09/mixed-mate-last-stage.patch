+++ b/emdash2/mixed_mate_cut.lp
@@ -0,0 +1,26 @@
+/* Mixed semantic/stable mate cancellation, then actual whole-H raw entry. */
+require open emdash.emdash3_2_chain_pair_zero_cone_comparisons;
+
+assert [R L : Cat] [F : τ (Functor R L)] [G : τ (Functor L R)]
+  (J : τ (@Adjunction R L F G)) (X : τ (Obj R)) (Y : τ (Obj L))
+  (k : τ (Hom R X (@fapp0 L R G Y))) ⊢
+  @comp_fapp0 R X (@fapp0 L R G (@fapp0 R L F X)) (@fapp0 L R G Y)
+    (@fapp1_fapp0 L R G (@fapp0 R L F X) Y
+      (@fapp0 _ _ (@adjunction_untranspose_func R L F G J X Y) k))
+    (@tapp0_fapp0 R R (@id_func R) (@comp_cat_fapp0 R L R G F) X (@unit_adj_transf R L F G J))
+  ≡ k;
+
+assert [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] [T : τ (@TerminalObject C t)]
+  [W : τ (@HasComputationalKernels C S)]
+  (P : τ (@KernelPresentation C S t T W))
+  [A B D : τ (Obj C)] (pair : τ (@ComputationalChainPair C S A B D)) ⊢
+  @tapp0_fapp0 (@ZeroArrowCone_cat C t T) C
+    (@zero_arrow_cone_first_func C t T)
+    (@kernel_family_func (@ZeroArrowCone_cat C t T) C S t T W P (@zero_arrow_cone_diagram_func C t T))
+    (@chain_pair_zero_cone C S t T W P A B D pair)
+    (@kernel_family_boundary_transf (@ZeroArrowCone_cat C t T) C S t T W P
+      (@zero_arrow_cone_first_func C t T) (@zero_arrow_cone_diagram_func C t T)
+      (@zero_arrow_cone_universal_transf C C1 t T))
+  ≡ @chain_pair_selected_boundary C S W A B D pair;
