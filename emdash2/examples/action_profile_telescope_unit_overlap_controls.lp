require open emdash.emdash3_2_gray_profiles;

assert [A : Cat] (W X Y : τ (Obj A)) [f g : τ (Obj (Hom_cat A X Y))] (alpha : τ (Hom (Hom_cat A X Y) f g)) ⊢ (@comp_fapp0 (Functor_cat (Hom_cat A W X) (Hom_cat A W Y)) (@hom_postcomp_func A A (@id_func A) W X Y f) (@hom_postcomp_func A A (@id_func A) W X Y f) (@hom_postcomp_func A A (@id_func A) W X Y g) (@hom_postcomp_tele_fapp1_fapp0 A A (@id_func A) W X Y f g alpha) (@hom_postcomp_tele_fapp1_fapp0 A A (@id_func A) W X Y f f (@id (Hom_cat A X Y) f))) ≡ (@hom_postcomp_tele_fapp1_fapp0 A A (@id_func A) W X Y f g alpha);

assert [A : Cat] (W X Y : τ (Obj A)) [f g : τ (Obj (Hom_cat A X Y))] (alpha : τ (Hom (Hom_cat A X Y) f g)) ⊢ (@comp_fapp0 (Functor_cat (Hom_cat A W X) (Hom_cat A W Y)) (@hom_postcomp_func A A (@id_func A) W X Y f) (@hom_postcomp_func A A (@id_func A) W X Y g) (@hom_postcomp_func A A (@id_func A) W X Y g) (@hom_postcomp_tele_fapp1_fapp0 A A (@id_func A) W X Y g g (@id (Hom_cat A X Y) g)) (@hom_postcomp_tele_fapp1_fapp0 A A (@id_func A) W X Y f g alpha)) ≡ (@hom_postcomp_tele_fapp1_fapp0 A A (@id_func A) W X Y f g alpha);

assert [A : Cat] (W X Z : τ (Obj A)) [f g : τ (Obj (Hom_cat A W X))] (alpha : τ (Hom (Hom_cat A W X) f g)) ⊢ (@comp_fapp0 (Functor_cat (Hom_cat A X Z) (Hom_cat A W Z)) (@hom_precomp_along_func A A (@id_func A) Z W X f) (@hom_precomp_along_func A A (@id_func A) Z W X f) (@hom_precomp_along_func A A (@id_func A) Z W X g) (@hom_precomp_along_tele_fapp1_fapp0 A A (@id_func A) Z W X f g alpha) (@hom_precomp_along_tele_fapp1_fapp0 A A (@id_func A) Z W X f f (@id (Hom_cat A W X) f))) ≡ (@hom_precomp_along_tele_fapp1_fapp0 A A (@id_func A) Z W X f g alpha);

assert [A : Cat] (W X Z : τ (Obj A)) [f g : τ (Obj (Hom_cat A W X))] (alpha : τ (Hom (Hom_cat A W X) f g)) ⊢ (@comp_fapp0 (Functor_cat (Hom_cat A X Z) (Hom_cat A W Z)) (@hom_precomp_along_func A A (@id_func A) Z W X f) (@hom_precomp_along_func A A (@id_func A) Z W X g) (@hom_precomp_along_func A A (@id_func A) Z W X g) (@hom_precomp_along_tele_fapp1_fapp0 A A (@id_func A) Z W X g g (@id (Hom_cat A W X) g)) (@hom_precomp_along_tele_fapp1_fapp0 A A (@id_func A) Z W X f g alpha)) ≡ (@hom_precomp_along_tele_fapp1_fapp0 A A (@id_func A) Z W X f g alpha);
