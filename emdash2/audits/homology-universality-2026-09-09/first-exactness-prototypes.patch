+        (@comp_fapp0 C A B (@computational_cokernel_object C S A B f Q1) h f) (@preadditive_hom_zero C S A (@computational_cokernel_object C S A B f Q1)))
+      (@computational_cokernel_morphism C S A B f Q1) (@computational_cokernel_annihilation C S A B f Q1)));
+
