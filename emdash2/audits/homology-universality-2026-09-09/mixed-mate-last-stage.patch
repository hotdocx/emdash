+  (KP : τ (@KernelPresentation C (@computational_homology_preadditive C P t PA) t (@additive_terminal_object C P t (@preabelian_additive C P t PA)) (@preabelian_kernels C P t PA)))
+  (QP : τ (@CokernelPresentation C (@computational_homology_preadditive C P t PA) t T0 (@preabelian_cokernels C P t PA)))
+  [A0 B0 D0 A1 B1 D1 A2 B2 D2 A3 B3 D3 : τ (Obj C)]
+  (r0 : τ (@ComputationalShortExactRow C P t PA A0 B0 D0))
+  (r1 : τ (@ComputationalShortExactRow C P t PA A1 B1 D1))
+  (r2 : τ (@ComputationalShortExactRow C P t PA A2 B2 D2))
+  (r3 : τ (@ComputationalShortExactRow C P t PA A3 B3 D3))
+  (F : τ (@ComputationalChainPairMap C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A0 B0 D0 A1 B1 D1 (@computational_short_exact_row_pair C P t PA A0 B0 D0 r0) (@computational_short_exact_row_pair C P t PA A1 B1 D1 r1)))
+  (G : τ (@ComputationalChainPairMap C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A1 B1 D1 A2 B2 D2 (@computational_short_exact_row_pair C P t PA A1 B1 D1 r1) (@computational_short_exact_row_pair C P t PA A2 B2 D2 r2)))
+  (J : τ (@ComputationalChainPairMap C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A2 B2 D2 A3 B3 D3 (@computational_short_exact_row_pair C P t PA A2 B2 D2 r2) (@computational_short_exact_row_pair C P t PA A3 B3 D3 r3)))
+  (upper_zero : τ (@= (Hom C B0 B2) (@comp_fapp0 C B0 B1 B2 (@computational_chain_pair_map_middle C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A1 B1 D1 A2 B2 D2 (@computational_short_exact_row_pair C P t PA A1 B1 D1 r1) (@computational_short_exact_row_pair C P t PA A2 B2 D2 r2) G) (@computational_chain_pair_map_middle C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A0 B0 D0 A1 B1 D1 (@computational_short_exact_row_pair C P t PA A0 B0 D0 r0) (@computational_short_exact_row_pair C P t PA A1 B1 D1 r1) F))
+    (@preadditive_hom_zero C (@additive_preadditive C P t (@preabelian_additive C P t PA)) B0 B2)))
+  (lower_zero : τ (@= (Hom C B1 B3) (@comp_fapp0 C B1 B2 B3 (@computational_chain_pair_map_middle C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A2 B2 D2 A3 B3 D3 (@computational_short_exact_row_pair C P t PA A2 B2 D2 r2) (@computational_short_exact_row_pair C P t PA A3 B3 D3 r3) J) (@computational_chain_pair_map_middle C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A1 B1 D1 A2 B2 D2 (@computational_short_exact_row_pair C P t PA A1 B1 D1 r1) (@computational_short_exact_row_pair C P t PA A2 B2 D2 r2) G)) (@preadditive_hom_zero C (@additive_preadditive C P t (@preabelian_additive C P t PA)) B1 B3)))
+  : τ (Hom C
