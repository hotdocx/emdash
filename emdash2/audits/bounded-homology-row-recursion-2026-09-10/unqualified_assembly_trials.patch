+/* Nat-recursive assembly of the original three exact positions per window. */
+require open emdash.tmp.probes.homology_row_triple_extension;
+
+// Three annotated interiors are prepended by every new four-row window.
+symbol homology_row_span_exact_length (n : τ Nat_grpd) : τ Nat_grpd
+≔ @nat_elim (λ _ : τ Nat_grpd, Nat_grpd) zero
+    (λ _ : τ Nat_grpd, λ m : τ Nat_grpd, succ (succ (succ m))) n;
+
+symbol homology_row_span_exact_tail [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (Ab : τ (@ComputationalAbelianCategory C P t)) (T : τ (@TerminalObject C t))
+  (T0 : τ (@TerminalObject (Op_cat C) t))
+(KP : τ (@KernelPresentation C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t
+    Ab)) t T (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab))))
+(QP : τ (@CokernelPresentation C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t
+    Ab)) t T0 (@preabelian_cokernels C P t (@computational_abelian_preabelian C P t Ab))))
+  (n : τ Nat_grpd) (state : τ (@HomologyRowTriple I C C1 P t (@computational_abelian_preabelian C P t Ab) T))
+  (span : τ (@HomologyRowSpan I C C1 P t (@computational_abelian_preabelian C P t Ab) T n state)) (x : τ (Obj I))
+: τ (@ComputationalExactArrowTail C P t (@computational_abelian_preabelian C P t Ab) (@homology_row_span_exact_length
+    n) (@homology_row_triple_source_homology I C C1 P t (@computational_abelian_preabelian C P t Ab) T T0 KP QP state
+    x) (@homology_row_triple_middle_homology I C C1 P t (@computational_abelian_preabelian C P t Ab) T T0 KP QP state
+    x) (@homology_row_triple_homology_inclusion I C C1 P t (@computational_abelian_preabelian C P t Ab) T T0 KP QP
+    state x))
+≔ (@nat_elim
+    (λ n0 : τ Nat_grpd, @Pi_grpd (@HomologyRowTriple I C C1 P t (@computational_abelian_preabelian C P t Ab) T)
+(λ state : τ (@HomologyRowTriple I C C1 P t (@computational_abelian_preabelian C P t Ab) T), @Pi_grpd
+    (@HomologyRowSpan I C C1 P t (@computational_abelian_preabelian C P t Ab) T n0 state)
+(λ span : τ (@HomologyRowSpan I C C1 P t (@computational_abelian_preabelian C P t Ab) T n0 state), @Pi_grpd (Obj I)
+(λ x : τ (Obj I), (@ComputationalExactArrowTail C P t (@computational_abelian_preabelian C P t Ab)
+    (@homology_row_span_exact_length n0) (@homology_row_triple_source_homology I C C1 P t
+    (@computational_abelian_preabelian C P t Ab) T T0 KP QP state x) (@homology_row_triple_middle_homology I C C1 P t
+    (@computational_abelian_preabelian C P t Ab) T T0 KP QP state x) (@homology_row_triple_homology_inclusion I C C1 P
+    t (@computational_abelian_preabelian C P t Ab) T T0 KP QP state x))))))
+(λ state : τ (@HomologyRowTriple I C C1 P t (@computational_abelian_preabelian C P t Ab) T), λ span : τ
+    (@HomologyRowSpan I C C1 P t (@computational_abelian_preabelian C P t Ab) T zero state), λ x : τ (Obj I),
+      @computational_exact_arrow_tail_nil C P t (@computational_abelian_preabelian C P t Ab)
+(@homology_row_triple_source_homology I C C1 P t (@computational_abelian_preabelian C P t Ab) T T0 KP QP state x)
+    (@homology_row_triple_middle_homology I C C1 P t (@computational_abelian_preabelian C P t Ab) T T0 KP QP state x)
+    (@homology_row_triple_homology_inclusion I C C1 P t (@computational_abelian_preabelian C P t Ab) T T0 KP QP state
+    x))
+    (λ n0 : τ Nat_grpd, λ rec : τ _,
+λ state : τ (@HomologyRowTriple I C C1 P t (@computational_abelian_preabelian C P t Ab) T), λ span : τ
+    (@HomologyRowSpan I C C1 P t (@computational_abelian_preabelian C P t Ab) T (succ n0) state), λ x : τ (Obj I),
+        @homology_row_triple_extend I C C1 P t Ab T T0 KP QP state
+(@homology_row_span_next I C C1 P t (@computational_abelian_preabelian C P t Ab) T n0 state span)
+    (@homology_row_span_map I C C1 P t (@computational_abelian_preabelian C P t Ab) T n0 state span)
+    (@homology_row_span_zero I C C1 P t (@computational_abelian_preabelian C P t Ab) T n0 state span) x
+    (@homology_row_span_exact_length n0)
+(rec (@homology_row_triple_shift I C C1 P t (@computational_abelian_preabelian C P t Ab) T state
+    (@homology_row_span_next I C C1 P t (@computational_abelian_preabelian C P t Ab) T n0 state span)
+    (@homology_row_span_map I C C1 P t (@computational_abelian_preabelian C P t Ab) T n0 state span)
+    (@homology_row_span_zero I C C1 P t (@computational_abelian_preabelian C P t Ab) T n0 state span))
+    (@homology_row_span_rest I C C1 P t (@computational_abelian_preabelian C P t Ab) T n0 state span) x))
+    n) state span x;
