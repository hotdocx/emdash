  (@comp_cat_fapp0 K X Y J A) D)) (Y1 : τ (IsNCat (cat_succ cat_zero) Y)) ⊢ @omega_equiv_along_left_law
  (Functor_cat K Y) (@comma_section_gamma_target_section_op K X Y J A D h) (@comma_section_gamma_target_observed_op K X Y J A
  D h) (@comma_section_gamma_target_extraction_op K X Y J A D h) (@comma_section_gamma_target_extraction_equiv K X Y J A D h
  Y1)
 : τ (@= (Hom (Functor_cat K Y) (@comma_section_gamma_target_section_op K X Y J A D h) (@comma_section_gamma_target_section_op
   K X Y J A D h)) (@comp_fapp0 (Functor_cat K Y) (@comma_section_gamma_target_section_op K X Y J A D h)
