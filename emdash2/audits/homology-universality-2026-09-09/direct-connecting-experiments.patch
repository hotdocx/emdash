@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+stage_root="$(mktemp -d /tmp/emdash-direct-connecting.XXXXXX)"
+log_file="$(pwd)/logs/probes/direct-connecting-staged-$(date +%Y%m%d-%H%M%S).log"
+mkdir -p "$stage_root/tmp/probes"
+cp lambdapi.pkg ./*.lp "$stage_root/"
+targets=(
+  tmp/probes/homology_direct_connecting_cover.lp
+  tmp/probes/homology_direct_connecting_left_lift.lp
+  tmp/probes/homology_direct_connecting_target_cycles.lp
+  tmp/probes/homology_direct_connecting_cover_kernel.lp
+  tmp/probes/homology_direct_connecting_cover_kernel_left.lp
+  tmp/probes/homology_record_boundary_factors.lp
+  tmp/probes/homology_direct_connecting_cover_kernel_boundary.lp
+  tmp/probes/homology_direct_connecting_cycles_descent.lp
+  tmp/probes/homology_direct_connecting_source_boundary_cover_canonical.lp
+  tmp/probes/homology_direct_connecting_source_boundary_zero.lp
+  tmp/probes/homology_direct_connecting_source_boundary_descent.lp
+  tmp/probes/homology_record_connecting.lp
+)
+for file in "${targets[@]}"; do cp "$file" "$stage_root/tmp/probes/"; done
+printf 'stage: %s\nlog: %s\n' "$stage_root" "$log_file"
+cd "$stage_root"
+for file in emdash3_2.lp "${targets[@]}"; do
+  started="$SECONDS"
+  printf 'checking %s\n' "$file"
+  set +e
+  timeout --signal=INT 90s lambdapi check -c --no-colors -w "$file" >>"$log_file" 2>&1
+  rc=$?
+  set -e
+  printf 'finished %s: exit %s, elapsed %ss\n' "$file" "$rc" "$((SECONDS-started))"
+  if [[ "$rc" -ne 0 ]]; then
+    tail -n 16 "$log_file" | cut -c1-260
+    exit "$rc"
+  fi
+done
+
