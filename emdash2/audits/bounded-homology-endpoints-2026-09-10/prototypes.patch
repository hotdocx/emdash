+≔ @finite_arrow_tail_init C Q n
+    (@finite_arrow_tail_next C Q (succ (succ n)) A B f xs)
+    (@finite_arrow_tail_next C Q (succ n) B
+      (@finite_arrow_tail_next C Q (succ (succ n)) A B f xs)
+      (@finite_arrow_tail_arrow C Q (succ (succ n)) A B f xs)
+      (@finite_arrow_tail_rest C Q (succ (succ n)) A B f xs))
+    (@finite_arrow_tail_arrow C Q (succ n) B
+      (@finite_arrow_tail_next C Q (succ (succ n)) A B f xs)
+      (@finite_arrow_tail_arrow C Q (succ (succ n)) A B f xs)
+      (@finite_arrow_tail_rest C Q (succ (succ n)) A B f xs))
+    (@finite_arrow_tail_rest C Q (succ n) B
+      (@finite_arrow_tail_next C Q (succ (succ n)) A B f xs)
+      (@finite_arrow_tail_arrow C Q (succ (succ n)) A B f xs)
+      (@finite_arrow_tail_rest C Q (succ (succ n)) A B f xs));
