+/* Dependent elimination for the original finite row-state record. */
+require open emdash.emdash3_2_homology_row_triples;
+
+symbol homology_row_triple_elim
+  [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) (T : τ (@TerminalObject C t))
+  (Result : τ (@HomologyRowTriple I C C1 P t PA T) → Grpd)
+  (branch :
+    Π R0 : τ (@ShortExactRowFamily I C C1 P t PA T),
+    Π R1 : τ (@ShortExactRowFamily I C C1 P t PA T),
+    Π R2 : τ (@ShortExactRowFamily I C C1 P t PA T),
+    Π f : τ (@Transf I (@ZeroArrowCone_cat C t T)
+      (@short_exact_row_family_func I C C1 P t PA T R0)
+      (@short_exact_row_family_func I C C1 P t PA T R1)),
+    Π g : τ (@Transf I (@ZeroArrowCone_cat C t T)
+      (@short_exact_row_family_func I C C1 P t PA T R1)
+      (@short_exact_row_family_func I C C1 P t PA T R2)),
+    Π z : τ (@RowFamilyMiddleChainZero I C C1 P t PA T R0 R1 R2 f g),
+      τ (Result (@homology_row_triple_intro I C C1 P t PA T R0 R1 R2 f g z)))
+  (state : τ (@HomologyRowTriple I C C1 P t PA T))
+  : τ (Result state);
+rule @homology_row_triple_elim _ _ _ _ _ _ _ _ $branch
+  (@homology_row_triple_intro _ _ _ _ _ _ _ $R0 $R1 $R2 $f $g $z)
+  ↪ $branch $R0 $R1 $R2 $f $g $z;
