  (@terminal_arrow_diagram_func C t T) (@ua4h_source B C C1 t T A D h)) (@ua4h_target B C C1 t T A D h))
≔ @transf_prewhisker B (@ZeroArrowCone_cat C t T) (Functor_cat WalkingArrow_cat C) (@ua4h_gamma B C C1 t T A D h)
