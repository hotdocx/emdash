+assert ⊢ @computational_exact_arrow_step_exact C P t PA A B D f g (@computational_exact_arrow_step_intro C P t PA A B D f g z2 e2) ≡ e2;
+assertnot ⊢ (@computational_exact_arrow_step_intro C P t PA A B D f g z1 e1) ≡ (@computational_exact_arrow_step_intro C P t PA A B D f g z2 e2);
+assertnot ⊢ @computational_exact_arrow_step_intro C P t PA A B D f g z1 z1 : τ (@ComputationalExactArrowStep C P t PA A B D f g);
