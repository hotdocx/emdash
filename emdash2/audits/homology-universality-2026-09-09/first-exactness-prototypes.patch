+      (@comp_fapp0 C T B (@computational_cokernel_object C S A B f Q1) (@computational_cokernel_morphism C S A B f Q1) (@weak_kernel_annihilator_arrow C S B (@computational_cokernel_object C S A B f Q0) (@computational_cokernel_morphism C S A B f Q0) T test)) (@preadditive_hom_zero C S T (@computational_cokernel_object C S A B f Q1)))
+≔ @eq_trans _ _ _ _
