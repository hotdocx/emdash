            "sec:functors",
            "sec:fibrations",
            "thm:transport-compose",
            "sec:compute-sigma",
            "sec:compute-pi"
          ],
          "adaptationType": "conceptual",
          "description": "Reworks the higher-groupoid, functions-as-functors, and families-as-fibrations themes into explicit iterated hom-categories, directed functors, Cat-valued families, total categories, and section categories."
