+assert ⊢ @finite_arrow_tail_init C Q (succ zero) A B f joined ≡ first;
+assert ⊢ @finite_arrow_tail_step C Q zero A B f
+  (@finite_arrow_tail_init C Q (succ zero) A B f joined) ≡ q;
+constant symbol P : τ (Obj C) → Grpd;
