+)
+reviewers=(
+  tmp/probes/homology_row_fields_case_core_checks.lp
+  tmp/probes/homology_row_fields_case_complete_arrows.lp
+  tmp/probes/homology_row_fields_case_overlap_negative.lp
+  tmp/probes/homology_row_fields_case_length_negative.lp
+)
+mkdir -p logs/probes
