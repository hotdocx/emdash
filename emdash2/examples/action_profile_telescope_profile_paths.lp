/* Composition paths under a profile of the actual telescope functor.
   No implication from a profile of F to a profile of its hom action is assumed. */
require open emdash.emdash3_2_profile_action_paths;

symbol api_post_tele_profile_composition_path [A B : Cat] (F : τ (Functor A B)) (W : τ (Obj B)) [X Y : τ (Obj A)] (PT : τ (@IsStrictFunctor (Hom_cat A X Y) (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_tele_func B A F W X Y))) [f g h : τ (Hom A X Y)] (alpha : τ (Hom (Hom_cat A X Y) f g)) (beta : τ (Hom (Hom_cat A X Y) g h))
  : τ (@= (Hom (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y h)) (@comp_fapp0 (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y g) (@hom_postcomp_func B A F W X Y h) (@hom_postcomp_tele_transf B A F W X Y g h beta) (@hom_postcomp_tele_transf B A F W X Y f g alpha)) (@hom_postcomp_tele_transf B A F W X Y f h (@comp_fapp0 (Hom_cat A X Y) f g h beta alpha)))
≔ @eq_sym (Hom (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y h)) (@hom_postcomp_tele_transf B A F W X Y f h (@comp_fapp0 (Hom_cat A X Y) f g h beta alpha)) (@comp_fapp0 (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_func B A F W X Y f) (@hom_postcomp_func B A F W X Y g) (@hom_postcomp_func B A F W X Y h) (@hom_postcomp_tele_transf B A F W X Y g h beta) (@hom_postcomp_tele_transf B A F W X Y f g alpha))
    (@profile_composition_path (Hom_cat A X Y) (Functor_cat (Hom_cat B W (@fapp0 A B F X)) (Hom_cat B W (@fapp0 A B F Y))) (@hom_postcomp_tele_func B A F W X Y) PT f g h beta alpha);

symbol api_pre_tele_profile_composition_path [A B : Cat] (F : τ (Functor A B)) (Z : τ (Obj B)) [W X : τ (Obj A)] (PT : τ (@IsStrictFunctor (Hom_cat A W X) (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_tele_func A B F Z W X))) [f g h : τ (Hom A W X)] (alpha : τ (Hom (Hom_cat A W X) f g)) (beta : τ (Hom (Hom_cat A W X) g h))
  : τ (@= (Hom (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_func A B F Z W X f) (@hom_precomp_along_func A B F Z W X h)) (@comp_fapp0 (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_func A B F Z W X f) (@hom_precomp_along_func A B F Z W X g) (@hom_precomp_along_func A B F Z W X h) (@hom_precomp_along_tele_transf A B F Z W X g h beta) (@hom_precomp_along_tele_transf A B F Z W X f g alpha)) (@hom_precomp_along_tele_transf A B F Z W X f h (@comp_fapp0 (Hom_cat A W X) f g h beta alpha)))
≔ @eq_sym (Hom (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_func A B F Z W X f) (@hom_precomp_along_func A B F Z W X h)) (@hom_precomp_along_tele_transf A B F Z W X f h (@comp_fapp0 (Hom_cat A W X) f g h beta alpha)) (@comp_fapp0 (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_func A B F Z W X f) (@hom_precomp_along_func A B F Z W X g) (@hom_precomp_along_func A B F Z W X h) (@hom_precomp_along_tele_transf A B F Z W X g h beta) (@hom_precomp_along_tele_transf A B F Z W X f g alpha))
    (@profile_composition_path (Hom_cat A W X) (Functor_cat (Hom_cat B (@fapp0 A B F X) Z) (Hom_cat B (@fapp0 A B F W) Z)) (@hom_precomp_along_tele_func A B F Z W X) PT f g h beta alpha);
