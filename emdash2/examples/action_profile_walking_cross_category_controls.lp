/* Two additional category-presentation overlaps in the full combined closure. */
require open emdash.emdash3_2_walking_end_hit;
require open emdash.emdash3_2_direct_cover_sheafification;
require open emdash.emdash3_2_truncation_reflector;

assert [K : Cat] (T : τ (@GrothTopology K)) (x : τ (Obj (@Sheaf_cat K T Cat_cat))) (a : τ (Hom (@Sheaf_cat K T Cat_cat) x x)) [X Y Z : τ (Obj WalkingEnd_cat)] (h : τ (Hom WalkingEnd_cat X Y)) (g : τ (Hom WalkingEnd_cat Y Z)) ⊢ @walking_end_rec_composition_path (@Sheaf_cat K T Cat_cat) x a X Y Z g h
  : τ (@= (Hom (@Sheaf_cat K T Cat_cat) (@fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) X) (@fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) Z)) (@fapp1_fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) X Z (@comp_fapp0 WalkingEnd_cat X Y Z g h)) (@comp_fapp0 (@Sheaf_cat K T Cat_cat) (@fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) X) (@fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) Y) (@fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) Z) (@fapp1_fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) Y Z g) (@fapp1_fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) X Y h)));

assertnot [K : Cat] (T : τ (@GrothTopology K)) (x : τ (Obj (@Sheaf_cat K T Cat_cat))) (a : τ (Hom (@Sheaf_cat K T Cat_cat) x x)) [X Y Z : τ (Obj WalkingEnd_cat)] (h : τ (Hom WalkingEnd_cat X Y)) (g : τ (Hom WalkingEnd_cat Y Z)) ⊢ (@fapp1_fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) X Z (@comp_fapp0 WalkingEnd_cat X Y Z g h)) ≡ (@comp_fapp0 (@Sheaf_cat K T Cat_cat) (@fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) X) (@fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) Y) (@fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) Z) (@fapp1_fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) Y Z g) (@fapp1_fapp0 WalkingEnd_cat (@Sheaf_cat K T Cat_cat) (@walking_end_rec_func (@Sheaf_cat K T Cat_cat) x a) X Y h));

assert (n : TruncLevel) (x : τ (Obj (@NType_cat n))) (a : τ (Hom (@NType_cat n) x x)) [X Y Z : τ (Obj WalkingEnd_cat)] (h : τ (Hom WalkingEnd_cat X Y)) (g : τ (Hom WalkingEnd_cat Y Z)) ⊢ @walking_end_rec_composition_path (@NType_cat n) x a X Y Z g h
  : τ (@= (Hom (@NType_cat n) (@fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) X) (@fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) Z)) (@fapp1_fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) X Z (@comp_fapp0 WalkingEnd_cat X Y Z g h)) (@comp_fapp0 (@NType_cat n) (@fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) X) (@fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) Y) (@fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) Z) (@fapp1_fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) Y Z g) (@fapp1_fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) X Y h)));

assertnot (n : TruncLevel) (x : τ (Obj (@NType_cat n))) (a : τ (Hom (@NType_cat n) x x)) [X Y Z : τ (Obj WalkingEnd_cat)] (h : τ (Hom WalkingEnd_cat X Y)) (g : τ (Hom WalkingEnd_cat Y Z)) ⊢ (@fapp1_fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) X Z (@comp_fapp0 WalkingEnd_cat X Y Z g h)) ≡ (@comp_fapp0 (@NType_cat n) (@fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) X) (@fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) Y) (@fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) Z) (@fapp1_fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) Y Z g) (@fapp1_fapp0 WalkingEnd_cat (@NType_cat n) (@walking_end_rec_func (@NType_cat n) x a) X Y h));
