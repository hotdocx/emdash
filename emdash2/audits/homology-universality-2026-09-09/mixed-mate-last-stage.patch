diff --git a/emdash2/composition_endpoint_alignment.lp b/emdash2/composition_endpoint_alignment.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/composition_endpoint_alignment.lp
@@ -0,0 +1,16 @@
+/* Same-factor endpoint alignment must not identify unrelated factorizations. */
+require open emdash.emdash3_2;
+assert [C : Cat] [a b c d : τ (Obj C)]
+  (f : τ (Hom C a b)) (g : τ (Hom C b c)) (h : τ (Hom C c d)) ⊢
+  eq_refl (@comp_fapp0 C a c d h (@comp_fapp0 C a b c g f))
+  : τ (@= (Hom C a d)
+      (@comp_fapp0 C a c d h (@comp_fapp0 C a b c g f))
+      (@comp_fapp0 C a b d (@comp_fapp0 C b c d h g) f));
+assertnot [C : Cat] [a b c : τ (Obj C)]
+  (f : τ (Hom C a b)) (g h : τ (Hom C b c)) ⊢
+  eq_refl (@comp_fapp0 C a b c g f)
+  : τ (@= (Hom C a c) (@comp_fapp0 C a b c g f) (@comp_fapp0 C a b c h f));
+assertnot [C : Cat] [a b c : τ (Obj C)]
+  (f k : τ (Hom C a b)) (g : τ (Hom C b c)) ⊢
+  eq_refl (@comp_fapp0 C a b c g f)
+  : τ (@= (Hom C a c) (@comp_fapp0 C a b c g f) (@comp_fapp0 C a b c g k));
