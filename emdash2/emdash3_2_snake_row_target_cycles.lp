    (@chain_pair_map_factor_cycle_lift C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A0 A1 A2 B0 B1 B2 (@short_exact_row_chain_source_pair C P t PA A0 B0 D0 A1 B1 D1 A2 B2 D2 r0 r1 r2 F G middle_zero) (@short_exact_row_chain_middle_pair C P t PA A0 B0 D0 A1 B1 D1 A2 B2 D2 r0 r1 r2 F G middle_zero) (@short_exact_row_chain_inclusion C P t PA A0 B0 D0 A1 B1 D1 A2 B2 D2 r0 r1 r2 F G middle_zero) (@computational_short_exact_monic C P t PA A2 B2 D2 (@computational_short_exact_row_pair C P t PA A2 B2 D2 r2) (@computational_short_exact_row_evidence C P t PA A2 B2 D2 r2)) (@abelian_snake_fiber_object C P t (@computational_abelian_category_intro C P t PA M E) A0 B0 B1 D1 (@chain_pair_map_snake_triple C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A0 B0 D0 A1 B1 D1 (@computational_short_exact_row_pair C P t PA A0 B0 D0 r0) (@computational_short_exact_row_pair C P t PA A1 B1 D1 r1) F)) (@abelian_snake_p2 C P t (@computational_abelian_category_intro C P t PA M E) A0 B0 B1 D1 (@chain_pair_map_snake_triple C (@additive_preadditive C P t (@preabelian_additive C P t PA)) A0 B0 D0 A1 B1 D1 (@computational_short_exact_row_pair C P t PA A0 B0 D0 r0) (@computational_short_exact_row_pair C P t PA A1 B1 D1 r1) F)) (@snake_row_target_factor C P t PA M E A0 B0 D0 A1 B1 D1 r0 r1 F) (@computational_homology_cycles C P t PA A0 A1 A2 (@short_exact_row_chain_source_pair C P t PA A0 B0 D0 A1 B1 D1 A2 B2 D2 r0 r1 r2 F G middle_zero) H))
