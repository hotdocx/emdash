+  tmp/probes/homology_row_span_generator.lp
+)
+reviewers=(
+  examples/homology_adjacent_window_tails.lp
+  tmp/probes/homology_row_span_generator_checks.lp
+)
+mkdir -p logs/probes
+log_file="$(pwd)/logs/probes/homology-row-span-generator-${mode}-$(date +%Y%m%d-%H%M%S).log"
+stage_root="$(mktemp -d /tmp/emdash-homology-row-span-generator.XXXXXX)"
+cleanup() {
+  case "$stage_root" in
+    /tmp/emdash-homology-row-span-generator.??????) ;;
+    *) printf 'unexpected temporary path: %s\n' "$stage_root" >&2; return 1 ;;
+  esac
+  local file
+  for file in "$stage_root"/*.lp "$stage_root"/*.lpo \
+      "$stage_root"/*.lpi "$stage_root"/*.lpj "$stage_root"/lambdapi.pkg \
+      "$stage_root"/examples/*.lp "$stage_root"/examples/*.lpo \
+      "$stage_root"/examples/*.lpi "$stage_root"/examples/*.lpj \
