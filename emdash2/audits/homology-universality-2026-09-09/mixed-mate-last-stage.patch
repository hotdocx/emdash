           (@Adjunction_hom_prof_comparison $R $L $F $G $J))) $k)
   ↪ $k;
 
+// Mixed cut: semantic forward mate after the stable inverse mate.
+// Inferred endpoints are not guards; J and its X/Y component discriminate.
+rule @comp_fapp0 _ _ _ _
+    (@fapp1_fapp0 _ _ $G _ $Y
+      (@fapp0 _ _ (@tapp0_fapp0 _ _ _ _ (Struct_sigma $X $Y)
+        (@defiso_from _ _ _ (@Adjunction_hom_prof_comparison $R $L $F $G $J))) $k))
+    (@tapp0_fapp0 _ _ _ _ $X (@unit_adj_transf $R $L $F $G $J))
+  ↪ $k;
+
 // Capture the actual common category; do not reconstruct its Hom endpoints.
 rule @comp_fapp0 Cat_cat $Source _ $Source (@tapp0_fapp0 _ _ _ _ $ab
         (@defiso_from _ _ _
diff --git a/emdash2/emdash3_2_chain_pair_homology_views.lp b/emdash2/emdash3_2_chain_pair_homology_views.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/emdash3_2_chain_pair_homology_views.lp
@@ -0,0 +1,43 @@
+/* Selected and whole views share one original kernel/cokernel selection. */
+require open emdash.emdash3_2_chain_pair_zero_cones;
+require open emdash.emdash3_2_zero_arrow_cone_homology;
+
+symbol chain_pair_selected_homology_object [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (W : τ (@HasComputationalKernels C S)) (V : τ (@HasComputationalCokernels C S))
+  [A B D : τ (Obj C)] (pair : τ (@ComputationalChainPair C S A B D))
+  : τ (Obj C)
+≔ @computational_cokernel_object C S A
+    (@computational_kernel_object C S B D (@computational_chain_pair_d C S A B D pair)
+      (W B D (@computational_chain_pair_d C S A B D pair)))
+    (@chain_pair_selected_boundary C S W A B D pair)
+    (V A (@computational_kernel_object C S B D (@computational_chain_pair_d C S A B D pair)
+      (W B D (@computational_chain_pair_d C S A B D pair)))
+      (@chain_pair_selected_boundary C S W A B D pair));
+
+symbol chain_pair_whole_homology_object [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] [T : τ (@TerminalObject C t)] [T0 : τ (@TerminalObject (Op_cat C) t)]
+  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
+  (P : τ (@KernelPresentation C S t T W)) (Q : τ (@CokernelPresentation C S t T0 V))
+  [A B D : τ (Obj C)] (pair : τ (@ComputationalChainPair C S A B D))
+  : τ (Obj C)
+≔ @fapp0 (@ZeroArrowCone_cat C t T) C
+    (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q)
+    (@chain_pair_zero_cone C S t T W P A B D pair);
+
+// An identity implementation, not transport along an object-equality path.
+symbol chain_pair_whole_homology_arrow [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] [T : τ (@TerminalObject C t)] [T0 : τ (@TerminalObject (Op_cat C) t)]
+  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
+  (P : τ (@KernelPresentation C S t T W)) (Q : τ (@CokernelPresentation C S t T0 V))
+  [A0 B0 D0 A1 B1 D1 : τ (Obj C)]
+  (p0 : τ (@ComputationalChainPair C S A0 B0 D0))
+  (p1 : τ (@ComputationalChainPair C S A1 B1 D1))
+  (f : τ (Hom C
+    (@chain_pair_selected_homology_object C S W V A0 B0 D0 p0)
+    (@chain_pair_selected_homology_object C S W V A1 B1 D1 p1)))
+  : τ (Hom C
+    (@chain_pair_whole_homology_object C S C1 t T T0 W V P Q A0 B0 D0 p0)
+    (@chain_pair_whole_homology_object C S C1 t T T0 W V P Q A1 B1 D1 p1))
+≔ f;
