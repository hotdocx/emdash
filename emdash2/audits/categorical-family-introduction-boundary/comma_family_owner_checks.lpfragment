   h) x (@omega_equiv_along_right_inv (Functor_cat K Y) (@comma_section_gamma_target_section_op K X Y J A D h)
   (@comma_section_gamma_target_observed_op K X Y J A D h) (@comma_section_gamma_target_extraction_op K X Y J A D h)
