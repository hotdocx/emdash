+// NON-LIBRARY polarity experiment: proof-time constant-owner comparisons.
+// These compare the same strict constant family without choosing a runtime
+// fold or equating arbitrary family objects.
+unif_rule @Const_catd $K $A
+  ≡ @Const_func $L Cat_cat $B
+  ↪ [ $K ≡ $L; $A ≡ $B ];
+
+// Postcomposition of an ordinary constant functor, read at the rigid Hom
+// point owner. Its runtime Hom_fapp0 head is preserved.
+unif_rule @Hom_fapp0 Cat_cat $A $A $B $C (@id Cat_cat $A) $F
+      (@Const_func $A $B $b)
+  ≡ @Const_func $A1 $C1 $c
+  ↪ [ $A ≡ $A1; $C ≡ $C1; @fapp0 $B $C $F $b ≡ $c ];
+
+// Reindexing a constant Cat-valued family, read at the same rigid Hom owner.
+unif_rule @Hom_fapp0 Cat_cat $A $B Cat_cat Cat_cat _ (@id Cat_cat Cat_cat)
+      (@Const_catd $A $C)
+  ≡ @Const_catd $B1 $C1
+  ↪ [ $B ≡ $B1; $C ≡ $C1 ];
+
