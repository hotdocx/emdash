+/* Split the already derived native-row chain-zero proof. */
+require open emdash.tmp.probes.homology_source_mono_context;
+symbol native_z (state : τ (@HomologyRowTriple I C C1 P t PA0 T))
+≔ @fapp0 I (@ZeroArrowCone_cat C t T)
+    (@short_exact_row_family_func I C C1 P t PA0 T
+      (@homology_row_triple_row2 I C C1 P t PA0 T state)) x;
+symbol native_a (state : τ (@HomologyRowTriple I C C1 P t PA0 T))
+≔ @fapp0 (@ZeroArrowCone_cat C t T) C
+    (@zero_arrow_cone_first_func C t T) (native_z state);
+symbol native_d (state : τ (@HomologyRowTriple I C C1 P t PA0 T))
+≔ @fapp0 (@ZeroArrowCone_cat C t T) (Functor_cat WalkingArrow_cat C)
+    (@zero_arrow_cone_diagram_func C t T) (native_z state);
+symbol native_h (state : τ (@HomologyRowTriple I C C1 P t PA0 T))
+≔ @tapp0_fapp0 (@ZeroArrowCone_cat C t T) (Functor_cat WalkingArrow_cat C)
+    (@comp_cat_fapp0 (@ZeroArrowCone_cat C t T) C (Functor_cat WalkingArrow_cat C)
+      (@terminal_arrow_diagram_func C t T) (@zero_arrow_cone_first_func C t T))
+    (@zero_arrow_cone_diagram_func C t T) (native_z state)
+    (@zero_arrow_cone_universal_transf C C1 t T);
+symbol native_nat (state : τ (@HomologyRowTriple I C C1 P t PA0 T))
+≔ @terminal_arrow_test_naturality_path C t T
+    (native_a state) (native_d state) (native_h state);
+symbol native_tip_zero (state : τ (@HomologyRowTriple I C C1 P t PA0 T))
+≔ @preadditive_terminal_to_zero_path C S0 t
+    (@fapp0 WalkingArrow_cat C (native_d state) walking_arrow_tgt) T
+    (@terminal_arrow_test_tip C t T (native_a state) (native_d state) (native_h state));
+symbol native_comp_zero (state : τ (@HomologyRowTriple I C C1 P t PA0 T))
+≔ @preadditive_comp_zero_left_path C S0 (native_a state) t
+    (@fapp0 WalkingArrow_cat C (native_d state) walking_arrow_tgt)
+    (@terminal_arrow_fapp0 C t T (native_a state));
