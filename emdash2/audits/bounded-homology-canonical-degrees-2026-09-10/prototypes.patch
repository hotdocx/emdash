+  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
+  (P : τ (@KernelPresentation C S t T W)) (Q : τ (@CokernelPresentation C S t T0 V))
+  [A0 B0 D0 A1 B1 D1 : τ (Obj C)]
+  (p0 : τ (@ComputationalChainPair C S A0 B0 D0))
+  (p1 : τ (@ComputationalChainPair C S A1 B1 D1)) (m : τ (@ComputationalChainPairMap C S A0 B0 D0 A1 B1 D1 p0 p1))
+  : τ (Hom C (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q) (@chain_pair_zero_cone C S
+    t T W P A0 B0 D0 p0)) (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q)
+    (@chain_pair_zero_cone C S t T W P A1 B1 D1 p1)))
+≔ @fapp1_fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q)
+    (@chain_pair_zero_cone C S t T W P A0 B0 D0 p0) (@chain_pair_zero_cone C S t T W P A1 B1 D1 p1)
+    (@chain_pair_zero_cone_map C S C1 t T W P A0 B0 D0 A1 B1 D1 p0 p1 m);
+
+symbol chain_pair_homology_action_direct_path
+  [C : Cat] [S : τ (@PreadditiveCategory C)]
+  (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [t : τ (Obj C)] [T : τ (@TerminalObject C t)] [T0 : τ (@TerminalObject (Op_cat C) t)]
+  [W : τ (@HasComputationalKernels C S)] [V : τ (@HasComputationalCokernels C S)]
+  (P : τ (@KernelPresentation C S t T W)) (Q : τ (@CokernelPresentation C S t T0 V))
+  [A0 B0 D0 A1 B1 D1 : τ (Obj C)]
+  (p0 : τ (@ComputationalChainPair C S A0 B0 D0))
+  (p1 : τ (@ComputationalChainPair C S A1 B1 D1)) (m : τ (@ComputationalChainPairMap C S A0 B0 D0 A1 B1 D1 p0 p1))
+  : τ (@= (Hom C (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q) (@chain_pair_zero_cone C S t T W P A0 B0 D0 p0))
+      (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_homology_func C S C1 t T T0 W V P Q) (@chain_pair_zero_cone C S t T W P A1 B1 D1 p1)))
+    (@chain_pair_homology_action C S C1 t T T0 W V P Q A0 B0 D0 A1 B1 D1 p0 p1 m) (@chain_pair_homology_action_direct C S C1 t T T0 W V P Q A0 B0 D0 A1 B1 D1 p0 p1 m))
+≔ @eq_refl _ (@chain_pair_homology_action C S C1 t T T0 W V P Q A0 B0 D0 A1 B1 D1 p0 p1 m);
