    (@eq_trans (@Transf B C F F) (@sym_transf_tapp0_transf B WalkingArrow_cat C (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@comp_fapp0 (Functor_cat B (Functor_cat WalkingArrow_cat C)) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) h) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@ua3_family_diagram_to B C C1 T1 t J F V h k) (@ua3_family_diagram_from B C C1 T1 t J F V h k)) walking_arrow_src) (@id (Functor_cat B C) F) (@sym_transf_tapp0_transf B WalkingArrow_cat C (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@id (Functor_cat B (Functor_cat WalkingArrow_cat C)) (@transf_arrow_diagram_func B C F (@Const_func B C t) k)) walking_arrow_src)
      (@one_cat_diagram_family_evaluation_comp_path B WalkingArrow_cat C C1 walking_arrow_src
      (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) h) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@ua3_family_diagram_to B C C1 T1 t J F V h k) (@ua3_family_diagram_from B C C1 T1 t J F V h k))
      (@eq_sym (@Transf B C F F) (@sym_transf_tapp0_transf B WalkingArrow_cat C (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@id (Functor_cat B (Functor_cat WalkingArrow_cat C)) (@transf_arrow_diagram_func B C F (@Const_func B C t) k)) walking_arrow_src) (@id (Functor_cat B C) F) (@fapp1_id_path (Functor_cat B (Functor_cat WalkingArrow_cat C)) (Functor_cat B C) (@diagram_family_evaluation_func B WalkingArrow_cat C walking_arrow_src) (@transf_arrow_diagram_func B C F (@Const_func B C t) k))))
    (@eq_trans (@Transf B C (@Const_func B C t) (@Const_func B C t)) (@sym_transf_tapp0_transf B WalkingArrow_cat C (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@comp_fapp0 (Functor_cat B (Functor_cat WalkingArrow_cat C)) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) h) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@ua3_family_diagram_to B C C1 T1 t J F V h k) (@ua3_family_diagram_from B C C1 T1 t J F V h k)) walking_arrow_tgt) (@id (Functor_cat B C) (@Const_func B C t)) (@sym_transf_tapp0_transf B WalkingArrow_cat C (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@id (Functor_cat B (Functor_cat WalkingArrow_cat C)) (@transf_arrow_diagram_func B C F (@Const_func B C t) k)) walking_arrow_tgt)
      (@one_cat_diagram_family_evaluation_comp_path B WalkingArrow_cat C C1 walking_arrow_tgt
      (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) h) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@ua3_family_diagram_to B C C1 T1 t J F V h k) (@ua3_family_diagram_from B C C1 T1 t J F V h k))
      (@eq_sym (@Transf B C (@Const_func B C t) (@Const_func B C t)) (@sym_transf_tapp0_transf B WalkingArrow_cat C (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@transf_arrow_diagram_func B C F (@Const_func B C t) k) (@id (Functor_cat B (Functor_cat WalkingArrow_cat C)) (@transf_arrow_diagram_func B C F (@Const_func B C t) k)) walking_arrow_tgt) (@id (Functor_cat B C) (@Const_func B C t)) (@fapp1_id_path (Functor_cat B (Functor_cat WalkingArrow_cat C)) (Functor_cat B C) (@diagram_family_evaluation_func B WalkingArrow_cat C walking_arrow_tgt) (@transf_arrow_diagram_func B C F (@Const_func B C t) k))));

symbol ua3_family_diagram_iso [B C : Cat]
  (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (T1 : τ (IsNCat (cat_succ cat_zero) Terminal_cat))
  [t : τ (Obj C)] (J : τ (@ua3_TerminalAdjunction C t))
  (F : τ (Functor B C)) (V : τ (Functor B Terminal_cat))
  (h k : τ (@Transf B C F (@Const_func B C t)))
  : τ (IsoEvidence (Functor_cat B (Functor_cat WalkingArrow_cat C)) (@transf_arrow_diagram_func B C F (@Const_func B C t) h) (@transf_arrow_diagram_func B C F (@Const_func B C t) k))
≔ Struct_sigma (@ua3_family_diagram_to B C C1 T1 t J F V h k) (Struct_sigma (@ua3_family_diagram_from B C C1 T1 t J F V h k)
    (Struct_sigma (@ua3_family_diagram_left_law B C C1 T1 t J F V h k)
      (@ua3_family_diagram_right_law B C C1 T1 t J F V h k)));

assert [B C : Cat]
  (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (T1 : τ (IsNCat (cat_succ cat_zero) Terminal_cat))
  [t : τ (Obj C)] (J : τ (@ua3_TerminalAdjunction C t))
  (F : τ (Functor B C)) (V : τ (Functor B Terminal_cat))
  (h k : τ (@Transf B C F (@Const_func B C t))) ⊢
  @iso_evidence_to (Functor_cat B (Functor_cat WalkingArrow_cat C)) (@transf_arrow_diagram_func B C F (@Const_func B C t) h) (@transf_arrow_diagram_func B C F (@Const_func B C t) k)
    (@ua3_family_diagram_iso B C C1 T1 t J F V h k) ≡ (@ua3_family_diagram_to B C C1 T1 t J F V h k);

assert [B C : Cat]
  (C1 : τ (IsNCat (cat_succ cat_zero) C))
  (T1 : τ (IsNCat (cat_succ cat_zero) Terminal_cat))
  [t : τ (Obj C)] (J : τ (@ua3_TerminalAdjunction C t))
  (F : τ (Functor B C)) (V : τ (Functor B Terminal_cat))
  (h k : τ (@Transf B C F (@Const_func B C t))) ⊢
  @iso_evidence_from (Functor_cat B (Functor_cat WalkingArrow_cat C)) (@transf_arrow_diagram_func B C F (@Const_func B C t) h) (@transf_arrow_diagram_func B C F (@Const_func B C t) k)
    (@ua3_family_diagram_iso B C C1 T1 t J F V h k) ≡ (@ua3_family_diagram_from B C C1 T1 t J F V h k);
