+symbol finite_arrow_tail_last_source [C : Cat] (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C), τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (xs : τ (@FiniteArrowTail C Q n A B f)) : τ (Obj C)
