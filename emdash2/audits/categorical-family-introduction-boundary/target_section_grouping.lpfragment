// Whole grouping observations for the actual native graph section.
// Append after the UA-4e replay; this does not yet classify the section as D.

symbol ua4f_graph_section_stage1 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor
  K Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor (Op_cat K) (Op_cat Y))
≔ @section_postcomp_sec (Op_cat K) (@gray_transf_graph_middle_catd K Y (@comp_cat_fapp0 K X Y J A) D)
  (@Const_catd (Op_cat K) (Op_cat Y)) (@comp_catd_fapp0 (Op_cat K) (@gray_transf_graph_middle_catd K Y
  (@comp_cat_fapp0 K X Y J A) D) (@represented_comma_family_target K X Y J A) (@Const_catd (Op_cat K)
  (Op_cat Y)) (@ua4d_gamma_target_section_map K X Y J A) (@gray_transf_graph_basechange_op_funcd K Y
  (@comp_cat_fapp0 K X Y J A) D)) (@gray_transf_graph_middle_sec K Y (@comp_cat_fapp0 K X Y J A) D h);
symbol ua4f_graph_section_stage2 [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor
  K Y)) (h : τ (@Transf K Y (@comp_cat_fapp0 K X Y J A) D)) : τ (Functor (Op_cat K) (Op_cat Y))
≔ @section_postcomp_sec (Op_cat K) (@gray_transf_graph_source_catd K) (@Const_catd (Op_cat K) (Op_cat Y))
  (@comp_catd_fapp0 (Op_cat K) (@gray_transf_graph_source_catd K) (@gray_transf_graph_middle_catd K Y
  (@comp_cat_fapp0 K X Y J A) D) (@Const_catd (Op_cat K) (Op_cat Y)) (@comp_catd_fapp0 (Op_cat K)
  (@gray_transf_graph_middle_catd K Y (@comp_cat_fapp0 K X Y J A) D) (@represented_comma_family_target K X
  Y J A) (@Const_catd (Op_cat K) (Op_cat Y)) (@ua4d_gamma_target_section_map K X Y J A)
  (@gray_transf_graph_basechange_op_funcd K Y (@comp_cat_fapp0 K X Y J A) D))
  (@gray_transf_graph_sigma_op_funcd K Y (@comp_cat_fapp0 K X Y J A) D h)) (@hom_identity_graph_sec K);

assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) ⊢
 @eq_refl (Functor (Op_cat K) (Op_cat Y)) (@ua4d_gamma_target_section K X Y J A D h)
 : τ (@= (Functor (Op_cat K) (Op_cat Y)) (@ua4d_gamma_target_section K X Y J A D h)
     (@ua4f_graph_section_stage1 K X Y J A D h));
assert [K X Y : Cat] (J : τ (Functor X Y)) (A : τ (Functor K X)) (D : τ (Functor K Y)) (h : τ (@Transf K Y
  (@comp_cat_fapp0 K X Y J A) D)) ⊢
 @eq_refl (Functor (Op_cat K) (Op_cat Y)) (@ua4f_graph_section_stage1 K X Y J A D h)
 : τ (@= (Functor (Op_cat K) (Op_cat Y)) (@ua4f_graph_section_stage1 K X Y J A D h)
     (@ua4f_graph_section_stage2 K X Y J A D h));
