+  (KP : τ (@KernelPresentation C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) t T (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab))))
+  (T0 : τ (@TerminalObject (Op_cat C) t))
+  (QP : τ (@CokernelPresentation C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) t T0 (@preabelian_cokernels C P t (@computational_abelian_preabelian C P t Ab))))
+  (window : τ (@HomologyWindowFamily I C C1 P t (@computational_abelian_preabelian C P t Ab) T))
+  : τ (@Transf I C (@homology_window_source_homology_func I C C1 P t Ab T KP T0 QP window) (@homology_window_target_homology_func I C C1 P t Ab T KP T0 QP window));
+
+rule @tapp0_fapp0 _ _ _ _ $x
+  (@homology_window_connecting_transf $I $C $C1 $P $t $Ab $T $KP $T0 $QP $w)
+  ↪ @homology_window_connecting_at $I $C $C1 $P $t $Ab $T $KP $T0 $QP $w $x;
