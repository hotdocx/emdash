+/* Symbolic finite row data; every window uses overlapping original indices. */
+require open emdash.tmp.probes.homology_finite_row_lookup;
+require open emdash.emdash3_2_homology_window_connecting_transformation;
+
+constant symbol I : Cat;
+constant symbol C : Cat;
+constant symbol C1 : τ (IsNCat (cat_succ cat_zero) C);
+constant symbol P : τ (Functor (Product_cat C C) C);
+constant symbol t : τ (Obj C);
+constant symbol Add : τ (@AdditiveCategory C P t);
+constant symbol K : τ (@HasComputationalKernels C (@additive_preadditive C P t Add));
+constant symbol V : τ (@HasComputationalCokernels C (@additive_preadditive C P t Add));
+symbol PA : τ (@PreAbelianCategory C P t)
+≔ @preabelian_category_intro C P t Add K V;
+constant symbol Mono : τ (@HasLiftsAlongMonomorphisms C
+  (@additive_preadditive C P t Add) V);
+constant symbol Epi : τ (@HasColiftsAlongEpimorphisms C
+  (@additive_preadditive C P t Add) K);
+symbol Ab : τ (@ComputationalAbelianCategory C P t)
+≔ @computational_abelian_category_intro C P t PA Mono Epi;
+constant symbol T : τ (@TerminalObject C t);
+constant symbol T0 : τ (@TerminalObject (Op_cat C) t);
+constant symbol KP : τ (@KernelPresentation C
+  (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab))
+  t T (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab)));
+constant symbol QP : τ (@CokernelPresentation C
+  (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab))
+  t T0 (@preabelian_cokernels C P t (@computational_abelian_preabelian C P t Ab)));
+constant symbol n : τ Nat_grpd;
+constant symbol rows : τ (FiniteDegree (succ (succ (succ n)))) →
+  τ (@ShortExactRowFamily I C C1 P t (@computational_abelian_preabelian C P t Ab) T);
+constant symbol maps : Π j : τ (FiniteDegree (succ (succ n))),
+  τ (@Transf I (@ZeroArrowCone_cat C t T)
+    (@short_exact_row_family_func I C C1 P t (@computational_abelian_preabelian C P t Ab)
+      T (rows (@finite_degree_weaken (succ (succ n)) j)))
+    (@short_exact_row_family_func I C C1 P t (@computational_abelian_preabelian C P t Ab)
+      T (rows (finite_degree_next (succ (succ n)) j))));
+constant symbol zeros : Π j : τ (FiniteDegree (succ n)),
+  τ (@RowFamilyMiddleChainZero I C C1 P t (@computational_abelian_preabelian C P t Ab) T
+    (rows (@finite_degree_weaken (succ (succ n))
+      (@finite_degree_weaken (succ n) j)))
+    (rows (finite_degree_next (succ (succ n))
+      (@finite_degree_weaken (succ n) j)))
+    (rows (finite_degree_next (succ (succ n))
+      (finite_degree_next (succ n) j)))
+    (maps (@finite_degree_weaken (succ n) j))
+    (maps (finite_degree_next (succ n) j)));
+constant symbol j : τ (FiniteDegree n);
+constant symbol x : τ (Obj I);
+constant symbol y : τ (Obj I);
+
+symbol window (k : τ (FiniteDegree n)) : τ (@HomologyWindowFamily I C C1 P t
+  (@computational_abelian_preabelian C P t Ab) T)
+≔ @homology_finite_row_window I C C1 P t
+  (@computational_abelian_preabelian C P t Ab) T n rows maps zeros k;
+
+symbol next_state (k : τ (FiniteDegree n))
+≔ @homology_finite_row_triple I C C1 P t
+  (@computational_abelian_preabelian C P t Ab) T (succ n)
+  rows maps zeros (finite_degree_next n k);
+
+// Lower triple and upper lookup share actual data, not an equality glue input.
+assert ⊢ @homology_window_family_row0 I C C1 P t
+  (@computational_abelian_preabelian C P t Ab) T (window j)
+  ≡ @homology_row_triple_row0 I C C1 P t
+    (@computational_abelian_preabelian C P t Ab) T (next_state j);
+assert ⊢ @homology_window_family_G I C C1 P t
+  (@computational_abelian_preabelian C P t Ab) T (window j)
+  ≡ @homology_row_triple_first I C C1 P t
+    (@computational_abelian_preabelian C P t Ab) T (next_state j);
+assert ⊢ @homology_window_family_lower_zero I C C1 P t
+  (@computational_abelian_preabelian C P t Ab) T (window j)
+  ≡ zeros (finite_degree_next n j);
+
+// Direct whole H endpoints of the first and last connecting arrows.
+symbol first_HC : τ (Functor I C)
+≔ @homology_window_source_homology_func I C C1 P t Ab T KP T0 QP
+    (window (finite_degree_first n));
+symbol last_HA : τ (Functor I C)
+≔ @homology_window_target_homology_func I C C1 P t Ab T KP T0 QP
+    (window (finite_degree_last n));
+symbol last_delta
+≔ @homology_window_connecting_transf I C C1 P t Ab T KP T0 QP
+    (window (finite_degree_last n));
+assert ⊢ @tapp0_fapp0 I C _ last_HA x last_delta
+  : τ (Hom C
+    (@fapp0 I C (@homology_window_source_homology_func I C C1 P t Ab T KP T0 QP
+      (window (finite_degree_last n))) x)
+    (@fapp0 I C last_HA x));
