// catalog-area: Whole product-family reindex views
require open emdash.emdash3_2_product_diagonal_reindex_views;

assert [K B C : Cat] (Prod : τ (Functor (Product_cat C C) C)) (Q : τ (Functor B C)) (H : τ (Functor K B)) ⊢ @eq_refl (Functor K C) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) : τ (@= (Functor K C) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) (@comp_fapp0 Cat_cat K (Product_cat C C) C Prod (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) K C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat K B C Q H))));
assertnot [K B C : Cat] (Prod : τ (Functor (Product_cat C C) C)) (Q : τ (Functor B C)) (H : τ (Functor K B)) ⊢ (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) ≡ (@comp_fapp0 Cat_cat K (Product_cat C C) C Prod (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) K C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat K B C Q H)));
assertnot [K B C : Cat] (Prod : τ (Functor (Product_cat C C) C)) (Q : τ (Functor B C)) (H : τ (Functor K B)) (Prod2 : τ (Functor (Product_cat C C) C)) ⊢ @eq_refl (Functor K C) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) : τ (@= (Functor K C) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) (@comp_fapp0 Cat_cat K (Product_cat C C) C Prod2 (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) K C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat K B C Q H))));
assertnot [K B C : Cat] (Prod : τ (Functor (Product_cat C C) C)) (Q : τ (Functor B C)) (H : τ (Functor K B)) (Q2 : τ (Functor B C)) ⊢ @eq_refl (Functor K C) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) : τ (@= (Functor K C) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) (@comp_fapp0 Cat_cat K (Product_cat C C) C Prod (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) K C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat K B C Q2 H))));
assertnot [K B C : Cat] (Prod : τ (Functor (Product_cat C C) C)) (Q : τ (Functor B C)) (H : τ (Functor K B)) (H2 : τ (Functor K B)) ⊢ @eq_refl (Functor K C) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) : τ (@= (Functor K C) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) (@comp_fapp0 Cat_cat K (Product_cat C C) C Prod (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) K C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat K B C Q H2))));

assert [K C : Cat] (Prod : τ (Functor (Product_cat C C) C)) (H : τ (Functor K C)) ⊢ @product_diagonal_composition_path K C C Prod (@id_func C) H : τ (@= (Functor K C) (@comp_fapp0 Cat_cat K C C (@comp_fapp0 Cat_cat C C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) (@id_func C)) H) (@comp_fapp0 Cat_cat K (Product_cat C C) C Prod (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) K C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat K C C (@id_func C) H))));

assert [B C : Cat] (Prod : τ (Functor (Product_cat C C) C)) (Q : τ (Functor B C)) ⊢ @product_diagonal_composition_path B B C Prod Q (@id_func B) : τ (@= (Functor B C) (@comp_fapp0 Cat_cat B B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) (@id_func B)) (@comp_fapp0 Cat_cat B (Product_cat C C) C Prod (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) B C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat B B C Q (@id_func B)))));

// Equality of complete functors retains their dependent next-Hom action.
assert [K B C : Cat] (Prod : τ (Functor (Product_cat C C) C)) (Q : τ (Functor B C)) (H : τ (Functor K B)) (x y : τ (Obj K)) ⊢
  @eq_apd (Functor K C) (λ F : τ (Functor K C), Functor (Hom_cat K x y) (Hom_cat C (@fapp0 K C F x) (@fapp0 K C F y))) (λ F : τ (Functor K C), @fapp1_func K C F x y) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) (@comp_fapp0 Cat_cat K (Product_cat C C) C Prod (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) K C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat K B C Q H))) (@product_diagonal_composition_path K B C Prod Q H)
  : τ (@PathOver (Functor K C) (λ F : τ (Functor K C), Functor (Hom_cat K x y) (Hom_cat C (@fapp0 K C F x) (@fapp0 K C F y))) (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) (@comp_fapp0 Cat_cat K (Product_cat C C) C Prod (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) K C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat K B C Q H))) (@product_diagonal_composition_path K B C Prod Q H)
      (@fapp1_func K C (@comp_fapp0 Cat_cat K B C (@comp_fapp0 Cat_cat B C C (@comp_fapp0 Cat_cat C (Product_cat C C) C Prod (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C))) Q) H) x y) (@fapp1_func K C (@comp_fapp0 Cat_cat K (Product_cat C C) C Prod (@hom_postcomp_fapp0 Cat_cat Cat_cat (@id_func Cat_cat) K C (Product_cat C C) (@Struct_sigma (Functor C C) (λ _ : τ (Functor C C), Functor C C) (@id_func C) (@id_func C)) (@comp_fapp0 Cat_cat K B C Q H))) x y));

// Independent ambient strictness boundaries remain unchanged.
assertnot [A B : Cat] (F : τ (Functor A B)) [x y z : τ (Obj A)]
  (f : τ (Hom A x y)) (g : τ (Hom A y z)) ⊢
  @eq_refl (Hom B (@fapp0 A B F x) (@fapp0 A B F z))
    (@fapp1_fapp0 A B F x z (@comp_fapp0 A x y z g f))
  : τ (@= (Hom B (@fapp0 A B F x) (@fapp0 A B F z))
      (@fapp1_fapp0 A B F x z (@comp_fapp0 A x y z g f))
      (@comp_fapp0 B _ _ _ (@fapp1_fapp0 A B F y z g) (@fapp1_fapp0 A B F x y f)));

assertnot [A B : Cat] [F G : τ (Functor A B)] (eta : τ (@Transf A B F G))
  [x y : τ (Obj A)] (f : τ (Hom A x y)) ⊢
  @eq_refl (Hom B (@fapp0 A B F x) (@fapp0 A B G y))
    (@comp_fapp0 B _ _ _ (@fapp1_fapp0 A B G x y f) (@tapp0_fapp0 A B F G x eta))
  : τ (@= (Hom B (@fapp0 A B F x) (@fapp0 A B G y))
    (@comp_fapp0 B _ _ _ (@fapp1_fapp0 A B G x y f) (@tapp0_fapp0 A B F G x eta))
    (@comp_fapp0 B _ _ _ (@tapp0_fapp0 A B F G y eta) (@fapp1_fapp0 A B F x y f)));
