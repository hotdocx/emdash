// Ordinary caller shapes, including composition, identity and provider choices.
assert [C : Cat] [t : τ (Obj C)] (T : τ (@TerminalObject C t))
  (A : τ (Obj C)) (f : τ (Hom C A t)) ⊢
  @eq_refl (Hom C A t) f : τ (@= (Hom C A t) f (@terminal_arrow_fapp0 C t T A));
assert [C : Cat] [t : τ (Obj C)] (T : τ (@TerminalObject C t))
  (A B : τ (Obj C)) (f : τ (Hom C B t)) (g : τ (Hom C A B)) ⊢
  @eq_refl (Hom C A t) (@comp_fapp0 C A B t f g)
  : τ (@= (Hom C A t) (@comp_fapp0 C A B t f g) (@terminal_arrow_fapp0 C t T A));
assert [C : Cat] [t : τ (Obj C)] (T : τ (@TerminalObject C t)) ⊢
  @eq_refl (Hom C t t) (@id C t)
  : τ (@= (Hom C t t) (@id C t) (@terminal_arrow_fapp0 C t T t));
assert [C : Cat] [t : τ (Obj C)] (T U : τ (@TerminalObject C t)) (A : τ (Obj C)) ⊢
  @eq_refl (Hom C A t) (@terminal_arrow_fapp0 C t T A)
  : τ (@= (Hom C A t) (@terminal_arrow_fapp0 C t T A) (@terminal_arrow_fapp0 C t U A));
// Inference retains the source endpoint when that argument is omitted.
assert [C : Cat] [t : τ (Obj C)] (T : τ (@TerminalObject C t))
  (A : τ (Obj C)) (f : τ (Hom C A t)) ⊢
  @eq_refl (Hom C A t) f : τ (@= (Hom C A t) f (@terminal_arrow_fapp0 C t T _));
// No runtime collapse or equality of unrelated arbitrary arrows is installed.
assertnot [C : Cat] [t : τ (Obj C)] (T : τ (@TerminalObject C t))
  (A : τ (Obj C)) (f : τ (Hom C A t)) ⊢ f ≡ @terminal_arrow_fapp0 C t T A;
assertnot [C : Cat] (A B : τ (Obj C)) (f g : τ (Hom C A B)) ⊢
  @eq_refl (Hom C A B) f : τ (@= (Hom C A B) f g);
