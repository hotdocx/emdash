@@ -0,0 +1,36 @@
+/* The middle arrows and their original annotation survive boundary trimming. */
+require open emdash.tmp.probes.finite_arrow_tail_trim_boundary;
+constant symbol C : Cat;
+constant symbol Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C),
+  τ (Hom C A B) → τ (Hom C B D) → Grpd;
+constant symbol A : τ (Obj C);
+constant symbol B : τ (Obj C);
+constant symbol D : τ (Obj C);
+constant symbol E : τ (Obj C);
+constant symbol F : τ (Obj C);
+constant symbol G : τ (Obj C);
+constant symbol f : τ (Hom C A B);
+constant symbol g : τ (Hom C B D);
+constant symbol h : τ (Hom C D E);
+constant symbol k : τ (Hom C E F);
+constant symbol l : τ (Hom C F G);
+constant symbol q0 : τ (Q A B D f g);
+constant symbol q1 : τ (Q B D E g h);
+constant symbol q2 : τ (Q D E F h k);
+constant symbol q2_other : τ (Q D E F h k);
+constant symbol q3 : τ (Q E F G k l);
+symbol one ≔ succ zero;
+symbol two ≔ succ one;
+symbol three ≔ succ two;
+symbol end_tail ≔ @finite_arrow_tail_nil C Q F G l;
+symbol tail3 ≔ @finite_arrow_tail_cons C Q zero E F k G l q3 end_tail;
+symbol tail2 ≔ @finite_arrow_tail_cons C Q one D E h F k q2 tail3;
+symbol tail1 ≔ @finite_arrow_tail_cons C Q two B D g E h q1 tail2;
+symbol tail0 ≔ @finite_arrow_tail_cons C Q three A B f D g q0 tail1;
+symbol clipped ≔ @finite_arrow_tail_trim_boundary C Q one A B f tail0;
+assert ⊢ clipped : τ (@FiniteArrowTail C Q one D E h);
+assert ⊢ clipped ≡ @finite_arrow_tail_cons C Q zero D E h F k q2
+  (@finite_arrow_tail_nil C Q E F k);
+assert ⊢ @finite_arrow_tail_step C Q zero D E h clipped ≡ q2;
+assert ⊢ @finite_arrow_tail_last_target C Q one D E h clipped ≡ F;
+assertnot ⊢ @finite_arrow_tail_step C Q zero D E h clipped ≡ q2_other;
