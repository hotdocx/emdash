@@ -0,0 +1,37 @@
+/* Observations at the exact-tail type presentation already returned by cons. */
+require open emdash.tmp.probes.computational_exact_arrow_tails;
+
+symbol computational_exact_arrow_tail_next
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) [n : τ Nat_grpd]
+  [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (tail : τ (@ComputationalExactArrowTail C P t PA (succ n) A B f)) : τ (Obj C)
+≔ @finite_arrow_tail_next C (@ComputationalExactArrowStep C P t PA) n A B f tail;
+
+symbol computational_exact_arrow_tail_arrow
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) [n : τ Nat_grpd]
+  [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (tail : τ (@ComputationalExactArrowTail C P t PA (succ n) A B f))
+  : τ (Hom C B (@computational_exact_arrow_tail_next C P t PA n A B f tail))
+≔ @finite_arrow_tail_arrow C (@ComputationalExactArrowStep C P t PA) n A B f tail;
+
+symbol computational_exact_arrow_tail_step
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) [n : τ Nat_grpd]
+  [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (tail : τ (@ComputationalExactArrowTail C P t PA (succ n) A B f))
+  : τ (@ComputationalExactArrowStep C P t PA A B
+    (@computational_exact_arrow_tail_next C P t PA n A B f tail) f
+    (@computational_exact_arrow_tail_arrow C P t PA n A B f tail))
+≔ @finite_arrow_tail_step C (@ComputationalExactArrowStep C P t PA) n A B f tail;
+
+symbol computational_exact_arrow_tail_rest
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) [n : τ Nat_grpd]
+  [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (tail : τ (@ComputationalExactArrowTail C P t PA (succ n) A B f))
+  : τ (@ComputationalExactArrowTail C P t PA n B
+    (@computational_exact_arrow_tail_next C P t PA n A B f tail)
+    (@computational_exact_arrow_tail_arrow C P t PA n A B f tail))
+≔ @finite_arrow_tail_rest C (@ComputationalExactArrowStep C P t PA) n A B f tail;
diff --git a/emdash2/tmp/probes/computational_exact_arrow_tails.lp b/emdash2/tmp/probes/computational_exact_arrow_tails.lp
new file mode 100644
--- /dev/null
+++ b/emdash2/tmp/probes/computational_exact_arrow_tails.lp
@@ -0,0 +1,80 @@
+/* Exact-result annotations on the original adjacent arrows. */
+require open emdash.emdash3_2_short_exact_sequences;
+require open emdash.tmp.probes.finite_arrow_tails;
+
+symbol ComputationalExactArrowStep
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  (A B D : τ (Obj C)) (f : τ (Hom C A B)) (g : τ (Hom C B D)) : Grpd
+≔ @Σ_ (@= (Hom C A D) (@comp_fapp0 C A B D g f)
+      (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) A D))
+    (λ z : τ (@= (Hom C A D) (@comp_fapp0 C A B D g f)
+      (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) A D)),
+      @computational_exact_at_selected C P t PA A B D
+        (@computational_chain_pair_intro C (@computational_homology_preadditive C P t PA) A B D f g z));
+
+symbol computational_exact_arrow_step_of_pair
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) [A B D : τ (Obj C)]
+  (pair : τ (@ComputationalChainPair C (@computational_homology_preadditive C P t PA) A B D))
+  (exact : τ (@computational_exact_at_selected C P t PA A B D pair))
+  : τ (@ComputationalExactArrowStep C P t PA A B D
+      (@computational_chain_pair_dnext C (@computational_homology_preadditive C P t PA) A B D pair)
+      (@computational_chain_pair_d C (@computational_homology_preadditive C P t PA) A B D pair))
+≔ @Struct_sigma
+    (@= (Hom C A D)
+      (@comp_fapp0 C A B D
+        (@computational_chain_pair_d C (@computational_homology_preadditive C P t PA) A B D pair)
+        (@computational_chain_pair_dnext C (@computational_homology_preadditive C P t PA) A B D pair))
+      (@preadditive_hom_zero C (@computational_homology_preadditive C P t PA) A D))
+    (λ z : τ _, @computational_exact_at_selected C P t PA A B D
+      (@computational_chain_pair_intro C (@computational_homology_preadditive C P t PA) A B D
+        (@computational_chain_pair_dnext C (@computational_homology_preadditive C P t PA) A B D pair)
+        (@computational_chain_pair_d C (@computational_homology_preadditive C P t PA) A B D pair) z))
+    (@computational_chain_pair_path C (@computational_homology_preadditive C P t PA) A B D pair)
+    exact;
+
+symbol computational_exact_arrow_step_pair
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  [A B D : τ (Obj C)] [f : τ (Hom C A B)] [g : τ (Hom C B D)]
+  (step : τ (@ComputationalExactArrowStep C P t PA A B D f g))
+  : τ (@ComputationalChainPair C (@computational_homology_preadditive C P t PA) A B D)
+≔ @computational_chain_pair_intro C (@computational_homology_preadditive C P t PA) A B D f g (sigma_Fst step);
+
+symbol computational_exact_arrow_step_exact
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  [A B D : τ (Obj C)] [f : τ (Hom C A B)] [g : τ (Hom C B D)]
+  (step : τ (@ComputationalExactArrowStep C P t PA A B D f g))
+  : τ (@computational_exact_at_selected C P t PA A B D
+    (@computational_exact_arrow_step_pair C P t PA A B D f g step))
+≔ sigma_Snd step;
+
+symbol ComputationalExactArrowTail
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  (n : τ Nat_grpd) (A B : τ (Obj C)) (f : τ (Hom C A B)) : Grpd
+≔ @FiniteArrowTail C (@ComputationalExactArrowStep C P t PA) n A B f;
+
+symbol computational_exact_arrow_tail_nil
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t))
+  [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  : τ (@ComputationalExactArrowTail C P t PA zero A B f)
+≔ @finite_arrow_tail_nil C (@ComputationalExactArrowStep C P t PA) A B f;
+
+// Reuse the original pair and its exactness, sharing its outgoing arrow with rest.
+symbol computational_exact_arrow_tail_cons_pair
+  [C : Cat] [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (PA : τ (@PreAbelianCategory C P t)) [n : τ Nat_grpd] [A B D : τ (Obj C)]
+  (pair : τ (@ComputationalChainPair C (@computational_homology_preadditive C P t PA) A B D))
+  (exact : τ (@computational_exact_at_selected C P t PA A B D pair))
+  (rest : τ (@ComputationalExactArrowTail C P t PA n B D
+    (@computational_chain_pair_d C (@computational_homology_preadditive C P t PA) A B D pair)))
+  : τ (@ComputationalExactArrowTail C P t PA (succ n) A B
+    (@computational_chain_pair_dnext C (@computational_homology_preadditive C P t PA) A B D pair))
+≔ @finite_arrow_tail_cons C (@ComputationalExactArrowStep C P t PA) n A B
+    (@computational_chain_pair_dnext C (@computational_homology_preadditive C P t PA) A B D pair)
+    D (@computational_chain_pair_d C (@computational_homology_preadditive C P t PA) A B D pair)
+    (@computational_exact_arrow_step_of_pair C P t PA A B D pair exact) rest;
diff --git a/emdash2/tmp/probes/computational_exact_arrow_tails_stable.lp b/emdash2/tmp/probes/computational_exact_arrow_tails_stable.lp
