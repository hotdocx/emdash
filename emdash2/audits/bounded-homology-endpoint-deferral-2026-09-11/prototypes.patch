@@ -0,0 +1,22 @@
+/* Congruence is sufficient, not injectivity; budget exhaustion must fall back. */
+constant symbol T : TYPE;
+constant symbol a : T;
+constant symbol b : T;
+symbol erase : T → T;
+rule erase _ ↪ a;
+symbol f : T → T;
+symbol g : T → T;
+rule g $x ↪ f $x;
+assert ⊢ erase a ≡ erase b;
+assertnot ⊢ f a ≡ f b;
+assert ⊢ g a ≡ f a;
+constant symbol Pair : TYPE;
+constant symbol pair : T → T → Pair;
+symbol first : Pair → T;
+rule first (pair $x _) ↪ $x;
+assert ⊢ first (pair a a) ≡ first (pair a b);
+assertnot ⊢ first (pair a b) ≡ b;
+symbol same : T → T → T;
+rule same $x $x ↪ a;
+assert ⊢ same (erase b) a ≡ a;
+assertnot ⊢ same a b ≡ a;
