--- /dev/null
+++ b/emdash2/tmp/probes/check_second_exactness_prototypes.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+stage_root="$(mktemp -d /tmp/emdash-second-exactness.XXXXXX)"
+log_file="$(pwd)/logs/probes/second-exactness-staged-$(date +%Y%m%d-%H%M%S).log"
+mkdir -p "$stage_root/tmp/probes"
+cp lambdapi.pkg ./*.lp "$stage_root/"
+targets=(
+ tmp/probes/homology_epic_presentation_cover.lp
+ tmp/probes/homology_epic_presentation_cover_views.lp
+ tmp/probes/homology_connecting_epic_presentation.lp
+ tmp/probes/homology_second_correction.lp
+ tmp/probes/homology_second_corrected_cycle.lp
+ tmp/probes/homology_second_corrected_projection.lp
+ tmp/probes/homology_second_homology_factor.lp
+ tmp/probes/homology_second_exactness.lp
+ tmp/probes/homology_whole_second_exactness.lp
+)
+for file in "${targets[@]}"; do cp "$file" "$stage_root/tmp/probes/"; done
+printf 'stage: %s\nlog: %s\n' "$stage_root" "$log_file"
+cd "$stage_root"
+for file in emdash3_2.lp emdash3_2_homology_window.lp emdash3_2_cokernel_record_covers.lp "${targets[@]}"; do
+  printf 'checking %s\n' "$file"
+  started="$SECONDS"
+  set +e
+  timeout --signal=INT 90s lambdapi check -c --no-colors -w --verbose=2 --too-long=1 "$file" >>"$log_file" 2>&1
+  rc=$?
+  set -e
+  printf 'finished %s: exit %s, elapsed %ss\n' "$file" "$rc" "$((SECONDS-started))"
+  if [[ "$rc" -ne 0 ]]; then tail -n 12 "$log_file" | cut -c1-260; exit "$rc"; fi
+done
