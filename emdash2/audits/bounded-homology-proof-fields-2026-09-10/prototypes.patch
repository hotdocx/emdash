+/* Same-head proof-erasure unification: constant vs ordinary stable introduction. */
+require open emdash.emdash3_2_nat_arithmetic;
+
+constant symbol ReviewRecord : Grpd;
+constant symbol review_const_intro (n : τ Nat_grpd)
+  (p : τ (@= Nat_grpd n n)) : τ ReviewRecord;
+symbol review_intro (n : τ Nat_grpd)
+  (p : τ (@= Nat_grpd n n)) : τ ReviewRecord;
+
+unif_rule review_const_intro $n _ ≡ review_const_intro $m _ ↪ [ $n ≡ $m ];
+unif_rule review_intro $n _ ≡ review_intro $m _ ↪ [ $n ≡ $m ];
+
+constant symbol n : τ Nat_grpd;
+constant symbol p : τ (@= Nat_grpd n n);
+constant symbol q : τ (@= Nat_grpd n n);
+
+// Injective-head decomposition prevents this custom rule from discarding the proofs.
+assertnot ⊢ @eq_refl ReviewRecord (review_const_intro n p)
+  : τ (@= ReviewRecord (review_const_intro n p) (review_const_intro n q));
+
+// The ordinary stable introduction reaches the custom proof-time rule.
+assert ⊢ @eq_refl ReviewRecord (review_intro n p)
+  : τ (@= ReviewRecord (review_intro n p) (review_intro n q));
+
+// Neither runtime normalization nor irrelevant mathematical data is collapsed.
+assertnot ⊢ review_intro n p ≡ review_intro n q;
+assertnot ⊢ @eq_refl ReviewRecord (review_intro n p)
+  : τ (@= ReviewRecord (review_intro n p)
+      (review_intro (succ n) (@eq_refl Nat_grpd (succ n))));
