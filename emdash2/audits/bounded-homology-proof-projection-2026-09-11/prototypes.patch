+/* The original native inputs, named before applying the whole H. */
+require open emdash.tmp.probes.homology_row_triple_right_points;
+
+symbol homology_row_triple_source_input [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (Ab : τ (@ComputationalAbelianCategory C P t)) (T : τ (@TerminalObject C t))
+  (KP : τ (@KernelPresentation C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) t T (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab))))
+  (state : τ (@HomologyRowTriple I C C1 P t (@computational_abelian_preabelian C P t Ab) T)) (x : τ (Obj I))
+  : τ (Obj (@ZeroArrowCone_cat C t T))
+≔ @chain_pair_zero_cone C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) t T (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab)) KP
+    (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_first_func C t T) (@fapp0 I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t (@computational_abelian_preabelian C P t Ab) T (@homology_row_triple_row0 I C C1 P t (@computational_abelian_preabelian C P t Ab) T state)) x))
+    (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_first_func C t T) (@fapp0 I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t (@computational_abelian_preabelian C P t Ab) T (@homology_row_triple_row1 I C C1 P t (@computational_abelian_preabelian C P t Ab) T state)) x))
+    (@fapp0 (@ZeroArrowCone_cat C t T) C (@zero_arrow_cone_first_func C t T) (@fapp0 I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t (@computational_abelian_preabelian C P t Ab) T (@homology_row_triple_row2 I C C1 P t (@computational_abelian_preabelian C P t Ab) T state)) x))
+    (@homology_row_triple_source_pair I C C1 P t (@computational_abelian_preabelian C P t Ab) T state x);
+
+symbol homology_row_triple_right_input [I C : Cat] (C1 : τ (IsNCat (cat_succ cat_zero) C))
+  [P : τ (Functor (Product_cat C C) C)] [t : τ (Obj C)]
+  (Ab : τ (@ComputationalAbelianCategory C P t)) (T : τ (@TerminalObject C t))
+  (KP : τ (@KernelPresentation C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) t T (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab))))
+  (state : τ (@HomologyRowTriple I C C1 P t (@computational_abelian_preabelian C P t Ab) T)) (x : τ (Obj I))
+  : τ (Obj (@ZeroArrowCone_cat C t T))
+≔ @chain_pair_zero_cone C (@computational_homology_preadditive C P t (@computational_abelian_preabelian C P t Ab)) t T (@preabelian_kernels C P t (@computational_abelian_preabelian C P t Ab)) KP
+    (@fapp0 WalkingArrow_cat C (@fapp0 (@ZeroArrowCone_cat C t T) (Functor_cat WalkingArrow_cat C) (@zero_arrow_cone_diagram_func C t T) (@fapp0 I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t (@computational_abelian_preabelian C P t Ab) T (@homology_row_triple_row0 I C C1 P t (@computational_abelian_preabelian C P t Ab) T state)) x)) walking_arrow_tgt)
+    (@fapp0 WalkingArrow_cat C (@fapp0 (@ZeroArrowCone_cat C t T) (Functor_cat WalkingArrow_cat C) (@zero_arrow_cone_diagram_func C t T) (@fapp0 I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t (@computational_abelian_preabelian C P t Ab) T (@homology_row_triple_row1 I C C1 P t (@computational_abelian_preabelian C P t Ab) T state)) x)) walking_arrow_tgt)
+    (@fapp0 WalkingArrow_cat C (@fapp0 (@ZeroArrowCone_cat C t T) (Functor_cat WalkingArrow_cat C) (@zero_arrow_cone_diagram_func C t T) (@fapp0 I (@ZeroArrowCone_cat C t T) (@short_exact_row_family_func I C C1 P t (@computational_abelian_preabelian C P t Ab) T (@homology_row_triple_row2 I C C1 P t (@computational_abelian_preabelian C P t Ab) T state)) x)) walking_arrow_tgt)
+    (@homology_row_triple_right_pair I C C1 P t Ab T state x);
