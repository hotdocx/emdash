+/* Same retained middle sequence, removing the final arrow before the leading two. */
+require open emdash.emdash3_2_finite_arrow_tail_init;
+
+symbol finite_arrow_tail_trim_boundary
+  [C : Cat]
+  (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C),
+    τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (xs : τ (@FiniteArrowTail C Q (succ (succ (succ n))) A B f))
+≔ @finite_arrow_tail_rest C Q n B
+    (@finite_arrow_tail_next C Q (succ n) A B f
+      (@finite_arrow_tail_init C Q (succ (succ n)) A B f xs))
+    (@finite_arrow_tail_arrow C Q (succ n) A B f
+      (@finite_arrow_tail_init C Q (succ (succ n)) A B f xs))
+    (@finite_arrow_tail_rest C Q (succ n) A B f
+      (@finite_arrow_tail_init C Q (succ (succ n)) A B f xs));
+
+symbol finite_arrow_tail_trim_boundary_target_property
+  [C : Cat]
+  (Q : Π A : τ (Obj C), Π B : τ (Obj C), Π D : τ (Obj C),
+    τ (Hom C A B) → τ (Hom C B D) → Grpd)
+  (P : τ (Obj C) → Grpd)
+  (n : τ Nat_grpd) [A B : τ (Obj C)] [f : τ (Hom C A B)]
+  (xs : τ (@FiniteArrowTail C Q (succ (succ (succ n))) A B f))
+  (p : τ (P (@finite_arrow_tail_last_source C Q (succ (succ (succ n))) A B f xs)))
+  : τ (P (@finite_arrow_tail_last_target C Q n _ _ _
+    (@finite_arrow_tail_trim_boundary C Q n A B f xs)))
+≔ @finite_arrow_tail_init_endpoint_property C Q P (succ (succ n)) A B f xs p;
