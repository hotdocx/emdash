+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+stage_root="$(mktemp -d /tmp/emdash-first-exactness-warnings.XXXXXX)"
+log_dir="$(pwd)/logs/probes"
+mkdir -p "$stage_root/tmp/probes"
+cp lambdapi.pkg ./*.lp "$stage_root/"
+cp tmp/probes/homology_first_exactness_warning_control.lp "$stage_root/tmp/probes/"
+printf 'source-only warning stage: %s\n' "$stage_root"
+cd "$stage_root"
+timeout --signal=INT 90s lambdapi check --no-colors tmp/probes/homology_first_exactness_warning_control.lp >"$log_dir/first-exactness-baseline-warnings.log" 2>&1
+printf 'baseline checked\n'
+timeout --signal=INT 90s lambdapi check --no-colors emdash3_2_homology_first_exactness.lp >"$log_dir/first-exactness-candidate-warnings.log" 2>&1
+printf 'candidate checked\n'
